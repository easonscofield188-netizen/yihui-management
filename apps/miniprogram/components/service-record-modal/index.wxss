.service-popup {
  overflow: hidden;
  border-radius: 36rpx 36rpx 0 0;
  background: #f9f9ff;
}

.service-dialog {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  max-height: 85vh;
  flex-direction: column;
  background: #f9f9ff;
}

.dialog-header {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx 32rpx 20rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #eef2fa;
}

.dialog-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dialog-badge {
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  background: #fff7ed;
  color: #c2410c;
  border: 1rpx solid #fed7aa;
  font-size: 22rpx;
  font-weight: 700;
}

.dialog-title {
  color: #002045;
  font-size: 34rpx;
  font-weight: 700;
}

.close-btn {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  align-items: center;
  justify-content: center;
}

.dialog-body {
  box-sizing: border-box;
  width: 100%;
  max-height: 62vh;
  padding: 24rpx 32rpx;
}

.project-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #edf2fc;
  border: 2rpx solid #d9e3f9;
}

.project-pill-name {
  color: #002045;
  font-size: 26rpx;
  font-weight: 600;
}

.form-section {
  margin-bottom: 28rpx;
}

.section-label {
  margin-bottom: 14rpx;
  color: #242c3a;
  font-size: 27rpx;
  font-weight: 600;
}

.section-label.required::after {
  content: ' *';
  color: #ba1a1a;
}

.input-shell {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  overflow: hidden;
  border: 2rpx solid #c4c6cf;
  border-radius: 14rpx;
  background: #ffffff;
}

.input-shell:focus-within {
  border-color: #002045;
  box-shadow: 0 0 0 2rpx rgba(0, 32, 69, 0.12);
}

.select-shell {
  display: flex;
  align-items: center;
}

.form-input {
  min-height: 84rpx;
  padding: 0 20rpx;
  background: transparent !important;
  color: #121c2c;
  font-size: 28rpx;
  line-height: 84rpx;
}

/* 选中的项目场景描述说明卡片 */

.scene-desc-card {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #f2f5fb;
  border-left: 6rpx solid #002045;
}

.scene-desc-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.scene-desc-title {
  font-size: 23rpx;
  font-weight: 600;
  color: #002045;
}

.scene-desc-text {
  font-size: 24rpx;
  line-height: 36rpx;
  color: #43474e;
}

.form-card-box {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx solid #d9e3f9;
}

.card-box-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-box-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #002045;
  font-size: 30rpx;
  font-weight: 700;
}

.add-cost-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  background: #edf2fa;
  border: 2rpx solid #c8d9f8;
  color: #002045;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-cost-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 16rpx;
  border-radius: 12rpx;
  background: #f4f6fa;
  color: #74777f;
  font-size: 25rpx;
}

.cost-item-card {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f9faff;
  border: 2rpx solid #e1e9f8;
}

.cost-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cost-index-tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #002045;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.cost-delete-btn {
  padding: 6rpx 10rpx;
}

.cost-fields-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.grid-field {
  flex: 1;
}

.grid-label {
  margin-bottom: 10rpx;
  color: #43474e;
  font-size: 24rpx;
  font-weight: 500;
}

.grid-input-shell {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18rpx;
  border: 2rpx solid #c4c6cf;
  border-radius: 12rpx;
  background: #ffffff;
}

.grid-picker-text {
  color: #002045;
  font-size: 26rpx;
  font-weight: 500;
}

.grid-input {
  width: 100%;
  height: 72rpx;
  background: transparent !important;
  font-size: 26rpx;
  line-height: 72rpx;
}

.cost-remark-row {
  margin-bottom: 8rpx;
}

.voucher-card-box {
  margin-top: 24rpx;
}

.voucher-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.voucher-sub {
  color: #8a8e94;
  font-size: 22rpx;
}

.unified-voucher-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.unified-voucher-thumb {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 2rpx solid #d9e3f9;
  background: #f0f4fa;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 14rpx;
}

.unified-upload-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  border: 2rpx dashed #99a8bc;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #74777f;
  font-size: 21rpx;
}

.settlement-row {
  margin-top: 16rpx;
}

.settlement-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #f4f6fa;
}

.toggle-title {
  color: #002045;
  font-size: 27rpx;
  font-weight: 600;
}

.toggle-desc {
  margin-top: 4rpx;
  color: #74777f;
  font-size: 22rpx;
}

.unreceived-badge {
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #fff4e5;
  color: #b45309;
  font-size: 24rpx;
  font-weight: 600;
  display: inline-block;
}

.dialog-footer {
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f9f9ff;
  border-top: 2rpx solid #eef2fa;
}

.submit-btn {
  --td-button-primary-bg-color: #002045;
  --td-button-primary-border-color: #002045;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  height: 88rpx;
}
