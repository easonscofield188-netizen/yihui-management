<t-popup
  visible="{{visible}}"
  placement="bottom"
  close-on-overlay-click
  t-class-content="service-popup"
  z-index="{{11500}}"
  overlay-props="{{ { zIndex: 11000 } }}"
  bindvisible-change="onPopupVisibleChange"
>
  <view class="service-dialog">
    <view class="dialog-header">
      <view class="dialog-title-wrap">
        <view class="dialog-badge">{{projectType === 'flower_plant' ? '鲜花绿植' : '长期合作'}}</view>
        <text class="dialog-title">{{isEdit ? (projectType === 'flower_plant' ? '编辑业务记录' : '编辑服务记录') : (projectType === 'flower_plant' ? '新增业务记录/记账' : '新增服务履约与记账')}}</text>
      </view>
      <view class="close-btn" bindtap="closeModal">
        <t-icon name="close" size="40rpx" color="#43474e" />
      </view>
    </view>

    <scroll-view class="dialog-body" scroll-y show-scrollbar="{{false}}">
      <!-- 关联项目提示 -->
      <view class="project-pill" wx:if="{{projectName}}">
        <t-icon name="building" size="30rpx" color="#002045" />
        <text class="project-pill-name">{{projectName}}</text>
      </view>

      <!-- 关联客户选择（鲜花绿植等多客户业务需独立选择客户） -->
      <view class="form-section" wx:if="{{projectType === 'flower_plant'}}">
        <view class="section-label required">服务客户</view>
        <view class="input-shell select-shell" bindtap="openClientPicker">
          <t-input
            t-class="form-input"
            borderless
            readonly
            value="{{selectedClientName ? (selectedClientCompany ? selectedClientName + ' (' + selectedClientCompany + ')' : selectedClientName) : ''}}"
            placeholder="请点击选择关联客户"
            prefix-icon="user"
            suffix-icon="chevron-down"
          />
        </view>
      </view>

      <!-- 服务日期 -->
      <view class="form-section">
        <view class="section-label required">{{projectType === 'flower_plant' ? '业务日期' : '服务日期'}}</view>
        <view class="input-shell select-shell" bindtap="openDatePicker">
          <t-input
            t-class="form-input"
            borderless
            readonly
            value="{{serviceDate}}"
            placeholder="请选择服务日期"
            prefix-icon="calendar"
            suffix-icon="chevron-down"
          />
        </view>
      </view>

      <!-- 服务内容 -->
      <view class="form-section">
        <view class="section-label required">{{projectType === 'flower_plant' ? '业务内容' : '服务内容'}}</view>
        <view class="input-shell select-shell" bindtap="openScenePicker">
          <t-input
            t-class="form-input"
            borderless
            readonly
            value="{{content}}"
            placeholder="请点击选择服务内容"
            suffix-icon="chevron-down"
          />
        </view>

        <!-- 选中的项目场景描述说明 -->
        <view class="scene-desc-card" wx:if="{{selectedSceneDescription}}">
          <view class="scene-desc-head">
            <t-icon name="info-circle" size="28rpx" color="#002045" />
            <text class="scene-desc-title">场景说明</text>
          </view>
          <view class="scene-desc-text">{{selectedSceneDescription}}</view>
        </view>
      </view>

      <!-- 成本支出卡片 -->
      <view class="form-card-box">
        <view class="card-box-header">
          <view class="card-box-title">
            <t-icon name="bill" size="34rpx" color="#002045" />
            <text>本次成本支出</text>
          </view>
          <view class="add-cost-btn" bindtap="addCostItem">
            <t-icon name="add" size="28rpx" color="#002045" />
            <text>添加支出</text>
          </view>
        </view>

        <!-- 支出为空时 -->
        <view class="empty-cost-tip" wx:if="{{!costs.length}}">
          <t-icon name="info-circle" size="30rpx" color="#74777f" />
          <text>本次未发生额外花销（默认支出 ¥0.00）</text>
        </view>

        <!-- 支出列表 -->
        <view class="cost-item-card" wx:for="{{costs}}" wx:key="id">
          <view class="cost-card-top">
            <view class="cost-index-tag">支出 {{index + 1}}</view>
            <view class="cost-delete-btn" data-index="{{index}}" bindtap="deleteCostItem">
              <t-icon name="delete" size="32rpx" color="#ba1a1a" />
            </view>
          </view>

          <view class="cost-fields-grid">
            <view class="grid-field">
              <view class="grid-label">分类</view>
              <view class="grid-input-shell" data-index="{{index}}" bindtap="openCostCategoryPicker">
                <text class="grid-picker-text">{{item.categoryLabel || '请选择'}}</text>
                <t-icon name="chevron-down" size="28rpx" color="#74777f" />
              </view>
            </view>
            <view class="grid-field">
              <view class="grid-label">金额 (元)</view>
              <view class="grid-input-shell">
                <t-input
                  t-class="grid-input"
                  type="digit"
                  borderless
                  value="{{item.amount}}"
                  placeholder="0.00"
                  data-index="{{index}}"
                  bindchange="onCostAmountChange"
                />
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 客户结算卡片 -->
      <view class="form-card-box">
        <view class="card-box-header">
          <view class="card-box-title">
            <t-icon name="wallet" size="34rpx" color="#002045" />
            <text>订单金额（元）</text>
          </view>
        </view>

        <view class="settlement-row">
          <view class="input-shell">
            <t-input
              t-class="form-input"
              type="digit"
              borderless
              value="{{receivableAmount}}"
              placeholder="0.00 (如无单独计费留空)"
              bindchange="onReceivableChange"
            />
          </view>
        </view>

        <view class="settlement-toggle-row">
          <view class="toggle-info">
            <view class="toggle-title">本次订单是否已结清</view>
            <view class="toggle-desc">{{isSettled ? '订单金额将全部计为本次已收金额' : '可填写本次实际已收金额'}}</view>
          </view>
          <t-switch value="{{isSettled}}" bindchange="onSettledChange" />
        </view>

        <view class="settlement-row" wx:if="{{!isSettled}}">
            <view class="section-label">本次已收金额（元）</view>
            <view class="input-shell">
              <t-input
                t-class="form-input"
                type="digit"
                borderless
                value="{{receivedAmount}}"
                placeholder="输入实际收到的金额"
                bindchange="onReceivedChange"
              />
            </view>
            <view class="unreceived-badge" wx:if="{{calculatedUnreceived > 0}}">
              待收尾款：¥{{calculatedUnreceivedText}}
            </view>
        </view>
      </view>

      <!-- 发票凭证卡片 -->
      <view class="form-card-box voucher-card-box">
        <view class="card-box-header">
          <view class="card-box-title">
            <t-icon name="attach" size="34rpx" color="#002045" />
            <text>发票凭证（选填）</text>
          </view>
        </view>

        <view class="unified-voucher-grid">
          <view class="unified-voucher-thumb" wx:for="{{vouchers}}" wx:key="*this">
            <image class="thumb-img" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewUnifiedVoucher" />
            <view class="thumb-del" data-index="{{index}}" catchtap="deleteUnifiedVoucher">
              <t-icon name="close" size="24rpx" color="#ffffff" />
            </view>
          </view>
          <view class="unified-upload-btn" bindtap="uploadUnifiedVoucher" wx:if="{{vouchers.length < 80}}">
            <t-icon name="add" size="44rpx" color="#74777f" />
            <text>上传凭据</text>
          </view>
        </view>
      </view>

      <view style="height: 40rpx;"></view>
    </scroll-view>

    <!-- 底部提交按钮 -->
    <view class="dialog-footer">
      <t-button
        t-class="submit-btn"
        theme="primary"
        block
        content="{{projectType === 'flower_plant' ? '保存业务记录' : '保存服务记录'}}"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="submitRecord"
      />
    </view>
  </view>
</t-popup>

<!-- 日期选择器 -->
<t-date-time-picker
  t-class-confirm="picker-confirm"
  visible="{{datePickerVisible}}"
  mode="date"
  format="YYYY-MM-DD"
  value="{{serviceDate}}"
  end="{{maxDate}}"
  title="选择服务日期"
  confirm-btn="确定"
  popup-props="{{pickerPopupProps}}"
  bindconfirm="onDateConfirm"
  bindcancel="closeDatePicker"
  bindclose="closeDatePicker"
/>

<!-- 成本分类选择器 -->
<t-picker
  t-class-confirm="picker-confirm"
  visible="{{costPickerVisible}}"
  value="{{costPickerValue}}"
  title="选择支出分类"
  popup-props="{{pickerPopupProps}}"
  bindconfirm="onCostCategoryConfirm"
  bindcancel="closeCostCategoryPicker"
  bindclose="closeCostCategoryPicker"
>
  <t-picker-item options="{{costCategories}}" />
</t-picker>

<!-- 项目场景/服务内容单选弹窗选择器 -->
<t-picker
  t-class-confirm="picker-confirm"
  visible="{{scenePickerVisible}}"
  value="{{scenePickerValue}}"
  title="选择服务内容"
  popup-props="{{pickerPopupProps}}"
  bindconfirm="onSceneConfirm"
  bindcancel="closeScenePicker"
  bindclose="closeScenePicker"
>
  <t-picker-item options="{{projectScenes}}" />
</t-picker>

<!-- 客户选择弹窗 -->
<t-popup
  visible="{{clientPickerVisible}}"
  placement="bottom"
  close-on-overlay-click
  t-class-content="service-popup"
  z-index="{{12000}}"
  overlay-props="{{ { zIndex: 11800 } }}"
  bindvisible-change="onClientPickerVisibleChange"
>
  <view class="client-picker-dialog">
    <view class="dialog-header">
      <view class="dialog-title-wrap">
        <t-icon name="user" size="36rpx" color="#002045" />
        <text class="dialog-title">选择关联客户</text>
      </view>
      <view class="close-btn" bindtap="closeClientPicker">
        <t-icon name="close" size="40rpx" color="#43474e" />
      </view>
    </view>
    
    <view class="client-search-bar">
      <t-search
        value="{{clientSearchKeyword}}"
        placeholder="搜索客户姓名/公司/手机号"
        bindchange="onClientSearchChange"
        bindclear="onClientSearchClear"
      />
    </view>

    <view class="client-loading-state" wx:if="{{loadingClients}}">
      <t-loading size="44rpx" theme="circular" />
      <text>正在加载客户列表…</text>
      <text class="client-loading-tip">请稍候，加载完成后可搜索或选择客户</text>
    </view>

    <scroll-view class="client-list-scroll" wx:else scroll-y show-scrollbar="{{false}}">
      <view class="empty-client-tip" wx:if="{{!filteredClientList.length}}">
        <text>未找到匹配客户</text>
      </view>
      <view
        class="client-item-card {{selectedClientId === (item._id || item.id) ? 'selected' : ''}}"
        wx:for="{{filteredClientList}}"
        wx:key="_id"
        data-id="{{item._id || item.id}}"
        data-name="{{item.name}}"
        data-phone="{{item.phone || ''}}"
        data-company="{{item.companyName || item.company || ''}}"
        bindtap="selectClientItem"
      >
        <view class="client-item-main">
          <view class="client-item-name">{{item.name}}</view>
          <view class="client-item-sub" wx:if="{{item.companyName || item.company || item.phone}}">
            <text wx:if="{{item.companyName || item.company}}">{{item.companyName || item.company}}</text>
            <text wx:if="{{item.phone}}"> · {{item.phone}}</text>
          </view>
        </view>
        <t-icon wx:if="{{selectedClientId === (item._id || item.id)}}" name="check" size="36rpx" color="#002045" />
      </view>
    </scroll-view>

    <view class="client-picker-footer">
      <t-button
        theme="outline"
        block
        icon="add"
        content="快捷新建客户"
        bindtap="openCreateClientModal"
      />
    </view>
  </view>
</t-popup>

<!-- 快捷新建客户弹窗 -->
<t-dialog
  wx:if="{{createClientVisible}}"
  visible="{{createClientVisible}}"
  title="快捷新建客户"
  confirm-btn="保存并选中"
  cancel-btn="取消"
  bindconfirm="submitQuickClient"
  bindcancel="closeCreateClientModal"
>
  <view class="quick-client-form" slot="content">
    <view class="quick-field">
      <text class="quick-label">客户姓名 *</text>
      <t-input
        value="{{newClientName}}"
        placeholder="请输入客户姓名"
        bindchange="onNewClientNameChange"
      />
    </view>
    <view class="quick-field">
      <text class="quick-label">联系电话</text>
      <t-input
        value="{{newClientPhone}}"
        placeholder="请输入手机号"
        bindchange="onNewClientPhoneChange"
      />
    </view>
    <view class="quick-field">
      <text class="quick-label">公司名称</text>
      <t-input
        value="{{newClientCompany}}"
        placeholder="请输入公司/单位名称"
        bindchange="onNewClientCompanyChange"
      />
    </view>
  </view>
</t-dialog>
