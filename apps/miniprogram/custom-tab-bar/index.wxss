.tab-bar { position: relative; z-index: 500; display: flex; box-sizing: border-box; height: calc(118rpx + env(safe-area-inset-bottom)); padding: 0 24rpx env(safe-area-inset-bottom); align-items: center; border-top: 2rpx solid #e7eeff; background: #fff; box-shadow: 0 -8rpx 24rpx rgba(26,54,93,.05); }
.tab-item,.create-item { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 6rpx; color: #5b5f61; font-size: 22rpx; }
.tab-item { height: 88rpx; justify-content: center; }
.tab-pill { display: flex; min-width: 126rpx; padding: 10rpx 22rpx; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; border-radius: 999rpx; transition: background .18s ease, color .18s ease, transform .18s ease; }
.tab-item.selected { color: #adc7f7; font-weight: 700; }
.tab-item.selected .tab-pill { background: #1a365d; box-shadow: 0 6rpx 14rpx rgba(26,54,93,.16); }
.create-item { position: relative; align-self: stretch; justify-content: flex-end; padding-bottom: 12rpx; color: #43474e; }
.create-button { position: absolute; top: -56rpx; display: flex; width: 104rpx; height: 104rpx; align-items: center; justify-content: center; border: 8rpx solid #fff; border-radius: 50%; background: #002045; box-shadow: 0 8rpx 22rpx rgba(26,54,93,.2); transition: transform .22s cubic-bezier(0.34, 1.56, 0.64, 1); }
.create-button.active { transform: rotate(45deg) scale(0.96); background: #ba1a1a; }

/* 快捷操作弹层 */
.action-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 400; background: rgba(15, 23, 42, 0.45); backdrop-filter: blur(4px); opacity: 0; pointer-events: none; transition: opacity .25s ease; }
.action-mask.show { opacity: 1; pointer-events: auto; }
.action-sheet { position: absolute; left: 24rpx; right: 24rpx; bottom: calc(138rpx + env(safe-area-inset-bottom)); background: #ffffff; border-radius: 36rpx; padding: 32rpx 28rpx 28rpx; box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.16); transform: translateY(40rpx) scale(0.96); opacity: 0; transition: all .25s cubic-bezier(0.16, 1, 0.3, 1); }
.action-sheet.show { transform: translateY(0) scale(1); opacity: 1; }
.action-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; padding: 0 8rpx; }
.action-title { font-size: 30rpx; font-weight: 700; color: #002045; letter-spacing: 0.5rpx; }
.action-close { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f1f5f9; }
.action-list { display: flex; flex-direction: column; gap: 18rpx; }
.action-card { display: flex; align-items: center; padding: 22rpx 24rpx; border-radius: 24rpx; background: #f8fafc; border: 2rpx solid #eef2f6; transition: background .15s ease, transform .15s ease; }
.action-card:active { background: #edf2f7; transform: scale(0.985); }
.action-icon { width: 84rpx; height: 84rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; margin-right: 22rpx; flex-shrink: 0; }
.project-icon { background: linear-gradient(135deg, #1e3a8a, #3b82f6); box-shadow: 0 8rpx 18rpx rgba(30, 58, 138, 0.25); }
.expense-icon { background: linear-gradient(135deg, #b45309, #f59e0b); box-shadow: 0 8rpx 18rpx rgba(180, 83, 9, 0.25); }
.action-info { flex: 1; min-width: 0; }
.action-item-title { font-size: 30rpx; font-weight: 700; color: #0f172a; margin-bottom: 6rpx; }
.action-item-desc { font-size: 22rpx; color: #64748b; line-height: 1.3; }

