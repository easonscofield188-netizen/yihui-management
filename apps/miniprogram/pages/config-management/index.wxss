page { background:#f7f9fd; }.management-page { min-height:100vh; padding-bottom:calc(150rpx + env(safe-area-inset-bottom)); background:#f7f9fd; color:#172238; }
.page-nav { position:fixed; top:0; right:0; left:0; z-index:20; box-sizing:border-box; border-bottom:2rpx solid #edf0f5; background:rgba(249,249,255,.97); }.nav-placeholder { width:100%; }.nav-back { position:absolute; bottom:0; left:28rpx; display:flex; width:74rpx; height:88rpx; align-items:center; }.nav-title { position:absolute; right:150rpx; bottom:0; left:150rpx; height:88rpx; overflow:hidden; color:#002045; font-size:38rpx; font-weight:700; line-height:88rpx; text-align:center; text-overflow:ellipsis; white-space:nowrap; }
.group-summary { display:flex; margin:28rpx 32rpx 16rpx; padding:27rpx; align-items:center; gap:19rpx; border-radius:22rpx; background:linear-gradient(135deg,#123d68,#246497); color:#fff; box-shadow:0 14rpx 31rpx rgba(18,61,104,.19); }.summary-icon { display:flex; width:70rpx; height:70rpx; flex:none; align-items:center; justify-content:center; border-radius:18rpx; background:rgba(255,255,255,.14); }.summary-main { min-width:0; flex:1; }.summary-title { font-size:29rpx; font-weight:700; }.summary-description { margin-top:5rpx; color:rgba(255,255,255,.7); font-size:20rpx; line-height:29rpx; }.summary-count { flex:none; text-align:center; color:rgba(255,255,255,.7); font-size:18rpx; }.summary-count text { display:block; color:#fff; font-size:35rpx; font-weight:750; }
.config-list { padding:18rpx 32rpx 40rpx; }.config-card { margin-bottom:23rpx; padding:26rpx; border:2rpx solid #dfe6f0; border-radius:21rpx; background:#fff; box-shadow:0 10rpx 25rpx rgba(30,61,104,.07); }.config-card.inactive { opacity:.72; background:#f6f7f9; }.config-head { display:flex; align-items:stretch; gap:15rpx; }.order-index { display:flex; width:48rpx; min-height:58rpx; flex:none; align-items:center; justify-content:center; align-self:stretch; border-radius:14rpx; background:#e8effc; color:#285692; font-size:22rpx; font-weight:700; }.config-main { min-width:0; flex:1; }.config-name { overflow:hidden; font-size:28rpx; font-weight:700; line-height:32rpx; text-overflow:ellipsis; white-space:nowrap; }.config-value { margin-top:5rpx; overflow:hidden; color:#8a929e; font-size:19rpx; line-height:24rpx; text-overflow:ellipsis; white-space:nowrap; }.status-badge { align-self:center; padding:6rpx 13rpx; border-radius:999rpx; background:#e6f7ee; color:#16714d; font-size:20rpx; font-weight:600; }.status-badge.off { background:#e9ebee; color:#737b86; }.config-description { min-height:34rpx; margin-top:17rpx; color:#6e7785; font-size:22rpx; line-height:34rpx; }.config-actions { display:flex; margin-top:20rpx; padding-top:18rpx; align-items:center; gap:13rpx; border-top:2rpx solid #edf0f4; }.sort-actions { display:flex; margin-right:auto; gap:8rpx; }.icon-action { display:flex; width:52rpx; height:52rpx; align-items:center; justify-content:center; border-radius:13rpx; background:#eef2f7; }.text-action { padding:10rpx 14rpx; border-radius:12rpx; font-size:22rpx; font-weight:600; }.text-action.edit { background:#e8effc; color:#285692; }.text-action.status { background:#eef1f5; color:#596574; }.text-action.delete { background:#fff0ef; color:#b52a2a; }
.config-card:nth-child(4n + 1) { border-color:#d8e6fb; box-shadow:0 5rpx 8rpx rgba(45,91,157,.08),0 18rpx 38rpx rgba(45,91,157,.17); }
.config-card:nth-child(4n + 2) { border-color:#e5dcf8; box-shadow:0 5rpx 8rpx rgba(113,79,158,.08),0 18rpx 38rpx rgba(113,79,158,.16); }
.config-card:nth-child(4n + 3) { border-color:#d5ebe5; box-shadow:0 5rpx 8rpx rgba(32,119,95,.08),0 18rpx 38rpx rgba(32,119,95,.15); }
.config-card:nth-child(4n) { border-color:#f2e1cf; box-shadow:0 5rpx 8rpx rgba(174,105,48,.08),0 18rpx 38rpx rgba(174,105,48,.15); }
.config-unit { display:inline-flex; margin-top:7rpx; padding:4rpx 10rpx; border-radius:999rpx; background:#eef4ff; color:#315b8f; font-size:18rpx; line-height:25rpx; }
.empty-state { display:flex; min-height:500rpx; flex-direction:column; align-items:center; justify-content:center; color:#7f8793; font-size:27rpx; }.empty-state text { margin-top:8rpx; color:#a0a6af; font-size:22rpx; }.list-loading { display:flex; padding:30rpx; align-items:center; justify-content:center; gap:12rpx; color:#8b929d; font-size:23rpx; }
.create-bar { position:fixed; right:0; bottom:0; left:0; z-index:15; display:flex; padding:18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom)); justify-content:center; background:linear-gradient(180deg,rgba(247,249,253,0),#f7f9fd 34%); }.create-button { display:flex; min-width:300rpx; height:88rpx; padding:0 34rpx; align-items:center; justify-content:center; gap:10rpx; border-radius:999rpx; background:#002045; color:#fff; font-size:26rpx; font-weight:700; box-shadow:0 13rpx 29rpx rgba(0,32,69,.24); }
.editor-sheet { padding:16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; background:#fff; }.sheet-handle { width:72rpx; height:8rpx; margin:0 auto 22rpx; border-radius:999rpx; background:#d9dce1; }.editor-head { display:flex; align-items:center; justify-content:space-between; }.editor-title { font-size:32rpx; font-weight:700; }.form-field { margin-top:24rpx; }.field-label { margin-bottom:10rpx; color:#434d5b; font-size:24rpx; font-weight:600; }.field-input { display:flex; min-height:82rpx; padding:0 21rpx; align-items:center; border:2rpx solid #d9e3f9; border-radius:14rpx; background:#f7f9fd; font-size:26rpx; }.field-input input { width:100%; height:80rpx; }.field-input.textarea { padding:16rpx 21rpx; }.field-input textarea { width:100%; height:130rpx; }.editor-note { display:flex; margin-top:20rpx; padding:16rpx; align-items:flex-start; gap:9rpx; border-radius:13rpx; background:#eef2f7; color:#64748b; font-size:21rpx; }.editor-actions { display:flex; margin-top:28rpx; gap:18rpx; }.sheet-button { display:flex; height:82rpx; flex:1; align-items:center; justify-content:center; border-radius:999rpx; font-size:26rpx; font-weight:700; }.sheet-button.secondary { background:#edf0f5; color:#43474e; }.sheet-button.primary { background:#002045; color:#fff; }
.unit-field-tip { margin-top:9rpx; color:#8a929e; font-size:20rpx; line-height:29rpx; }
.expense-meta { display:flex; margin-top:8rpx; flex-wrap:wrap; gap:7rpx; align-items:center; }.scope-badge,.common-badge { padding:3rpx 9rpx; border-radius:999rpx; background:#edf2f7; color:#526174; font-size:18rpx; line-height:24rpx; }.common-badge { background:#e8f2ff; color:#23619b; }.common-badge.auto { background:#eef8f2; color:#218154; }.usage-count { color:#8a929e; font-size:19rpx; }.scope-options { display:flex; gap:12rpx; }.scope-option { flex:1; padding:18rpx 12rpx; border:2rpx solid #d9e3f0; border-radius:14rpx; color:#64748b; font-size:23rpx; text-align:center; }.scope-option.selected { border-color:#002d5c; background:#eaf2fb; color:#002d5c; font-weight:700; }.common-setting { display:flex; padding:18rpx 20rpx; align-items:center; justify-content:space-between; gap:20rpx; border:2rpx solid #d9e3f9; border-radius:14rpx; background:#f7f9fd; }.common-setting .field-label { margin-bottom:5rpx; }.setting-tip { color:#8a929e; font-size:20rpx; line-height:30rpx; }
.operation-mask { position:fixed; z-index:20000; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(247,249,253,.8); }.operation-content { display:flex; padding:24rpx 34rpx; align-items:center; gap:16rpx; border-radius:18rpx; background:#fff; color:#002045; font-size:24rpx; box-shadow:0 10rpx 28rpx rgba(26,54,93,.12); }
