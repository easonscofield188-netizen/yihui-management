<view class="management-page">
  <view class="page-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;"><view class="nav-back" bindtap="goBack"><t-icon name="chevron-left" size="48rpx" color="#002045" /></view><view class="nav-title">{{meta.title}}</view></view>
  <view class="nav-placeholder" style="height: {{navHeight}}px;"></view>
  <view class="group-summary"><view class="summary-icon"><t-icon name="{{meta.icon}}" size="43rpx" color="#ffffff" /></view><view class="summary-main"><view class="summary-title">{{meta.title}}</view><view class="summary-description">{{meta.description}}</view></view><view class="summary-count"><text>{{activeCount}}</text><view>项启用</view></view></view>
  <view class="config-list">
    <view class="config-card {{item.isActive === false ? 'inactive' : ''}}" wx:for="{{configs}}" wx:key="id">
      <view class="config-head"><view class="order-index">{{index + 1}}</view><view class="config-main"><view class="config-name">{{item.label}}</view><view class="config-value">标识：{{item.value}}</view><view class="config-unit" wx:if="{{group === 'COST_CATEGORY'}}">常用单位：{{item.commonUnit || '未设置'}}</view></view><view class="status-badge {{item.isActive === false ? 'off' : ''}}">{{item.statusLabel}}</view></view>
      <view class="config-description">{{item.description || '暂无配置说明'}}</view>
      <view class="config-actions">
        <view class="sort-actions"><view class="icon-action {{item.canMoveUp ? '' : 'disabled'}}" data-id="{{item.id}}" data-direction="up" bindtap="moveConfig"><t-icon name="arrow-up" size="29rpx" color="{{item.canMoveUp ? '#526174' : '#c4c8cf'}}" /></view><view class="icon-action {{item.canMoveDown ? '' : 'disabled'}}" data-id="{{item.id}}" data-direction="down" bindtap="moveConfig"><t-icon name="arrow-down" size="29rpx" color="{{item.canMoveDown ? '#526174' : '#c4c8cf'}}" /></view></view>
        <view class="text-action edit" data-id="{{item.id}}" bindtap="editConfig">编辑</view><view class="text-action status" data-id="{{item.id}}" bindtap="toggleStatus">{{item.isActive === false ? '启用' : '停用'}}</view><view class="text-action delete" data-id="{{item.id}}" bindtap="requestDelete">删除</view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{!loading && !configs.length}}"><t-icon name="setting" size="82rpx" color="#9aa2ae" /><view>暂无配置项</view><text>点击下方按钮新增第一项配置</text></view>
    <view class="list-loading" wx:if="{{loading}}"><t-loading size="36rpx" theme="circular" /><text>正在加载配置...</text></view>
  </view>
  <view class="create-bar"><view class="create-button" bindtap="openCreate"><t-icon name="add" size="35rpx" color="#ffffff" /><text>新增{{meta.title}}</text></view></view>

  <t-popup visible="{{editorVisible}}" placement="bottom" bindvisible-change="onPopupVisibleChange">
    <view class="editor-sheet"><view class="sheet-handle"></view><view class="editor-head"><view class="editor-title">{{editorTitle}}</view><t-icon name="close" size="40rpx" color="#74777f" bindtap="closeEditor" /></view>
      <view class="form-field"><view class="field-label">配置名称</view><view class="field-input"><input value="{{form.label}}" maxlength="80" placeholder="请输入中文名称" data-field="label" bindinput="onFormInput" /></view></view>
      <view class="form-field" wx:if="{{group === 'COST_CATEGORY'}}"><view class="field-label">常用单位</view><view class="field-input"><input value="{{form.commonUnit}}" maxlength="30" placeholder="如：项、平方米、米、株" data-field="commonUnit" bindinput="onFormInput" /></view><view class="unit-field-tip">用于新增报价清单时自动填充，报价单中仍可单独修改。</view></view>
      <view class="form-field"><view class="field-label">配置说明（选填）</view><view class="field-input textarea"><textarea value="{{form.description}}" maxlength="240" placeholder="说明该配置项的使用场景" data-field="description" bindinput="onFormInput" /></view></view>
      <view class="editor-note" wx:if="{{editingId}}"><t-icon name="info-circle" size="28rpx" color="#64748b" /><text>配置标识不会修改，已有引用仍能保持关联。</text></view>
      <view class="editor-actions"><view class="sheet-button secondary" bindtap="closeEditor">取消</view><view class="sheet-button primary" bindtap="saveConfig">确认保存</view></view>
    </view>
  </t-popup>
  <view class="operation-mask" wx:if="{{operating}}" catchtap="stopPropagation" catchtouchmove="stopPropagation"><view class="operation-content"><t-loading size="44rpx" theme="circular" /><text>{{loadingMessage}}</text></view></view>
</view>
