page { background:#f4f8f7; }.config-home { min-height:100vh; padding-bottom:calc(60rpx + env(safe-area-inset-bottom)); background:#f4f8f7; color:#182220; }
.page-nav { position:fixed; top:0; right:0; left:0; z-index:20; box-sizing:border-box; border-bottom:2rpx solid #dceee9; background:rgba(255,255,255,.97); }.nav-placeholder { width:100%; }.nav-back { position:absolute; bottom:0; left:28rpx; display:flex; width:74rpx; height:88rpx; align-items:center; }.nav-title { position:absolute; right:150rpx; bottom:0; left:150rpx; height:88rpx; color:#182220; font-size:38rpx; font-weight:700; line-height:88rpx; text-align:center; }
.intro-card { display:flex; margin:28rpx 32rpx; padding:28rpx; align-items:center; gap:20rpx; border-radius:24rpx; background:linear-gradient(145deg,#182220,#1D3F38 55%,#2A9A87); color:#fff; box-shadow:0 14rpx 32rpx rgba(24,34,32,.2); }.intro-icon { display:flex; width:76rpx; height:76rpx; align-items:center; justify-content:center; border-radius:20rpx; background:rgba(255,255,255,.14); }.intro-title { font-size:30rpx; font-weight:700; }.intro-description { margin-top:6rpx; color:rgba(255,255,255,.72); font-size:22rpx; }
.section-title { margin:36rpx 36rpx 18rpx; font-size:29rpx; font-weight:700; }.group-grid { display:grid; padding:0 32rpx; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx; }.group-card { min-height:326rpx; padding:25rpx; border:2rpx solid #d5ebe5; border-radius:22rpx; background:#fff; box-shadow:0 10rpx 26rpx rgba(46,159,139,.08); }.group-head { display:flex; align-items:center; justify-content:space-between; }.group-icon { display:flex; width:68rpx; height:68rpx; align-items:center; justify-content:center; border-radius:18rpx; background:linear-gradient(145deg,#36AD97,#2A9A87); }.tone-green .group-icon,.tone-blue .group-icon,.tone-violet .group-icon,.tone-teal .group-icon { background:linear-gradient(145deg,#36AD97,#2A9A87); }.tone-orange .group-icon { background:linear-gradient(145deg,#d98345,#a85a2b); }.group-name { margin-top:19rpx; font-size:28rpx; font-weight:700; }.group-description { min-height:58rpx; margin-top:7rpx; color:#7a8391; font-size:21rpx; line-height:29rpx; }.group-preview { min-height:58rpx; margin-top:14rpx; overflow:hidden; color:#536174; font-size:20rpx; line-height:29rpx; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }.group-foot { display:flex; margin-top:18rpx; padding-top:15rpx; align-items:center; justify-content:space-between; border-top:2rpx solid #e1f2ed; color:#7f8793; font-size:20rpx; }.group-foot>view { display:flex; align-items:center; color:#187a68; }
.loading-mask { position:fixed; z-index:50; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(244,248,247,.78); }.loading-content { display:flex; padding:23rpx 32rpx; align-items:center; gap:14rpx; border-radius:17rpx; background:#fff; color:#187a68; font-size:24rpx; box-shadow:0 10rpx 28rpx rgba(46,159,139,.12); }
