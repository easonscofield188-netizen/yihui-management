<view class="detail-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;">
  <view class="nav-back" bindtap="goBack">
    <t-icon name="chevron-left" size="48rpx" color="#002045" />
  </view>
  <view class="nav-title">{{project.type === 'flower_plant' ? '鲜花绿植供应账本' : (project.type === 'long_term' ? '长期合作详情' : '项目详情')}}</view>
</view>
<view class="detail-nav-placeholder" style="height: {{navHeight}}px;"></view>

<view class="detail-page" wx:if="{{project}}">
  <view class="detail-actions" wx:if="{{canEdit}}">
    <view class="heading-edit" bindtap="editProject">
      <t-icon name="edit-1" size="34rpx" color="#ffffff" />
      <text>编辑</text>
    </view>
  </view>

  <!-- 项目头部 -->
  <view class="project-heading">
    <view class="project-heading-main">
      <view class="project-name">{{project.name}}</view>
      <view class="status-tags-row">
        <view class="status status-{{project.status}}">
          <t-icon wx:if="{{project.usesCheckIcon}}" name="check-circle" size="24rpx" color="{{project.statusIconColor}}" />
          <view wx:else class="status-dot"></view>
          <text>{{project.statusLabel}}</text>
        </view>
        <view wx:if="{{project.type === 'long_term' || project.type === 'flower_plant'}}" class="type-badge {{project.type === 'flower_plant' ? 'flower-badge' : 'longterm-badge'}}">
          <t-icon name="{{project.type === 'flower_plant' ? 'tree-square-dot' : 'repeat'}}" size="22rpx" color="{{project.type === 'flower_plant' ? '#0d9488' : '#c2410c'}}" />
          <text>{{project.type === 'flower_plant' ? '鲜花绿植' : '长期'}}</text>
        </view>
        <view wx:else class="type-badge normal-badge">
          <text>常规</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 财务大盘卡片 -->
  <view class="finance-card">
    <view class="finance-glow finance-glow-top"></view>
    <view class="finance-glow finance-glow-bottom"></view>
    <view class="finance-label">{{project.type === 'long_term' || project.type === 'flower_plant' ? '累计总应收' : '订单总金额'}}</view>
    <view class="order-amount">¥{{project.amountText}}</view>

    <view class="finance-columns">
      <view class="finance-column">
        <view class="finance-sub-label"><t-icon name="wallet" size="26rpx" color="rgba(255,255,255,.7)" />已收金额</view>
        <view class="finance-sub-value">¥{{project.receivedText}}</view>
      </view>
      <view class="finance-column pending-column">
        <view class="finance-sub-label"><t-icon name="time" size="26rpx" color="#ffd166" />待收金额</view>
        <view class="finance-sub-value">¥{{project.unreceivedText}}</view>
      </view>
    </view>

    <view class="finance-columns finance-columns-bottom">
      <view class="finance-column cost-column">
        <view class="finance-sub-label"><t-icon name="bill" size="26rpx" color="#ff8e8e" />{{project.type === 'long_term' || project.type === 'flower_plant' ? '总支出' : '项目总成本'}}</view>
        <view class="finance-sub-value cost-sub-value">¥{{project.payableText}}</view>
      </view>
      <view class="finance-column profit-column">
        <view class="finance-sub-label"><t-icon name="chart-line" size="26rpx" color="#55e391" />{{project.type === 'long_term' || project.type === 'flower_plant' ? '累计利润' : '项目利润'}}</view>
        <view class="finance-sub-value profit-sub-value {{project.profitPositive ? '' : 'profit-negative'}}">¥{{project.profitText}}</view>
      </view>
    </view>
    <view class="profit-rate-panel {{project.profitPositive ? '' : 'profit-negative'}}">
      <view class="profit-rate-panel-label"><t-icon name="chart-line" size="28rpx" color="{{project.profitPositive ? '#55e391' : '#ffb4ab'}}" />利润率</view>
      <view class="profit-rate-panel-value">{{project.profitRateText}}</view>
    </view>
  </view>

  <!-- 基础客户信息卡片 -->
  <view class="detail-card customer-card" wx:if="{{project.type !== 'flower_plant'}}">
    <view class="card-header">
      <view class="card-heading">
        <view class="heading-icon customer-icon"><t-icon name="user" size="34rpx" color="#002045" /></view>
        <view class="card-title">基础信息</view>
      </view>
    </view>
    <view class="info-list">
      <view class="info-row"><text>客户名称</text><text class="info-value strong">{{project.client || '多客户共享业务账本'}}</text></view>
      <view class="info-row"><text>客户角色</text><text class="role-badge">{{project.roleText}}</text></view>
      <view class="info-row"><text>客户来源</text><text class="info-value">{{project.sourceText}}</text></view>
      <block wx:if="{{project.type !== 'long_term' && project.type !== 'flower_plant'}}">
        <view class="info-row"><text>项目场景</text><text class="info-value">{{project.sceneText}}</text></view>
        <view class="info-row"><text>人员数量</text><text class="info-value">{{project.staffCountText}} 人</text></view>
        <view class="info-row"><text>交付时间</text><text class="info-value">{{project.deliveryDateText}}</text></view>
      </block>
      <block wx:else>
        <view class="info-row"><text>业务模式</text><text class="info-value">{{project.type === 'flower_plant' ? '按单结算/独立客户流水' : '长期合作定期履约'}}</text></view>
      </block>
    </view>
  </view>

  <!-- 长期合作 / 鲜花绿植供应专属：服务履约流水与新增操作 -->
  <block wx:if="{{project.type === 'long_term' || project.type === 'flower_plant'}}">
    <!-- 常驻新增服务记录按钮 -->
    <view class="longterm-action-bar" wx:if="{{canWrite}}">
      <view class="add-service-btn" bindtap="openAddServiceRecord">
        <t-icon name="add-circle" size="38rpx" color="#ffffff" />
        <text>{{project.type === 'flower_plant' ? '新增业务记录/记账' : '新增服务履约与记账'}}</text>
      </view>
    </view>

    <!-- 服务履约时间轴流水卡片 -->
    <view class="detail-card service-records-card">
      <view class="card-header">
        <view class="card-heading">
          <view class="heading-icon service-icon"><t-icon name="assignment" size="34rpx" color="#002045" /></view>
          <view class="card-title">{{project.type === 'flower_plant' ? '业务记录与收支流水' : '服务履约与收支流水'}}</view>
        </view>
        <view class="records-count">共 {{serviceRecords.length}} 次</view>
      </view>

      <view class="service-record-timeline" wx:if="{{serviceRecords.length}}">
        <view class="timeline-item" wx:for="{{serviceRecords}}" wx:key="_id">
          <view class="timeline-dot"></view>
          <view class="timeline-content-card">
            <view class="timeline-head">
              <view class="timeline-date-wrap">
                <t-icon name="calendar" size="26rpx" color="#002045" />
                <text class="timeline-date">{{item.serviceDate}}</text>
              </view>
              <view class="timeline-actions" wx:if="{{canWrite}}">
                <view class="timeline-action-btn" data-item="{{item}}" catchtap="editServiceRecord">
                  <t-icon name="edit-1" size="30rpx" color="#43474e" />
                </view>
                <view class="timeline-action-btn delete-btn" data-id="{{item._id}}" catchtap="deleteServiceRecord">
                  <t-icon name="delete" size="30rpx" color="#ba1a1a" />
                </view>
              </view>
            </view>

            <!-- 独立客户标签展示（适用于鲜花绿植多客户流水） -->
            <view class="service-client-tag-row" wx:if="{{item.clientName || item.clientCompany}}" data-client-id="{{item.clientId}}" catchtap="openClientStatementForRecord">
              <t-icon name="user" size="26rpx" color="#002045" />
              <text class="service-client-tag-name">{{item.clientName || '客户'}}</text>
              <text class="service-client-tag-company" wx:if="{{item.clientCompany}}">({{item.clientCompany}})</text>
              <text class="service-client-tag-phone" wx:if="{{item.clientPhone}}"> · {{item.clientPhone}}</text>
              <view class="statement-link-btn" wx:if="{{item.clientId}}">
                <text>对账单</text>
                <t-icon name="chevron-right" size="24rpx" color="#002045" />
              </view>
            </view>

            <view class="service-content-title-row">
              <text class="service-content-label">{{project.type === 'flower_plant' ? '业务内容：' : '服务内容：'}}</text>
              <text class="service-content-value">{{item.displayContent || item.content}}</text>
              <view class="service-settlement-status {{item.isSettled ? 'settled-yes' : 'settled-no'}}">
                {{item.isSettled ? '已结清' : '未结清'}}
              </view>
            </view>

            <!-- 本次收支小看板 -->
            <view class="service-fin-strip">
              <view class="fin-col">
                <text class="fin-label">本次支出</text>
                <text class="fin-val cost-val">¥{{item.costAmountText}}</text>
              </view>
              <view class="fin-col">
                <text class="fin-label">订单金额</text>
                <text class="fin-val receive-val">¥{{item.receivableText}}</text>
              </view>
              <block wx:if="{{!item.isSettled}}">
              <view class="fin-col">
                <text class="fin-label">本次已收</text>
                <text class="fin-val received-val">¥{{item.receivedText}}</text>
              </view>
              <view class="fin-col">
                <text class="fin-label">未收金额</text>
                <text class="fin-val unreceived-val">¥{{item.unreceivedText}}</text>
              </view>
              </block>
            </view>
            <view class="record-profit-rate-panel">
              <text>本次业务利润率</text>
              <text class="record-profit-rate-value">{{item.profitRateText}}</text>
            </view>

            <!-- 支出明细标签 -->
            <view class="costs-tag-list" wx:if="{{item.costs && item.costs.length}}">
              <view class="cost-tag" wx:for="{{item.costs}}" wx:for-item="c" wx:key="id">
                <text class="cost-tag-cat">{{c.category || c.categoryLabel}}</text>
                <text class="cost-tag-amount">¥{{c.amount}}</text>
                <text class="cost-tag-remark" wx:if="{{c.remark}}">({{c.remark}})</text>
              </view>
            </view>

            <!-- 统一凭证与图片附件回显 -->
            <view class="record-voucher-grid" wx:if="{{item.voucherUrls && item.voucherUrls.length}}">
              <view class="record-voucher-thumb" wx:for="{{item.voucherUrls}}" wx:for-item="vUrl" wx:key="*this" catchtap="previewVoucherThumbnail" data-url="{{vUrl}}" data-urls="{{item.voucherUrls}}">
                <image class="voucher-img" src="{{vUrl}}" mode="aspectFill" />
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="empty-timeline" wx:else>
        <t-icon name="time" size="64rpx" color="#a0aec0" />
        <view class="empty-text">{{project.type === 'flower_plant' ? '暂无业务记录' : '暂无服务履约记录'}}</view>
        <view class="empty-sub">{{project.type === 'flower_plant' ? '点击上方“新增业务记录/记账”开始记录鲜花绿植业务与收支' : '点击上方“+新增服务履约与记账”开始记录日常养护与收支'}}</view>
      </view>
    </view>
  </block>

  <!-- 常规项目：成本支出与凭证 -->
  <block wx:else>
    <view class="detail-card cost-card">
      <view class="card-header">
        <view class="card-heading">
          <view class="heading-icon cost-icon"><t-icon name="bill" size="36rpx" color="#002045" /></view>
          <view class="card-title">成本支出</view>
        </view>
        <view class="cost-total">
          <view>总预计成本</view>
          <text>¥{{project.payableText}}</text>
        </view>
      </view>
      <view class="cost-item" wx:for="{{project.costs}}" wx:key="id">
        <view class="cost-symbol"><t-icon name="vehicle" size="34rpx" color="#002045" /></view>
        <view class="cost-info">
          <view class="cost-name">{{item.displayName}}</view>
          <view class="cost-category">{{item.subText}}</view>
        </view>
        <view class="cost-right">
          <view class="cost-amount">¥{{item.amountText}}</view>
          <view class="settled {{item.settled ? 'yes' : ''}}">
            {{item.settled ? '已支付' : '待支付'}}
          </view>
        </view>
      </view>
      <view class="empty-row" wx:if="{{!project.costs.length}}">暂无成本记录</view>
    </view>

    <view class="detail-card voucher-card">
      <view class="card-header">
        <view class="card-heading">
          <view class="heading-icon voucher-icon"><t-icon name="bill" size="36rpx" color="#8e43c7" /></view>
          <view class="card-title">项目凭证</view>
        </view>
      </view>
      <view class="voucher-grid">
        <view class="voucher-item" wx:for="{{visibleVouchers}}" wx:key="_id">
          <image
            wx:if="{{item.isImage !== false}}"
            class="voucher-image"
            src="{{item.displayUrl || item.fileUrl}}"
            mode="aspectFill"
            data-id="{{item._id || item.id}}"
            bindtap="previewVoucher"
          />
          <view
            wx:else
            class="pdf-voucher"
            data-id="{{item._id || item.id}}"
            bindtap="previewVoucher"
          >
            <t-icon name="file-pdf" size="54rpx" color="#ba1a1a" />
            <text class="pdf-voucher-name">{{item.pdfDisplayName}}</text>
          </view>
        </view>
      </view>
      <view class="attachment-toggle" wx:if="{{vouchers.length > 3}}" bindtap="toggleVoucherExpand">{{vouchersExpanded ? '收起' : '查看全部'}}（{{vouchers.length}} 张）</view>
      <view class="empty-row" wx:if="{{!vouchers.length}}">暂无凭证</view>
    </view>

    <view class="detail-card completion-card">
      <view class="card-header"><view class="card-heading"><view class="heading-icon voucher-icon"><t-icon name="image" size="36rpx" color="#1a7f5a" /></view><view class="card-title">项目完工图</view></view><text class="card-count">{{completionImages.length}} 张</text></view>
      <view class="voucher-grid"><view class="voucher-item" wx:for="{{visibleCompletionImages}}" wx:key="fileId"><image class="voucher-image" src="{{item.displayUrl}}" mode="aspectFill" data-url="{{item.displayUrl}}" bindtap="previewCompletionImage" /></view></view>
      <view class="attachment-toggle" wx:if="{{completionImages.length > 3}}" bindtap="toggleCompletionImages">{{completionImagesExpanded ? '收起' : '查看全部'}}（{{completionImages.length}} 张）</view>
      <view class="empty-row" wx:if="{{!completionImages.length}}">暂无完工图，可在编辑项目中补充上传</view>
    </view>
  </block>

</view>

<view class="detail-loading-mask" wx:if="{{loading}}" style="top: {{navHeight}}px;" catchtap="stopPropagation" catchtouchmove="stopPropagation">
  <view class="detail-loading-content">
    <view class="detail-loading-spinner"><t-loading size="64rpx" theme="circular" /></view>
    <text class="detail-loading-text">正在加载项目详情...</text>
  </view>
</view>

<!-- 常规项目快速记账抽屉 -->
<view class="overlay" wx:if="{{formMode}}" bindtap="closeForm">
  <view
    class="form-sheet"
    style="transform: translateY(-{{keyboardHeight}}px); max-height: {{keyboardHeight > 0 ? (windowHeight - keyboardHeight - 16) : (windowHeight * 0.78)}}px;"
    catchtap="stopPropagation"
  >
    <view class="sheet-title">{{formMode === 'receipt' ? '登记收款' : '登记支出'}}</view>
    <view class="field-label">本次金额</view>
    <view class="amount-input-wrap">
      <text>¥</text>
      <input
        class="amount-input"
        type="digit"
        placeholder="0.00"
        value="{{amountInput}}"
        adjust-position="{{false}}"
        cursor-spacing="160"
        bindinput="onAmountInput"
      />
    </view>

    <block wx:if="{{formMode === 'cost'}}">
      <view class="field-label">成本类别</view>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-field">{{categories[categoryIndex]}}⌄</view>
      </picker>
      <view class="field-label">供应商</view>
      <input
        class="text-input"
        placeholder="选填，默认为无"
        value="{{supplierInput}}"
        adjust-position="{{false}}"
        cursor-spacing="120"
        bindinput="onSupplierInput"
      />
      <view class="switch-row">
        <view>
          <view class="switch-title">已支付</view>
          <view class="muted switch-tip">开启后计入已付成本</view>
        </view>
        <switch color="#146C43" checked="{{settled}}" bindchange="onSettledChange" />
      </view>
    </block>

    <button class="primary-button submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitRecord">
      确认提交
    </button>
    <button class="cancel-button" disabled="{{submitting}}" bindtap="closeForm">取消</button>
  </view>
</view>

<!-- 长期项目 / 鲜花绿植服务记录弹窗 -->
<service-record-modal
  visible="{{serviceModalVisible}}"
  projectId="{{projectId}}"
  projectName="{{project.name}}"
  projectType="{{project.type}}"
  record="{{activeRecord}}"
  bindsuccess="onServiceRecordSuccess"
  bindclose="onServiceRecordClose"
/>

<!-- 客户对账单与催款明细弹窗 -->
<t-dialog
  visible="{{statementModalVisible}}"
  title="客户对账单与催款明细"
  confirm-btn="一键复制微信文本"
  cancel-btn="关闭"
  bindconfirm="copyStatementText"
  bindcancel="closeStatementModal"
>
  <view class="statement-modal-body" slot="content" wx:if="{{statementData}}">
    <view class="statement-summary-box">
      <view class="statement-sum-col">
        <text class="statement-sum-label">累计订单金额</text>
        <text class="statement-sum-val">¥{{statementData.totalReceivable}}</text>
      </view>
      <view class="statement-sum-col">
        <text class="statement-sum-label">已付金额</text>
        <text class="statement-sum-val">¥{{statementData.totalReceived}}</text>
      </view>
      <view class="statement-sum-col highlight">
        <text class="statement-sum-label">待收尾款</text>
        <text class="statement-sum-val unpaid">¥{{statementData.totalUnreceived}}</text>
      </view>
    </view>

    <view class="statement-text-preview-title">微信对账预览文本：</view>
    <scroll-view class="statement-text-scroll" scroll-y show-scrollbar="{{false}}">
      <text class="statement-preview-text" selectable>{{statementText}}</text>
    </scroll-view>
  </view>
</t-dialog>
