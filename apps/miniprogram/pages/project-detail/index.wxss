page {
  background: #f9f9ff;
}

.detail-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 10;
  box-sizing: border-box;
  display: flex;
  width: 100%;
  align-items: center;
  border-bottom: 2rpx solid #f0f3ff;
  background: #ffffff;
}

.detail-nav-placeholder {
  width: 100%;
}

.nav-back {
  position: absolute;
  bottom: 0;
  left: 30rpx;
  display: flex;
  width: 70rpx;
  height: 88rpx;
  align-items: center;
  justify-content: flex-start;
}

.nav-title {
  position: absolute;
  right: 150rpx;
  bottom: 0;
  left: 150rpx;
  height: 88rpx;
  color: #002045;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}

.project-heading-main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.detail-actions {
  display: flex;
  margin-bottom: 16rpx;
  align-items: center;
  justify-content: flex-end;
}

.heading-edit {
  position: relative;
  z-index: 2;
  display: flex;
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 14rpx 28rpx;
  align-items: center;
  gap: 10rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  background: linear-gradient(180deg, #2a4a78 0%, #1a365d 48%, #102846 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow:
    0 10rpx 22rpx rgba(16, 40, 70, 0.28),
    0 4rpx 8rpx rgba(16, 40, 70, 0.18),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.22);
}

.detail-page {
  min-height: 100vh;
  padding: 28rpx 32rpx 72rpx;
  color: #121c2c;
}

.project-heading {
  position: relative;
  display: flex;
  margin-bottom: 24rpx;
  overflow: hidden;
  padding: 24rpx 28rpx;
  align-items: flex-start;
  border: 2rpx solid rgba(214, 227, 255, .8);
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f2f6ff 100%);
  box-shadow:
    0 12rpx 30rpx rgba(26, 54, 93, .08),
    inset 0 2rpx 0 rgba(255, 255, 255, .95);
}

.project-heading::after {
  position: absolute;
  top: -54rpx;
  right: -42rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: rgba(214, 227, 255, .48);
  content: "";
}

.project-name {
  position: relative;
  z-index: 1;
  color: #002045;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-shadow: 0 2rpx 2rpx rgba(0, 32, 69, .05);
}

.status-tags-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.status {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 9rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 21rpx;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-completed {
  border: 2rpx solid #9db7e5;
  background: #e7eeff;
  color: #002045;
  font-weight: 700;
}

.status-closed {
  border: 2rpx solid #7dcea0;
  background: #e8f8ef;
  color: #0f7a45;
  font-weight: 700;
}

.status-archived {
  border: 2rpx solid #c7cbd1;
  background: #f1f3f5;
  color: #6b7280;
  font-weight: 700;
}

.status-terminated {
  background: #e7eeff;
  color: #455f88;
}

.finance-card {
  position: relative;
  overflow: hidden;
  padding: 46rpx 36rpx 36rpx;
  border: 2rpx solid rgba(134, 160, 205, .3);
  border-radius: 32rpx;
  background: linear-gradient(145deg, #001b3c 0%, #0b3566 55%, #174b7d 100%);
  color: #fff;
  box-shadow:
    0 26rpx 52rpx rgba(0, 32, 69, .22),
    0 8rpx 18rpx rgba(0, 32, 69, .16),
    inset 0 2rpx 0 rgba(255, 255, 255, .12);
}

.finance-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.finance-glow-top {
  top: -180rpx;
  right: -120rpx;
  width: 430rpx;
  height: 430rpx;
  background: radial-gradient(circle, rgba(86, 146, 208, .28) 0%, rgba(86, 146, 208, 0) 70%);
}

.finance-glow-bottom {
  bottom: -230rpx;
  left: -160rpx;
  width: 480rpx;
  height: 480rpx;
  background: radial-gradient(circle, rgba(69, 114, 172, .22) 0%, rgba(69, 114, 172, 0) 72%);
}

.finance-label,
.finance-sub-label,
.profit-label {
  position: relative;
  z-index: 1;
  color: rgba(255, 255, 255, .7);
  font-size: 22rpx;
}

.order-amount {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  text-shadow: 0 7rpx 16rpx rgba(0, 0, 0, .22);
}

.finance-columns {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  margin-top: 46rpx;
}

.finance-column {
  padding: 18rpx 20rpx;
  border: 2rpx solid rgba(255, 255, 255, .08);
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, .075), rgba(255, 255, 255, .025));
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .06);
}

.pending-column {
  border-color: rgba(255, 209, 102, .32);
  background: linear-gradient(135deg, rgba(255, 190, 66, .18), rgba(255, 148, 48, .08));
  box-shadow:
    0 8rpx 18rpx rgba(255, 157, 46, .1),
    inset 0 2rpx 0 rgba(255, 225, 157, .1);
}

.pending-column .finance-sub-label {
  color: #ffe09a;
}

.pending-column .finance-sub-value {
  color: #ffd166;
  text-shadow: 0 4rpx 12rpx rgba(255, 160, 32, .24);
}

.finance-sub-label {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.finance-sub-value {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.finance-columns-bottom {
  margin-top: 20rpx;
}

.cost-column {
  border-color: rgba(255, 142, 142, .26);
  background: linear-gradient(135deg, rgba(255, 120, 120, .15), rgba(255, 80, 80, .06));
  box-shadow:
    0 8rpx 18rpx rgba(255, 80, 80, .08),
    inset 0 2rpx 0 rgba(255, 180, 180, .08);
}

.cost-column .finance-sub-label {
  color: #ffb4b4;
}

.cost-sub-value {
  color: #ff9e9e;
  text-shadow: 0 4rpx 12rpx rgba(255, 100, 100, .2);
}

.profit-column {
  border-color: rgba(85, 227, 145, .28);
  background: linear-gradient(135deg, rgba(85, 227, 145, .16), rgba(44, 190, 111, .06));
  box-shadow:
    0 8rpx 18rpx rgba(44, 190, 111, .1),
    inset 0 2rpx 0 rgba(140, 245, 180, .1);
}

.profit-column .finance-sub-label {
  color: #a3f7c4;
}

.profit-sub-value {
  color: #55e391;
  text-shadow: 0 4rpx 12rpx rgba(44, 190, 111, .24);
}

.profit-sub-value.profit-negative {
  color: #ffb4ab;
  text-shadow: 0 4rpx 12rpx rgba(255, 100, 100, .24);
}

.profit-panel {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 25rpx 28rpx;
  border: 2rpx solid rgba(255, 255, 255, .14);
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, .14), rgba(255, 255, 255, .08));
  box-shadow:
    0 10rpx 22rpx rgba(0, 16, 40, .18),
    inset 0 2rpx 0 rgba(255, 255, 255, .08);
}

.profit-value {
  margin-top: 6rpx;
  color: #55e391;
  font-size: 40rpx;
  font-weight: 700;
}

.profit-negative {
  color: #ffb4ab;
}

.profit-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(85, 227, 145, .16);
  color: #55e391;
  font-size: 38rpx;
  font-weight: 700;
  box-shadow:
    0 8rpx 18rpx rgba(44, 190, 111, .16),
    inset 0 0 0 2rpx rgba(85, 227, 145, .12);
}

.detail-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border: 2rpx solid rgba(214, 227, 255, .62);
  border-radius: 32rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fefeff 100%);
  box-shadow:
    0 18rpx 42rpx rgba(26, 54, 93, .09),
    0 4rpx 12rpx rgba(26, 54, 93, .05),
    inset 0 2rpx 0 rgba(255, 255, 255, .9);
}

.card-header,
.card-heading,
.info-row,
.cost-item {
  display: flex;
  align-items: center;
}

.card-header,
.info-row,
.cost-item {
  justify-content: space-between;
}

.card-heading {
  gap: 18rpx;
}

.heading-icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(26, 54, 93, .09);
}

.customer-icon {
  background: #edf4ff;
  color: #002045;
}

.cost-icon {
  background: #fff5eb;
  color: #a84f00;
}

.voucher-icon {
  background: #f7edff;
  color: #76508e;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
}

.info-list {
  margin-top: 24rpx;
}

.info-row {
  min-height: 64rpx;
  border-bottom: 2rpx solid #eef1f7;
  color: #5f6365;
  font-size: 26rpx;
}

.info-value {
  max-width: 62%;
  color: #121c2c;
  text-align: right;
}

.strong {
  font-weight: 700;
}

.role-badge {
  padding: 5rpx 14rpx;
  border-radius: 6rpx;
  background: #e7eeff;
  color: #002045;
  font-size: 21rpx;
  font-weight: 600;
}

.cost-total {
  color: #74777f;
  text-align: right;
  font-size: 17rpx;
}

.cost-total text {
  display: block;
  margin-top: 4rpx;
  color: #ba1a1a;
  font-size: 26rpx;
  font-weight: 700;
}

.cost-item {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid rgba(217, 227, 249, .75);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow:
    0 8rpx 18rpx rgba(26, 54, 93, .055),
    inset 0 2rpx 0 rgba(255, 255, 255, .95);
}

.cost-symbol {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #eef0f3;
  border-radius: 50%;
  background: #f9fafc;
  color: #002045;
}

.cost-info {
  min-width: 0;
  margin-left: 18rpx;
  flex: 1;
}

.cost-name {
  overflow: hidden;
  color: #121c2c;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cost-category {
  margin-top: 6rpx;
  color: #74777f;
  font-size: 20rpx;
}

.cost-right {
  margin-left: 14rpx;
  text-align: right;
}

.cost-amount {
  font-size: 25rpx;
  font-weight: 700;
}

.settled {
  display: inline-block;
  margin-top: 6rpx;
  padding: 3rpx 9rpx;
  border-radius: 5rpx;
  background: #fff0e6;
  color: #b54708;
  font-size: 17rpx;
}

.settled.yes {
  background: #eef0f3;
  color: #5f6365;
}

.voucher-count {
  color: #74777f;
  font-size: 22rpx;
}

.voucher-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.voucher-item {
  position: relative;
  width: 100%;
  height: 190rpx;
  overflow: hidden;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 18rpx rgba(26, 54, 93, .1);
}

.voucher-image {
  width: 100%;
  height: 100%;
}

.pdf-voucher {
  display: flex;
  height: 100%;
  box-sizing: border-box;
  padding: 20rpx 12rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #f0f3ff;
}

.pdf-voucher-name {
  width: 100%;
  overflow: hidden;
  color: #343943;
  text-align: center;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.description {
  margin-top: 20rpx;
  color: #5f6365;
  font-size: 25rpx;
  line-height: 1.7;
}

.empty-row {
  padding: 36rpx 0 10rpx;
  color: #989fa6;
  text-align: center;
  font-size: 23rpx;
}

.detail-loading-mask {
  position: fixed;
  z-index: 50;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(249, 249, 255, .78);
}

.detail-loading-content {
  display: flex;
  padding: 24rpx 34rpx;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid #e7eeff;
  border-radius: 18rpx;
  background: #ffffff;
  color: #002045;
  font-size: 25rpx;
  box-shadow: 0 10rpx 28rpx rgba(26, 54, 93, .1);
}

.overlay {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 18, .48);
}

.form-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 78vh;
  overflow-y: auto;
  padding: 34rpx 34rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
  transition: transform .18s ease, max-height .18s ease;
}

.sheet-title {
  margin-bottom: 34rpx;
  color: #002045;
  font-size: 36rpx;
  font-weight: 700;
}

.field-label {
  margin: 26rpx 0 12rpx;
  color: #526058;
  font-size: 24rpx;
  font-weight: 600;
}

.amount-input-wrap,
.text-input,
.picker-field {
  box-sizing: border-box;
  height: 84rpx;
  border: 2rpx solid #d9e0e7;
  border-radius: 14rpx;
  background: #fafcff;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  font-size: 34rpx;
}

.amount-input {
  height: 100%;
  margin-left: 14rpx;
  flex: 1;
  font-size: 34rpx;
}

.text-input,
.picker-field {
  padding: 0 22rpx;
  line-height: 84rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  padding: 20rpx 0;
}

.switch-title {
  font-weight: 600;
}

.switch-tip {
  margin-top: 5rpx;
  color: #74777f;
  font-size: 22rpx;
}

.submit-button {
  margin-top: 30rpx;
  background: #002045;
}

.cancel-button {
  height: 76rpx;
  margin-top: 14rpx;
  background: transparent;
  color: #66736c;
  font-size: 26rpx;
  line-height: 76rpx;
}

/* 长期合作专属头部与标识 */
.heading-title-group {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.type-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.longterm-badge {
  background: #fff7ed;
  color: #c2410c;
  border: 1rpx solid #fed7aa;
}

.normal-badge {
  background: #f1f5f9;
  color: #334155;
  border: 1rpx solid #cbd5e1;
}

.status-in_cooperation {
  border: 2rpx solid #a5b4fc;
  background: #eef2ff;
  color: #3730a3;
  font-weight: 700;
}
.status-in_cooperation .status-dot {
  background: #4f46e5;
}

.profit-right-stat {
  display: flex;
  align-items: center;
}
.stat-cost-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 长期合作常驻快捷主按钮 */
.longterm-action-bar {
  margin: 28rpx 0 10rpx;
}

.add-service-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #002045 0%, #1a365d 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(0, 32, 69, 0.2);
  transition: transform 0.15s ease;
}

.add-service-btn:active {
  transform: scale(0.98);
}

/* 服务履约时间轴卡片 */
.service-records-card {
  margin-top: 24rpx;
}

.records-count {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: #edf2fc;
  color: #002045;
  font-size: 23rpx;
  font-weight: 700;
}

.service-record-timeline {
  position: relative;
  margin-top: 24rpx;
  padding-left: 28rpx;
}

.service-record-timeline::before {
  position: absolute;
  top: 16rpx;
  bottom: 16rpx;
  left: 12rpx;
  width: 4rpx;
  background: #d6e3ff;
  content: "";
}

.timeline-item {
  position: relative;
  margin-bottom: 36rpx;
}

.timeline-item:last-child {
  margin-bottom: 10rpx;
}

.timeline-dot {
  position: absolute;
  top: 24rpx;
  left: -28rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  background: #002045;
  box-shadow: 0 0 0 4rpx #d6e3ff;
}

.timeline-content-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fbfcfe;
  border: 2rpx solid #e1e9f8;
  box-shadow: 0 4rpx 14rpx rgba(0, 32, 69, 0.03);
}

.timeline-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.timeline-date-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.timeline-date {
  color: #002045;
  font-size: 28rpx;
  font-weight: 700;
}

.timeline-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.timeline-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #edf2fc;
}

.timeline-action-btn.delete-btn {
  background: #fee2e2;
}

.service-content-title-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.service-content-label {
  color: #535f70;
  font-size: 27rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.service-content-value {
  color: #002045;
  font-size: 30rpx;
  font-weight: 700;
}

.service-fin-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #f0f4fa;
  margin-bottom: 14rpx;
}

.fin-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.fin-label {
  color: #74777f;
  font-size: 21rpx;
}

.fin-val {
  font-size: 26rpx;
  font-weight: 700;
}

.cost-val {
  color: #ba1a1a;
}

.receive-val {
  color: #002045;
}

.settled-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.settled-yes {
  background: #e8f8ef;
  color: #0f7a45;
}

.settled-no {
  background: #fef3c7;
  color: #b45309;
}

.costs-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.cost-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #edf2fa;
  border: 1rpx solid #d9e3f9;
  font-size: 22rpx;
  color: #43474e;
}

.cost-tag-amount {
  color: #ba1a1a;
  font-weight: 700;
}

.cost-tag-remark {
  color: #74777f;
}

.record-voucher-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #e1e9f8;
}

.record-voucher-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid #d9e3f9;
  background: #f0f4fa;
}

.record-voucher-thumb .voucher-img {
  width: 100%;
  height: 100%;
  display: block;
}

.empty-timeline {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 20rpx;
  text-align: center;
}

.empty-text {
  margin-top: 18rpx;
  color: #43474e;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-sub {
  margin-top: 8rpx;
  color: #74777f;
  font-size: 24rpx;
}
