.recurring-page { min-height: 100vh; background: #f8fafc; box-sizing: border-box; padding-bottom: 60rpx; }
.page-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: #ffffff; border-bottom: 1rpx solid #eef2f6; }
.nav-back { position: absolute; left: 24rpx; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 50%; }
.nav-title { font-size: 32rpx; font-weight: 700; color: #002045; }
.nav-action { position: absolute; right: 24rpx; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 50%; background: #f1f5f9; }
.nav-placeholder { width: 100%; }

/* 概览条 */
.overview-banner { margin: 24rpx 28rpx 0; background: #ffffff; border-radius: 24rpx; padding: 24rpx 28rpx; display: flex; align-items: center; justify-content: space-around; box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03); border: 1rpx solid #f1f5f9; }
.overview-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.overview-label { font-size: 22rpx; color: #64748b; }
.overview-val { font-size: 30rpx; font-weight: 700; color: #0f172a; }
.overview-val.amount { color: #002045; font-size: 34rpx; }
.overview-divider { width: 2rpx; height: 44rpx; background: #e2e8f0; }

/* 规则列表 */
.rules-container { padding: 28rpx 28rpx 0; }
.rules-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20rpx; padding: 0 4rpx; }
.rules-title { font-size: 30rpx; font-weight: 700; color: #002045; }
.rules-tip { font-size: 22rpx; color: #94a3b8; }

.rule-card { background: #ffffff; border-radius: 28rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.04); border: 1rpx solid #eef2f6; }
.rule-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20rpx; }
.rule-info { flex: 1; min-width: 0; }
.rule-category-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.rule-category { font-size: 32rpx; font-weight: 700; color: #0f172a; }
.status-badge { font-size: 20rpx; font-weight: 600; padding: 2rpx 12rpx; border-radius: 8rpx; }
.status-badge.active { background: #ecfdf5; color: #059669; }
.status-badge.stopped { background: #fef2f2; color: #dc2626; }
.status-badge.completed { background: #f1f5f9; color: #64748b; }
.rule-period { font-size: 22rpx; color: #64748b; }

.rule-amount-wrap { text-align: right; }
.amount-per-month { font-size: 36rpx; font-weight: 800; color: #002045; }
.amount-unit { font-size: 22rpx; color: #64748b; }

/* 进度 */
.progress-wrap { background: #f8fafc; border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 16rpx; }
.progress-info { display: flex; align-items: center; justify-content: space-between; font-size: 22rpx; margin-bottom: 10rpx; }
.progress-text { color: #475569; font-weight: 500; }
.progress-total { color: #94a3b8; }
.progress-bar-bg { width: 100%; height: 10rpx; background: #e2e8f0; border-radius: 999rpx; overflow: hidden; }
.progress-bar-fill { height: 100%; background: linear-gradient(90deg, #36AD97, #2A9A87); border-radius: 999rpx; transition: width .3s ease; }

.rule-remark { font-size: 22rpx; color: #64748b; background: #f8fafc; padding: 12rpx 16rpx; border-radius: 12rpx; margin-bottom: 20rpx; line-height: 1.4; }
.remark-prefix { color: #94a3b8; }

/* 底部操作区 */
.rule-actions { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; border-top: 1rpx solid #f1f5f9; padding-top: 20rpx; }
.action-btn { display: flex; align-items: center; gap: 6rpx; padding: 10rpx 22rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; }
.edit-btn { background: #e8f6f4; color: #187a68; }
.stop-btn { background: #fef3c7; color: #b45309; }
.delete-btn { background: #fee2e2; color: #ba1a1a; }
.action-btn:active { opacity: 0.8; transform: scale(0.98); }

/* 空状态与加载 */
.empty-state { padding: 80rpx 0; display: flex; flex-direction: column; align-items: center; gap: 20rpx; }
.empty-text { font-size: 26rpx; color: #94a3b8; }
.empty-btn { height: 72rpx; padding: 0 40rpx; border-radius: 36rpx; background: linear-gradient(135deg, #36AD97, #2A9A87); color: #ffffff; font-size: 26rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; border: none; box-shadow: 0 10rpx 20rpx rgba(42, 154, 135, .2); }
.loading-state { padding: 40rpx 0; display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 24rpx; color: #94a3b8; }

/* 编辑弹窗 */
.edit-modal { background: #f4f8f7; border-radius: 40rpx 40rpx 0 0; padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); box-shadow: 0 -12rpx 32rpx rgba(24, 34, 32, .12); }
.modal-title { font-size: 34rpx; font-weight: 700; color: #182220; margin-bottom: 8rpx; }
.modal-subtitle { font-size: 24rpx; color: #64748b; margin-bottom: 14rpx; }
.modal-hint { font-size: 22rpx; color: #187a68; background: #e8f6f4; padding: 12rpx 18rpx; border-radius: 14rpx; margin-bottom: 28rpx; line-height: 1.4; }
.modal-field { margin-bottom: 24rpx; }
.field-label { font-size: 26rpx; font-weight: 600; color: #1e293b; display: block; margin-bottom: 12rpx; }
.field-input { height: 84rpx; background: #ffffff; border: 2rpx solid #d4e4df; border-radius: 18rpx; padding: 0 24rpx; font-size: 28rpx; color: #0f172a; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 36rpx; }
.modal-btn { flex: 1; height: 88rpx; border-radius: 44rpx; font-size: 28rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; border: none; }
.modal-btn.cancel { background: #f1f5f9; color: #475569; }
.modal-btn.confirm { background: linear-gradient(135deg, #36AD97, #2A9A87); color: #ffffff; box-shadow: 0 10rpx 20rpx rgba(42, 154, 135, .2); }
