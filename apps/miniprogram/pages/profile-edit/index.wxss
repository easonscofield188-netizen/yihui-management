page {
  background: #f8fafd;
  color: #121c2c;
}

.profile-edit-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: #f8fafd;
}

/* 顶部导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #eef2f8;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
}

.nav-back:active {
  background: #f1f5f9;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #002045;
}

.nav-placeholder {
  width: 68rpx;
}

/* 主内容区域 */
.content {
  padding: 30rpx 28rpx;
}

/* 头像编辑卡片 */
.avatar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 28rpx 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 2rpx solid #e2e8f2;
  box-shadow: 0 10rpx 30rpx rgba(0, 32, 69, 0.05);
}

.avatar-picker-wrap {
  position: relative;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50rpx;
  background: #eef4fe;
  border: 4rpx solid #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 32, 69, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 46rpx;
}

.avatar-camera-btn {
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #002045;
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 32, 69, 0.25);
}

.avatar-tip {
  margin-top: 18rpx;
  font-size: 25rpx;
  color: #1a365d;
  font-weight: 600;
}

/* 表单卡片 */
.form-card {
  margin-top: 28rpx;
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 2rpx solid #e2e8f2;
  box-shadow: 0 8rpx 24rpx rgba(0, 32, 69, 0.04);
}

.field-label {
  margin: 30rpx 0 14rpx;
  color: #242c3a;
  font-size: 27rpx;
  font-weight: 600;
}

.field-label:first-child {
  margin-top: 0;
}

.field-label.required::after {
  margin-left: 6rpx;
  color: #ba1a1a;
  content: "*";
}

.input-shell {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  border: 2rpx solid #c4c6cf;
  border-radius: 16rpx;
  background: #f0f3ff;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.input-shell:focus-within {
  border-color: #1a365d;
  box-shadow: 0 0 0 2rpx rgba(26, 54, 93, 0.1);
}

.form-input {
  min-height: 88rpx;
  padding: 0 24rpx;
  background: transparent !important;
  color: #121c2c;
  font-size: 28rpx;
  line-height: 88rpx;
}

.field-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.form-divider {
  height: 2rpx;
  background: #edf2f7;
  margin: 32rpx 0 20rpx;
}

/* 只读信息排版 */
.readonly-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.readonly-label {
  color: #64748b;
}

.readonly-val {
  color: #1a273a;
  font-weight: 600;
}

.readonly-val.mono {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-family: monospace;
  color: #334155;
}

.role-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #e6f4ea;
  color: #137333;
}

.email-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.email-txt {
  font-size: 25rpx;
  color: #002045;
  font-weight: 600;
}

.link-txt {
  font-size: 23rpx;
  color: #1a365d;
  font-weight: 600;
  text-decoration: underline;
}

/* 底部操作栏 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(10rpx);
  border-top: 2rpx solid #eef2f8;
}

.submit-btn {
  width: 100% !important;
  height: 94rpx !important;
  border-radius: 20rpx !important;
  background: #002045 !important;
  border: 2rpx solid #002045 !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  color: #ffffff !important;
  box-shadow: 0 6rpx 16rpx rgba(0, 32, 69, 0.16);
}

/* 安全确认与密码鉴权弹窗 */
.safe-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 20, 45, 0.6);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.safe-modal-box {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 32, 69, 0.25);
  box-sizing: border-box;
  animation: modalPop 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalPop {
  0% { transform: scale(0.92); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.modal-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.modal-shield-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #eef4fe;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #002045;
}

.modal-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 34rpx;
  color: #64748b;
}

/* 变更差异列表 */
.change-diff-card {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #f8fafd;
  border: 2rpx dashed #d2e1fa;
}

.diff-title {
  font-size: 23rpx;
  font-weight: 700;
  color: #1a365d;
  margin-bottom: 8rpx;
}

.diff-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 23rpx;
  line-height: 36rpx;
  color: #334155;
}

.diff-bullet {
  color: #1a365d;
  font-weight: 700;
}

.diff-text {
  flex: 1;
  word-break: break-all;
}

/* 密码输入区 */
.modal-pwd-section {
  margin-top: 26rpx;
}

.pwd-field-label {
  font-size: 25rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.modal-input-shell {
  background: #f8fafc;
}

/* 弹窗底部按钮 */
.modal-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 36rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  transition: opacity 0.15s ease;
}

.modal-btn:active {
  opacity: 0.8;
}

.btn-cancel {
  background: #f1f5f9;
  color: #475569;
}

.btn-confirm {
  background: #002045;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(0, 32, 69, 0.2);
}

.btn-confirm.btn-loading {
  pointer-events: none;
  opacity: 0.8;
}
