page { background: #f9f9ff; }
.notification-page { min-height: 100vh; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); background: #f9f9ff; color: #121c2c; }
.page-nav { position: fixed; top: 0; right: 0; left: 0; z-index: 20; box-sizing: border-box; border-bottom: 2rpx solid #f0f3ff; background: rgba(255,255,255,.96); }
.nav-placeholder { width: 100%; }
.nav-back { position: absolute; bottom: 0; left: 24rpx; display: flex; width: 70rpx; height: 88rpx; align-items: center; }
.nav-title { position: absolute; right: 150rpx; bottom: 0; left: 150rpx; height: 88rpx; color: #002045; font-size: 36rpx; font-weight: 700; line-height: 88rpx; text-align: center; }
.toolbar { display: flex; padding: 24rpx 32rpx 18rpx; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 2rpx solid #e7eeff; background: #fff; }
.status-tabs { display: flex; gap: 12rpx; }
.status-tab { padding: 10rpx 26rpx; border: 2rpx solid #d9e3f9; border-radius: 999rpx; background: #fff; color: #43474e; font-size: 24rpx; }
.status-tab.active { border-color: #1a365d; background: #1a365d; color: #fff; font-weight: 600; }
.mark-all { color: #1a365d; font-size: 24rpx; font-weight: 600; }
.mark-all.disabled { color: #b4b8bf; }
.notification-list { padding: 28rpx 32rpx; }
.notification-card { display: flex; margin-bottom: 20rpx; padding: 26rpx 24rpx; align-items: center; gap: 20rpx; border: 2rpx solid #e1e6f0; border-radius: 20rpx; background: #fff; box-shadow: 0 7rpx 20rpx rgba(26,54,93,.04); }
.notification-card.unread { border-color: #b8caec; background: #f7f9ff; box-shadow: 0 8rpx 24rpx rgba(26,54,93,.08); }
.notification-icon { display: flex; box-sizing: border-box; width: 72rpx; height: 72rpx; flex: none; align-items: center; justify-content: center; border: 2rpx solid transparent; border-radius: 18rpx; }
.notification-icon.created { border-color: #b9e5ca; background: #e8f8ef; }
.notification-icon.updated { border-color: #bfd1f3; background: #e7eeff; }
.notification-main { min-width: 0; flex: 1; }
.notification-head { display: flex; min-width: 0; align-items: center; gap: 10rpx; }
.notification-title { min-width: 0; overflow: hidden; flex: 1; color: #121c2c; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.unread-dot { width: 13rpx; height: 13rpx; flex: none; border-radius: 50%; background: #ba1a1a; }
.notification-summary { margin-top: 8rpx; overflow: hidden; color: #43474e; font-size: 25rpx; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.notification-meta { margin-top: 10rpx; color: #8b919a; font-size: 21rpx; }
.empty { padding: 150rpx 0; color: #74777f; font-size: 25rpx; text-align: center; }
.empty-title { margin: 20rpx 0 10rpx; color: #43474e; font-size: 30rpx; font-weight: 600; }
.loading { display: flex; padding: 28rpx; align-items: center; justify-content: center; gap: 12rpx; color: #989fa6; font-size: 23rpx; }
