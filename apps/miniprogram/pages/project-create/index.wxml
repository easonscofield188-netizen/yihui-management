<view class="create-page">
  <view class="create-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px; padding-right: {{menuRightInset}}px;">
    <view class="nav-close" bindtap="close"><t-icon name="close" size="44rpx" color="#002045" /></view>
    <view class="nav-title">{{pageTitle}}</view>
    <view class="step-count">步骤 1 / 4</view>
  </view>

  <view class="progress"><view class="progress-current"></view></view>

  <scroll-view
    class="form-scroll"
    scroll-y
    scroll-with-animation
    scroll-top="{{formScrollTop}}"
    scroll-into-view="{{scrollTarget}}"
    show-scrollbar="{{false}}"
  >
    <view class="intro"><view class="intro-title">基础与客户信息</view><view>填写核心详情以开启您的项目之旅。</view></view>

    <view class="form-card">
      <view class="field-label">项目名称</view>
      <view class="input-shell"><t-input t-class="form-input" borderless value="{{form.name}}" placeholder="例如：西溪湿地动漫展会" bindchange="onNameChange" /></view>

      <view class="field-label">项目场景</view>
      <view class="input-shell select-shell {{isClosedEdit ? 'field-disabled' : ''}}" data-field="scene" bindtap="openPicker"><t-input t-class="form-input" borderless readonly disabled="{{isClosedEdit}}" value="{{projectScenes[sceneIndex].label}}" suffix-icon="chevron-down" /></view>

      <view class="field-label">交付日期</view>
      <view class="input-shell select-shell {{isDateLocked ? 'field-disabled' : ''}}" bindtap="openDatePicker"><t-input t-class="form-input" borderless readonly disabled="{{isDateLocked}}" value="{{form.startDate}}" placeholder="请选择交付日期" suffix-icon="calendar" /></view>
    </view>

    <view class="form-card client-card">
      <view class="client-head">
        <view class="card-title">客户详情</view>
        <view class="new-client" wx:if="{{!isClosedEdit}}">
          <text>新增客户</text>
          <t-switch value="{{form.createClient}}" bindchange="onCreateClientChange" />
        </view>
      </view>

      <view class="field-label">客户名称</view>
      <view class="input-shell select-shell {{isClosedEdit ? 'field-disabled' : ''}}" bindtap="openClientSelectPopup">
        <t-input
          t-class="form-input"
          borderless
          readonly
          disabled="{{isClosedEdit}}"
          value="{{form.client}}"
          placeholder="点击选择客户..."
          prefix-icon="user"
          suffix-icon="chevron-down"
        />
      </view>

      <block wx:if="{{form.clientId}}">
        <view class="field-label">客户角色</view>
        <view class="input-shell select-shell {{isClosedEdit || form.clientId ? 'field-disabled' : ''}}" data-field="role" bindtap="openPicker">
          <t-input t-class="form-input" borderless readonly disabled="{{isClosedEdit || form.clientId}}" value="{{clientRoles[roleIndex].label}}" suffix-icon="chevron-down" />
        </view>
        <view class="field-label">来源渠道</view>
        <view class="input-shell select-shell {{isClosedEdit || form.clientId ? 'field-disabled' : ''}}" data-field="source" bindtap="openPicker">
          <t-input t-class="form-input" borderless readonly disabled="{{isClosedEdit || form.clientId}}" value="{{clientSources[sourceIndex].label}}" suffix-icon="chevron-down" />
        </view>
      </block>
    </view>
    <view id="form-bottom-anchor" style="height: 40rpx;"></view>
  </scroll-view>

  <t-picker t-class-confirm="picker-confirm" visible="{{pickerVisible}}" value="{{pickerValue}}" title="{{pickerTitle}}" bindconfirm="onPickerConfirm" bindcancel="closePicker" bindclose="closePicker"><t-picker-item options="{{pickerOptions}}" /></t-picker>
  <t-date-time-picker t-class-confirm="picker-confirm" visible="{{datePickerVisible}}" mode="date" value="{{form.startDate}}" end="{{today}}" title="选择交付日期" confirm-btn="确定" bindconfirm="onDateConfirm" bindcancel="closeDatePicker" bindclose="closeDatePicker" />

  <!-- 选择客户弹窗 -->
  <t-popup
    t-class-content="client-select-popup"
    visible="{{clientSelectVisible}}"
    placement="bottom"
    close-on-overlay-click
    bindvisible-change="onClientSelectPopupChange"
  >
    <view class="client-select-dialog">
      <view class="popup-head">
        <text class="popup-title">选择客户</text>
        <t-icon name="close" size="40rpx" color="#43474e" bindtap="closeClientSelectPopup" />
      </view>

      <!-- 搜索框 -->
      <view class="client-search-shell">
        <t-input
          t-class="form-input"
          borderless
          clearable
          prefix-icon="search"
          value="{{clientSearchKeyword}}"
          placeholder="输入客户名称进行搜索..."
          bindchange="onClientSearchInput"
          bindclear="onClientSearchClear"
        />
      </view>

      <!-- 客户列表 -->
      <view class="client-select-content">
        <view class="client-popup-state" wx:if="{{clientLoading}}">
          <t-loading size="36rpx" theme="circular" />
          <text>正在搜索客户...</text>
        </view>

        <scroll-view
          class="client-select-scroll"
          scroll-y
          show-scrollbar="{{false}}"
          wx:elif="{{clients.length > 0}}"
        >
          <view
            wx:for="{{clients}}"
            wx:key="_id"
            class="client-select-item {{form.clientId === (item._id || item.id) ? 'active' : ''}}"
            data-client="{{item}}"
            bindtap="selectClient"
          >
            <view class="client-info">
              <view class="client-name">{{item.name}}</view>
              <view class="client-tags">
                <text class="client-tag" wx:if="{{item.roleLabel || item.roleText || item.role}}">{{item.roleLabel || item.roleText || item.role}}</text>
                <text class="client-tag source-tag" wx:if="{{item.sourceLabel || item.sourceText || item.source}}">{{item.sourceLabel || item.sourceText || item.source}}</text>
              </view>
            </view>
            <t-icon
              wx:if="{{form.clientId === (item._id || item.id)}}"
              name="check"
              size="36rpx"
              color="#1a365d"
            />
          </view>
        </scroll-view>

        <!-- 无搜索结果或列表为空，引导去新增客户 -->
        <view class="client-select-empty" wx:else>
          <t-icon name="user-search" size="64rpx" color="#989fa6" />
          <view class="empty-text">未找到匹配客户</view>
          <view class="empty-tip">您可以直接新增该客户并自动选中</view>
          <t-button
            t-class="empty-add-btn"
            theme="primary"
            variant="outline"
            icon="add"
            content="{{clientSearchKeyword ? '新增「' + clientSearchKeyword + '」' : '新增客户'}}"
            bindtap="openNewClientFromSearch"
          />
        </view>
      </view>

      <!-- 底部快捷新建按钮 -->
      <view class="popup-bottom-action" wx:if="{{clients.length > 0}}">
        <t-button
          t-class="popup-new-btn"
          theme="light"
          block
          icon="add"
          content="新增客户"
          bindtap="openNewClientFromSearch"
        />
      </view>
    </view>
  </t-popup>

  <!-- 新增客户弹窗 -->
  <t-popup t-class-content="new-client-popup" visible="{{newClientVisible}}" placement="bottom" close-on-overlay-click bindvisible-change="onNewClientPopupChange">
    <view class="new-client-dialog">
      <view class="new-client-title"><text>新增客户</text><t-icon name="close" size="40rpx" color="#43474e" bindclick="closeNewClient" /></view>
      <view class="popup-field-label">客户姓名</view>
      <view class="input-shell popup-input-shell"><t-input t-class="form-input" borderless value="{{newClient.name}}" placeholder="输入姓名" data-field="name" bindchange="onNewClientInput" /></view>
      <view class="popup-field-label">客户角色</view>
      <view class="input-shell popup-input-shell select-shell" data-field="role" bindtap="openNewClientPicker"><t-input t-class="form-input" borderless readonly value="{{clientRoles[newClientRoleIndex].label}}" suffix-icon="chevron-down" /></view>
      <view class="popup-field-label">来源渠道</view>
      <view class="input-shell popup-input-shell select-shell" data-field="source" bindtap="openNewClientPicker"><t-input t-class="form-input" borderless readonly value="{{clientSources[newClientSourceIndex].label}}" suffix-icon="chevron-down" /></view>
      <t-button t-class="add-client-button" theme="primary" block content="确认添加" loading="{{creatingClient}}" disabled="{{creatingClient}}" bindtap="submitNewClient" />
    </view>
    <view
      wx:if="{{newClientPickerVisible}}"
      class="nested-popup-mask"
    ></view>
  </t-popup>
  <t-picker t-class-confirm="picker-confirm" visible="{{newClientPickerVisible}}" value="{{newClientPickerValue}}" title="{{newClientPickerTitle}}" bindconfirm="onNewClientPickerConfirm" bindcancel="closeNewClientPicker" bindclose="closeNewClientPicker"><t-picker-item options="{{newClientPickerOptions}}" /></t-picker>

  <view class="wizard-footer"><t-button t-class="footer-text-button" theme="default" variant="text" icon="arrow-left" content="上一步" bindtap="previous" /><t-button t-class="next-button" theme="primary" icon="arrow-right" content="下一步" bindtap="next" /><t-button t-class="footer-text-button disabled-button" theme="default" variant="text" icon="check-circle" content="提交" disabled /></view>
</view>
