page { background: #f9f9ff; }
.create-page { --td-brand-color: #1a365d; --td-picker-confirm-color: #1a365d; display: flex; height: 100vh; overflow: hidden; flex-direction: column; background: #f9f9ff; color: #121c2c; }
.create-nav { position: relative; z-index: 2; box-sizing: border-box; display: flex; flex: none; padding-right: 30rpx; padding-left: 30rpx; align-items: center; border-bottom: 2rpx solid #f0f3ff; background: #f9f9ff; }
.nav-close { display: flex; width: 70rpx; height: 70rpx; align-items: center; justify-content: flex-start; }
.nav-title { margin-left: 16rpx; color: #002045; font-size: 40rpx; font-weight: 700; }
.step-count { margin-left: auto; padding: 12rpx 22rpx; border: 2rpx solid #d9e3f9; border-radius: 36rpx; color: #43474e; font-size: 26rpx; }
.progress { height: 10rpx; margin: 42rpx 32rpx 0; overflow: hidden; flex: none; border-radius: 10rpx; background: #e7eeff; }
.progress-current { width: 25%; height: 100%; background: #1a365d; }
.form-scroll { box-sizing: border-box; width: 100%; height: 0; min-height: 0; padding: 42rpx 30rpx 40rpx; flex: 1; }
.intro { color: #43474e; font-size: 27rpx; line-height: 42rpx; }
.intro-title { margin-bottom: 12rpx; color: #002045; font-size: 42rpx; font-weight: 700; line-height: 60rpx; }
.form-card { position: relative; margin-top: 44rpx; padding: 32rpx; border: 2rpx solid #d6e3ff; border-radius: 22rpx; background: #fff; }
.field-label { margin-top: 34rpx; margin-bottom: 16rpx; color: #242c3a; font-size: 28rpx; }
.field-label:first-child { margin-top: 0; }
.input-shell { box-sizing: border-box; width: 100%; min-height: 92rpx; overflow: hidden; border: 2rpx solid #c4c6cf; border-radius: 14rpx; background: #f0f3ff; }
.input-shell:focus-within { border-color: #1a365d; box-shadow: 0 0 0 2rpx rgba(26,54,93,.12); }
.form-input { min-height: 88rpx; padding: 0 24rpx; background: transparent !important; color: #121c2c; font-size: 28rpx; line-height: 88rpx; }
.select-shell { display: flex; align-items: center; }
.field-disabled {
  opacity: 1;
  background: #eceff3;
  --td-input-disabled-text-color: #121c2c;
  --td-input-suffix-icon-color: #5f6365;
}
.description-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border: 2rpx solid #c4c6cf;
  border-radius: 14rpx;
  background: #f0f3ff;
  color: #121c2c;
  font-size: 28rpx;
  line-height: 44rpx;
}
.client-card { margin-top: 34rpx; }
.client-head { display: flex; align-items: center; justify-content: space-between; }
.card-title { color: #002045; font-size: 36rpx; font-weight: 700; }
.new-client { display: flex; align-items: center; gap: 14rpx; color: #43474e; font-size: 26rpx; }

/* 客户选择弹窗样式 */
.client-select-popup {
  overflow: hidden;
  border-radius: 28rpx 28rpx 0 0;
  background: #f9f9ff;
}
.client-select-dialog {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  max-height: 78vh;
  padding: 32rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  flex-direction: column;
}
.popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.popup-title {
  color: #002045;
  font-size: 36rpx;
  font-weight: 700;
}
.client-search-shell {
  box-sizing: border-box;
  width: 100%;
  min-height: 86rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 2rpx solid #c4c6cf;
  border-radius: 14rpx;
  background: #ffffff;
}
.client-search-shell:focus-within {
  border-color: #1a365d;
  box-shadow: 0 0 0 2rpx rgba(26, 54, 93, 0.12);
}
.client-select-content {
  box-sizing: border-box;
  width: 100%;
  min-height: 380rpx;
  max-height: 52vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.client-select-scroll {
  box-sizing: border-box;
  width: 100%;
  max-height: 52vh;
}
.client-select-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 22rpx;
  margin-bottom: 14rpx;
  border: 2rpx solid #e7eeff;
  border-radius: 16rpx;
  background: #ffffff;
  transition: all 0.2s ease;
}
.client-select-item:active {
  background: #f0f4fc;
}
.client-select-item.active {
  border-color: #1a365d;
  background: #eef3fc;
}
.client-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.client-name {
  color: #002045;
  font-size: 30rpx;
  font-weight: 600;
}
.client-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.client-tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #e7eeff;
  color: #1a365d;
  font-size: 22rpx;
}
.client-tag.source-tag {
  background: #f0f3f6;
  color: #596675;
}
.client-select-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 50rpx 20rpx;
  text-align: center;
}
.empty-text {
  margin-top: 18rpx;
  color: #002045;
  font-size: 30rpx;
  font-weight: 600;
}
.empty-tip {
  margin-top: 8rpx;
  margin-bottom: 28rpx;
  color: #74777f;
  font-size: 24rpx;
}
.empty-add-btn {
  min-width: 280rpx;
  height: 80rpx !important;
  border-radius: 16rpx !important;
  border-color: #1a365d !important;
  color: #1a365d !important;
  font-size: 26rpx !important;
  font-weight: 600;
}
.popup-bottom-action {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f3ff;
}
.popup-new-btn {
  height: 82rpx !important;
  border-radius: 14rpx !important;
  background: #e7eeff !important;
  color: #1a365d !important;
  font-size: 26rpx !important;
  font-weight: 600;
}
.client-popup-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 80rpx 0;
  color: #74777f;
  font-size: 26rpx;
}

.picker-confirm { color: #1a365d !important; font-weight: 600; }
.new-client-popup { overflow: hidden; border-radius: 28rpx 28rpx 0 0; background: #f9f9ff; }
.new-client-dialog { padding: 32rpx 34rpx calc(34rpx + env(safe-area-inset-bottom)); }
.nested-popup-mask {
  position: fixed;
  z-index: 1;
  inset: 0;
  pointer-events: none;
  background: rgba(0, 0, 0, 0.38);
}
.new-client-title { display: flex; align-items: center; justify-content: space-between; color: #002045; font-size: 36rpx; font-weight: 700; }
.popup-field-label { margin: 28rpx 0 14rpx; color: #242c3a; font-size: 26rpx; }
.popup-input-shell { min-height: 84rpx; background: #f0f3ff; }
.popup-input-shell .form-input { min-height: 80rpx; line-height: 80rpx; }
.add-client-button { height: 88rpx !important; margin-top: 32rpx; border-radius: 16rpx !important; background: #1a365d !important; color: #fff; font-size: 28rpx !important; font-weight: 600; }

/* 分步表单底部操作区 */
.wizard-footer {
  position: relative;
  z-index: 8;
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: calc(142rpx + env(safe-area-inset-bottom));
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  border-top: 2rpx solid #f0f3ff;
  background: rgba(249, 249, 255, 0.98);
}
.footer-text-button {
  width: 170rpx;
  height: 92rpx !important;
  margin: 0 !important;
  border: 2rpx solid #c8cdd6 !important;
  border-radius: 18rpx !important;
  background: #ffffff !important;
  color: #303846 !important;
  font-size: 24rpx !important;
}
.disabled-button {
  border-color: #e1e4e9 !important;
  background: #f1f2f4 !important;
  color: #a1a6ad !important;
}
.next-button {
  width: 200rpx;
  height: 92rpx !important;
  margin: 0;
  border-radius: 20rpx !important;
  background: #1a365d !important;
  color: #fff;
  font-size: 28rpx !important;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(26, 54, 93, 0.16);
}
