page {
  background: #f8fafd;
  color: #121c2c;
}

.change-pwd-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: #f8fafd;
}

/* 顶部导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #eef2f8;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
}

.nav-back:active {
  background: #f1f5f9;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #002045;
}

.nav-placeholder {
  width: 68rpx;
}

/* 主内容区域 */
.content {
  padding: 30rpx 28rpx;
}

/* 用户信息卡片 */
.user-info-card {
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #e2e8f2;
  box-shadow: 0 8rpx 24rpx rgba(0, 32, 69, 0.04);
}

.user-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 90rpx;
  border-radius: 24rpx;
  background: #eef4fe;
  border: 2rpx solid #d2e1fa;
  box-shadow: 0 6rpx 16rpx rgba(0, 32, 69, 0.08);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
}

.user-meta {
  flex: 1;
}

.user-name-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.username-txt {
  font-size: 32rpx;
  font-weight: 700;
  color: #002045;
}

.role-tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: #e6f4ea;
  color: #137333;
}

.user-emp {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #64748b;
  font-family: monospace;
}

.divider {
  height: 2rpx;
  background: #edf2f7;
  margin: 24rpx 0;
}

.email-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
}

.email-label {
  color: #64748b;
}

.email-value {
  color: #002045;
  font-weight: 600;
}

.change-email-btn {
  margin-left: auto;
  color: #1a365d;
  font-size: 24rpx;
  font-weight: 600;
  text-decoration: underline;
  padding: 6rpx 14rpx;
}

.bind-guide-notice {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f0f4fd;
  border: 2rpx solid #d2e1fa;
}

.guide-notice-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #002045;
}

/* 表单卡片 */
.form-card {
  margin-top: 28rpx;
  padding: 36rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #e2e8f2;
  box-shadow: 0 8rpx 24rpx rgba(0, 32, 69, 0.04);
}

.step-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 28rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed #e2e8f0;
}

.step-badge {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #eef4fe;
  color: #1a365d;
  font-size: 22rpx;
  font-weight: 700;
}

.step-badge.active-badge {
  background: #dcfce7;
  color: #15803d;
}

.step-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #002045;
}

.switch-back-row {
  margin-top: 28rpx;
  text-align: center;
}

.switch-back-text {
  color: #1a365d;
  font-size: 24rpx;
  font-weight: 600;
}

.field-label {
  margin: 30rpx 0 14rpx;
  color: #242c3a;
  font-size: 27rpx;
  font-weight: 600;
}

.field-label:first-child {
  margin-top: 0;
}

.field-label.required::after {
  margin-left: 6rpx;
  color: #ba1a1a;
  content: "*";
}

.input-shell {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  border: 2rpx solid #c4c6cf;
  border-radius: 16rpx;
  background: #f0f3ff;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.input-shell:focus-within {
  border-color: #1a365d;
  box-shadow: 0 0 0 2rpx rgba(26, 54, 93, 0.1);
}

.form-input {
  min-height: 88rpx;
  padding: 0 24rpx;
  background: transparent !important;
  color: #121c2c;
  font-size: 28rpx;
  line-height: 88rpx;
}

/* 验证码行排版 */
.code-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-shell {
  flex: 1;
}

.send-code-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #1a365d;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  box-sizing: border-box;
  transition: opacity 0.15s ease;
}

.send-code-btn:active {
  opacity: 0.8;
}

.send-code-btn.btn-disabled {
  background: #cbd5e1;
  color: #64748b;
  pointer-events: none;
}

/* 安全说明 */
.pwd-security-tips {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 30rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.tip-dot {
  color: #64748b;
  font-size: 28rpx;
  line-height: 36rpx;
}

.tip-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 36rpx;
  color: #64748b;
}

/* 底部操作栏 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(10rpx);
  border-top: 2rpx solid #eef2f8;
}

.submit-btn {
  width: 100% !important;
  height: 94rpx !important;
  border-radius: 20rpx !important;
  background: #002045 !important;
  border: 2rpx solid #002045 !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  color: #ffffff !important;
  box-shadow: 0 6rpx 16rpx rgba(0, 32, 69, 0.16);
}
