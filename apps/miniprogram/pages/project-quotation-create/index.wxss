page { background: #f9f9ff; }
.create-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); background: #f9f9ff; color: #121c2c; }
.create-nav { position: fixed; top: 0; right: 0; left: 0; z-index: 20; box-sizing: border-box; border-bottom: 2rpx solid #edf0f5; background: rgba(249,249,255,.98); }
.nav-placeholder { width: 100%; }
.nav-back { position: absolute; bottom: 0; left: 26rpx; display: flex; width: 72rpx; height: 88rpx; align-items: center; }
.nav-title { position: absolute; bottom: 0; left: 100rpx; width: 210rpx; height: 88rpx; color: #002045; font-size: 36rpx; font-weight: 700; line-height: 88rpx; text-align: left; }
.form-content { padding: 28rpx 24rpx 20rpx; }
.form-card { margin-bottom: 28rpx; padding: 34rpx 32rpx; border: 2rpx solid rgba(231,238,255,.9); border-radius: 24rpx; background: #ffffff; box-shadow: 0 10rpx 28rpx rgba(26,54,93,.055); }
.section-heading { display: flex; align-items: center; justify-content: space-between; }
.section-title { display: flex; align-items: center; gap: 16rpx; color: #002045; font-size: 31rpx; font-weight: 700; line-height: 44rpx; }
.title-line { width: 6rpx; height: 42rpx; border-radius: 999rpx; background: #455f88; }
.field-label { margin: 30rpx 8rpx 12rpx; color: #5b5f61; font-size: 23rpx; line-height: 34rpx; }
.input-shell { min-height: 86rpx; overflow: hidden; border: 2rpx solid rgba(196,198,207,.65); border-radius: 14rpx; background: #f0f3ff; }
.form-input { min-height: 86rpx !important; padding: 0 24rpx !important; background: transparent !important; color: #121c2c !important; font-size: 27rpx !important; }
.select-shell { position: relative; }
.total-shell { border-color: rgba(69,95,136,.38); background: #e7eeff; }
.readonly-shell { border-color: rgba(196,198,207,.5); background: #edf2ff; }
.readonly-input { color: #303d52 !important; font-weight: 700 !important; }
.total-input { color: #002045 !important; font-family: monospace; font-weight: 700 !important; }
.field-tip { margin: 10rpx 8rpx 0; color: #9299a6; font-size: 19rpx; line-height: 30rpx; }
.batch-import { display: flex; padding: 12rpx 10rpx; align-items: center; gap: 8rpx; color: #455f88; font-size: 22rpx; font-weight: 700; }
.item-card { position: relative; margin-top: 24rpx; padding: 28rpx 22rpx 24rpx; border: 2rpx solid rgba(196,198,207,.32); border-radius: 20rpx; background: #f0f3ff; }
.item-delete { position: absolute; top: 18rpx; right: 18rpx; z-index: 2; display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; }
.item-label { margin-bottom: 10rpx; color: #5b5f61; font-size: 21rpx; line-height: 30rpx; }
.item-label-row { display:flex; margin-right:48rpx; align-items:center; justify-content:space-between; gap:16rpx; }
.item-label-row .item-label { margin-bottom:10rpx; }
.category-select-link { display:flex; margin-bottom:10rpx; align-items:center; gap:2rpx; color:#315b8f; font-size:20rpx; font-weight:600; line-height:30rpx; }
.name-input-shell { margin-right: 48rpx; }
.item-input-shell { min-width: 0; min-height: 78rpx; overflow: hidden; border: 2rpx solid rgba(196,198,207,.32); border-radius: 12rpx; background: #ffffff; }
.item-input { min-height: 78rpx !important; padding: 0 18rpx !important; background: transparent !important; color: #121c2c !important; font-size: 24rpx !important; }
.mono-input { font-family: monospace; }
.item-columns { display: grid; margin-top: 22rpx; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16rpx; }
.item-column { min-width: 0; }
.item-total { display: flex; margin-top: 24rpx; padding-top: 20rpx; align-items: center; justify-content: space-between; border-top: 2rpx solid rgba(196,198,207,.28); color: #5b5f61; font-size: 22rpx; }
.item-total-value { color: #002045; font-family: monospace; font-size: 29rpx; font-weight: 700; }
.remark-label { margin-top: 22rpx; }
.add-item-button { height: 86rpx !important; margin-top: 28rpx !important; border: none !important; border-radius: 16rpx !important; background: #dee8ff !important; color: #274c7c !important; font-size: 25rpx !important; font-weight: 700 !important; }
.drawing-grid { display: grid; margin-top: 28rpx; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20rpx; }
.drawing-item,.drawing-upload { position: relative; min-width: 0; height: 250rpx; overflow: hidden; box-sizing: border-box; border-radius: 18rpx; }
.drawing-item { border: 2rpx solid rgba(196,198,207,.55); background: #edf2ff; }
.drawing-image { width: 100%; height: 100%; }
.pdf-preview { display: flex; width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; color: #ba1a1a; font-size: 24rpx; font-weight: 700; }
.drawing-delete { position: absolute; top: 12rpx; right: 12rpx; display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; border-radius: 50%; background: #ba1a1a; box-shadow: 0 5rpx 12rpx rgba(186,26,26,.26); }
.drawing-name { position: absolute; right: 0; bottom: 0; left: 0; overflow: hidden; padding: 10rpx 14rpx; background: rgba(0,20,45,.68); color: #ffffff; font-size: 19rpx; line-height: 28rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.drawing-upload { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 3rpx dashed #aeb7c5; background: #ffffff; }
.upload-title { margin-top: 14rpx; color: #44474e; font-size: 23rpx; }
.upload-tip { margin-top: 8rpx; color: #9aa1ac; font-size: 18rpx; }
.submit-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 15; display: grid; padding: 24rpx 38rpx calc(24rpx + env(safe-area-inset-bottom)); grid-template-columns: repeat(2,minmax(0,1fr)); gap: 28rpx; border-top: 2rpx solid rgba(217,227,249,.8); border-radius: 28rpx 28rpx 0 0; background: rgba(255,255,255,.98); box-shadow: 0 -10rpx 30rpx rgba(26,54,93,.08); }
.footer-button-host { display: block; min-width: 0; width: 100%; height: 88rpx; }
.cancel-button,.submit-button { width: 100% !important; min-width: 0 !important; height: 88rpx !important; margin: 0 !important; padding: 0 22rpx !important; border-radius: 999rpx !important; font-size: 27rpx !important; font-weight: 700 !important; }
.cancel-button { border: 2rpx solid #c4c6cf !important; background: #ffffff !important; color: #5b5f61 !important; box-shadow: none !important; }
.submit-button { border: none !important; background: linear-gradient(135deg, #36AD97, #2A9A87) !important; color: #ffffff !important; box-shadow: 0 10rpx 22rpx rgba(42,154,135,.28) !important; }
.submit-loading-mask { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(15,25,39,.38); backdrop-filter: blur(5rpx); }
.submit-loading-card { display: flex; width: 390rpx; min-height: 240rpx; padding: 34rpx 30rpx; box-sizing: border-box; flex-direction: column; align-items: center; justify-content: center; border: 2rpx solid rgba(255,255,255,.85); border-radius: 28rpx; background: rgba(255,255,255,.97); box-shadow: 0 24rpx 60rpx rgba(0,32,69,.2); }
.submit-loading-title { margin-top: 24rpx; color: #002045; font-size: 29rpx; font-weight: 700; text-align: center; }
.submit-loading-tip { margin-top: 12rpx; color: #7b8493; font-size: 21rpx; line-height: 32rpx; text-align: center; }
.picker-confirm { color: #2E9F8B !important; font-weight: 700; }
.file-source-popup { overflow: hidden !important; border-radius: 30rpx 30rpx 0 0 !important; background: #f9f9ff !important; }
.file-source-panel { padding: 36rpx 30rpx calc(32rpx + env(safe-area-inset-bottom)); }
.file-source-head { display: flex; padding: 0 8rpx 26rpx; align-items: flex-start; justify-content: space-between; }
.file-source-title { color: #002045; font-size: 32rpx; font-weight: 700; }
.file-source-tip { margin-top: 8rpx; color: #8a92a0; font-size: 21rpx; }
.file-source-option { display: flex; min-height: 116rpx; margin-top: 16rpx; padding: 18rpx 22rpx; align-items: center; gap: 20rpx; border: 2rpx solid #e2e8f5; border-radius: 20rpx; background: #ffffff; }
.source-icon { display: flex; width: 72rpx; height: 72rpx; flex: none; align-items: center; justify-content: center; border-radius: 18rpx; }
.image-source { background: #e5efff; }
.pdf-source { background: #fff0ef; }
.source-copy { min-width: 0; flex: 1; color: #121c2c; font-size: 26rpx; font-weight: 700; }
.source-copy text { display: block; margin-top: 6rpx; color: #8a92a0; font-size: 20rpx; font-weight: 400; }
.category-picker-popup { overflow:hidden !important; border-radius:30rpx 30rpx 0 0 !important; background:#f9f9ff !important; }
.category-picker-panel { padding:34rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); }
.category-picker-head { display:flex; padding:0 8rpx 22rpx; align-items:flex-start; justify-content:space-between; gap:20rpx; }
.category-picker-title { color:#002045; font-size:32rpx; font-weight:700; }
.category-picker-tip { margin-top:8rpx; color:#7f8896; font-size:20rpx; line-height:30rpx; }
.category-picker-list { max-height:610rpx; }
.category-option { display:flex; min-height:104rpx; margin-bottom:16rpx; padding:18rpx 20rpx; box-sizing:border-box; align-items:center; gap:16rpx; border:2rpx solid #dce5f3; border-radius:18rpx; background:#fff; box-shadow:0 9rpx 22rpx rgba(37,74,122,.08); }
.category-option-index { display:flex; width:48rpx; height:58rpx; flex:none; align-items:center; justify-content:center; border-radius:13rpx; background:#e8effc; color:#285692; font-size:21rpx; font-weight:700; }
.category-option-main { min-width:0; flex:1; }
.category-option-name { overflow:hidden; color:#172238; font-size:26rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.category-option-code { margin-top:5rpx; overflow:hidden; color:#9299a6; font-size:18rpx; text-overflow:ellipsis; white-space:nowrap; }
.category-option-unit { flex:none; padding:7rpx 14rpx; border-radius:999rpx; background:#e7f5ee; color:#176c4b; font-size:20rpx; font-weight:650; }
.category-picker-note { padding:14rpx 8rpx 0; color:#9098a5; font-size:20rpx; line-height:30rpx; text-align:center; }
