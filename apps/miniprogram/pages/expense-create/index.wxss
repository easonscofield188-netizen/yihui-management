.create-page { min-height: 100vh; background: #f8fafc; box-sizing: border-box; padding-bottom: 170rpx; }
.page-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: #ffffff; border-bottom: 1rpx solid #eef2f6; }
.nav-back { position: absolute; left: 24rpx; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 50%; }
.nav-title { font-size: 32rpx; font-weight: 700; color: #182220; }
.nav-placeholder { width: 100%; }

.form-container { padding: 20rpx 28rpx 28rpx; display: flex; flex-direction: column; gap: 18rpx; }

/* 支出类型切换 */
.type-selector { display: flex; background: #edf2f7; border: 1rpx solid #dce5ef; border-radius: 22rpx; padding: 6rpx; gap: 8rpx; }
.type-tab { flex: 1; display: flex; align-items: center; justify-content: center; gap: 10rpx; height: 78rpx; border: 1rpx solid transparent; border-radius: 17rpx; font-size: 27rpx; font-weight: 650; color: #64748b; transition: all .2s ease; }
.type-tab.active { border-color: #2E9F8B; background: linear-gradient(135deg, #36AD97, #2A9A87); color: #ffffff; box-shadow: 0 6rpx 14rpx rgba(42, 154, 135, .24); font-weight: 700; }
.type-tab.disabled { opacity: .45; }

.mode-tip { display: flex; align-items: center; gap: 12rpx; background: #f0f9ff; border: 1rpx solid #bae6fd; border-radius: 16rpx; padding: 16rpx 20rpx; font-size: 24rpx; color: #0369a1; line-height: 1.4; }

/* 金额卡片 */
.amount-card { background: linear-gradient(135deg, #ffffff 0%, #f4f8fd 100%); border: 1rpx solid #e6edf5; border-radius: 24rpx; padding: 26rpx 28rpx; box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.035); }
.amount-label { font-size: 25rpx; font-weight: 600; color: #64748b; margin-bottom: 14rpx; }
.required-star { color: #ba1a1a; margin-left: 6rpx; font-weight: 700; }
.amount-input-wrap { display: flex; align-items: center; gap: 12rpx; border-bottom: 2rpx solid #dce7f2; padding-bottom: 12rpx; }
.currency-symbol { font-size: 48rpx; font-weight: 700; color: #182220; }
.amount-input { flex: 1; font-size: 54rpx; font-weight: 700; color: #182220; height: 68rpx; }
.amount-placeholder { font-size: 48rpx; font-weight: 400; color: #cbd5e1; }

/* 快速记账：类目和最近模板 */
.quick-category-section, .recent-section { padding: 4rpx 0; }
.compact-section-heading { display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx 10rpx; color: #334155; font-size: 24rpx; font-weight: 700; }
.more-category { display: flex; align-items: center; color: #64748b; font-size: 22rpx; font-weight: 500; }
.heading-hint { color: #94a3b8; font-size: 20rpx; font-weight: 400; }
.quick-category-scroll, .recent-template-scroll { width: 100%; white-space: nowrap; }
.quick-category-list, .recent-template-list { display: inline-flex; gap: 12rpx; padding: 0 2rpx; }
.quick-category-chip { display: inline-flex; height: 60rpx; padding: 0 22rpx; align-items: center; justify-content: center; border: 1rpx solid #dbe5ef; border-radius: 30rpx; background: #ffffff; color: #526274; font-size: 24rpx; font-weight: 600; box-sizing: border-box; }
.quick-category-chip.selected { border-color: #2E9F8B; background: #E8F6F4; color: #2E9F8B; }
.recent-template { display: flex; width: 176rpx; min-height: 108rpx; padding: 16rpx 18rpx; box-sizing: border-box; flex-direction: column; justify-content: center; border: 1rpx solid #e3eaf2; border-radius: 16rpx; background: #ffffff; }
.recent-template-category { overflow: hidden; color: #334155; font-size: 23rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.recent-template-amount { margin-top: 5rpx; color: #2E9F8B; font-size: 27rpx; font-weight: 800; }
.recent-template-remark { overflow: hidden; margin-top: 4rpx; color: #94a3b8; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }

/* 表单主体 */
.form-section { background: #ffffff; border: 1rpx solid #edf1f5; border-radius: 22rpx; padding: 4rpx 24rpx; box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.025); display: flex; flex-direction: column; }
.form-cell { display: flex; flex-direction: row; align-items: center; justify-content: space-between; min-height: 88rpx; border-bottom: 1rpx solid #f1f5f9; box-sizing: border-box; padding: 8rpx 0; }
.form-cell:last-child { border-bottom: none; }
.cell-label { font-size: 26rpx; font-weight: 600; color: #1e293b; display: flex; flex-direction: row; align-items: center; width: 180rpx; flex-shrink: 0; line-height: 1; }
.cell-value-wrap { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 8rpx; min-width: 0; height: 100%; }
.cell-value { font-size: 26rpx; color: #0f172a; font-weight: 500; line-height: 1.4; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; }
.cell-value.placeholder { color: #94a3b8; font-weight: 400; }

.remark-cell { align-items: center; }
.cell-input { flex: 1; font-size: 25rpx; color: #0f172a; text-align: right; height: 70rpx; line-height: 70rpx; }
.input-placeholder { color: #94a3b8; }

/* 固定分摊汇总小卡片 */
.recurring-summary { background: #f8fafc; border-radius: 18rpx; padding: 20rpx 24rpx; margin: 16rpx 0 20rpx; display: flex; justify-content: space-around; border: 1rpx solid #e2e8f0; }
.summary-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.summary-label { font-size: 22rpx; color: #64748b; }
.summary-val { font-size: 28rpx; font-weight: 700; color: #0f172a; }
.summary-val.total { color: #b45309; font-size: 32rpx; }

/* 提交按钮 */
.submit-btn-wrap { display: flex; margin: 2rpx 0 4rpx; justify-content: center; }
.submit-btn { display: flex; width: 244rpx; height: 64rpx; align-items: center; justify-content: center; gap: 5rpx; border: 1rpx solid #2E9F8B; border-radius: 32rpx; background: #E8F6F4; color: #2E9F8B; font-size: 24rpx; font-weight: 700; box-shadow: none; white-space: nowrap; }
.submit-btn:active { opacity: 0.9; transform: scale(0.99); }
.submit-btn[disabled] { background: #94a3b8; opacity: 0.7; }

/* 待提交多笔支出清单 */
.queued-section { background: #ffffff; border: 1rpx solid #dbe7f5; border-radius: 24rpx; padding: 20rpx 24rpx; box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, .035); }
.queued-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid #edf2f7; }
.queued-title { color: #182220; font-size: 29rpx; font-weight: 700; }
.queued-tip { margin-top: 6rpx; color: #7b8798; font-size: 21rpx; }
.queued-total { flex: none; color: #b45309; font-size: 31rpx; font-weight: 800; }
.queued-item { display: flex; min-height: 92rpx; align-items: center; justify-content: space-between; gap: 14rpx; border-bottom: 1rpx solid #f1f5f9; }
.queued-item-main { min-width: 0; flex: 1; }
.queued-item-top { display: flex; align-items: center; gap: 10rpx; }
.queued-category { overflow: hidden; color: #172238; font-size: 26rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.queued-type { flex: none; padding: 3rpx 9rpx; border-radius: 8rpx; background: #eef5ff; color: #2563eb; font-size: 19rpx; }
.queued-type.recurring-rule { background: #effaf5; color: #18835b; }
.queued-meta { overflow: hidden; margin-top: 5rpx; color: #8390a1; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.queued-item-side { display: flex; flex: none; align-items: center; gap: 10rpx; }
.queued-amount { color: #182220; font-size: 26rpx; font-weight: 750; }
.queued-remove { display: flex; padding: 8rpx; align-items: center; justify-content: center; }
.fixed-submit-bar { position: fixed; z-index: 120; right: 0; bottom: 0; left: 0; display: flex; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); align-items: center; gap: 20rpx; border-top: 1rpx solid #e6edf5; background: rgba(255, 255, 255, .98); box-shadow: 0 -8rpx 22rpx rgba(15, 23, 42, .08); }
.fixed-submit-summary { min-width: 0; flex: 1; overflow: hidden; color: #526274; font-size: 23rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.submit-all-btn { display: flex; width: 260rpx; height: 78rpx; flex: none; align-items: center; justify-content: center; gap: 10rpx; border: 0; border-radius: 39rpx; background: linear-gradient(135deg, #36AD97, #2A9A87); color: #ffffff; font-size: 27rpx; font-weight: 700; box-shadow: 0 8rpx 20rpx rgba(42, 154, 135, .28); }
.submit-all-btn[disabled] { background: #94a3b8; }
