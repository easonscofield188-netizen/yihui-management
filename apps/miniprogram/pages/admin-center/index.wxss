page { background: #f7f9fd; }
.admin-page { min-height: 100vh; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); background: #f7f9fd; color: #152038; }
.page-nav { position: fixed; top: 0; right: 0; left: 0; z-index: 20; box-sizing: border-box; border-bottom: 2rpx solid #edf0f5; background: rgba(249,249,255,.97); }
.nav-placeholder { width: 100%; }
.nav-back { position: absolute; bottom: 0; left: 28rpx; display: flex; width: 74rpx; height: 88rpx; align-items: center; }
.nav-title { position: absolute; right: 150rpx; bottom: 0; left: 150rpx; height: 88rpx; color: #182220; font-size: 38rpx; font-weight: 700; line-height: 88rpx; text-align: center; }
.admin-hero { position: relative; display: flex; margin: 28rpx 32rpx 0; overflow: hidden; padding: 30rpx; align-items: center; gap: 22rpx; border-radius: 25rpx; background: linear-gradient(135deg,#36AD97,#2A9A87); color: #fff; box-shadow: 0 16rpx 34rpx rgba(42,154,135,.25); }
.hero-orbit { position: absolute; border: 2rpx solid rgba(255,255,255,.13); border-radius: 50%; }.hero-orbit.one { right: -40rpx; width: 180rpx; height: 180rpx; }.hero-orbit.two { top: -80rpx; right: 100rpx; width: 140rpx; height: 140rpx; }
.hero-icon { display: flex; width: 82rpx; height: 82rpx; flex: none; align-items: center; justify-content: center; border-radius: 22rpx; background: rgba(255,255,255,.14); }
.hero-main { position: relative; z-index: 1; }.hero-title { font-size: 31rpx; font-weight: 700; }.hero-description { margin-top: 7rpx; color: rgba(255,255,255,.74); font-size: 22rpx; }
.search-box { display: flex; height: 84rpx; margin: 26rpx 32rpx 8rpx; padding: 0 24rpx; align-items: center; gap: 14rpx; border: 2rpx solid #e0e7f2; border-radius: 18rpx; background: #fff; box-shadow: 0 7rpx 20rpx rgba(30,61,104,.05); }
.search-input { min-width: 0; height: 84rpx; flex: 1; font-size: 27rpx; }
.section { padding: 30rpx 32rpx 0; }.section-head { display: flex; padding: 0 4rpx 18rpx; align-items: flex-end; justify-content: space-between; }.section-head>text { color: #8a919d; font-size: 21rpx; }.section-title { font-size: 29rpx; font-weight: 700; }.section-description { margin-top: 5rpx; color: #818997; font-size: 21rpx; }
.menu-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20rpx; }.menu-card { position: relative; overflow: hidden; min-height: 236rpx; padding: 24rpx; border: 2rpx solid #e3e8f1; border-radius: 22rpx; background: #fff; box-shadow: 0 10rpx 25rpx rgba(30,61,104,.07); }.menu-card:active { transform: translateY(2rpx); }
.menu-icon { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border-radius: 18rpx; }.tone-blue .menu-icon { background: linear-gradient(145deg,#4779c2,#285692); }.tone-violet .menu-icon { background: linear-gradient(145deg,#7a68c4,#54439a); }.tone-orange .menu-icon { background: linear-gradient(145deg,#d68145,#a95827); }.tone-green .menu-icon { background: linear-gradient(145deg,#40a17e,#217359); }.tone-cyan .menu-icon { background: linear-gradient(145deg,#3697a4,#1d6974); }
.menu-badge { position: absolute; top: 19rpx; right: 20rpx; min-width: 34rpx; height: 34rpx; padding: 0 8rpx; border-radius: 999rpx; background: #c62828; color: #fff; font-size: 19rpx; font-weight: 700; line-height: 34rpx; text-align: center; }.menu-name { margin-top: 19rpx; font-size: 28rpx; font-weight: 700; }.menu-description { min-height: 58rpx; margin-top: 7rpx; color: #7a8391; font-size: 21rpx; line-height: 29rpx; }.menu-enter { display: flex; margin-top: 8rpx; align-items: center; justify-content: flex-end; color: #64748b; font-size: 21rpx; }
.empty-state { display: flex; min-height: 420rpx; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; color: #808895; font-size: 25rpx; }
