page {
  background: #f9f9ff;
}
.account-page {
  --td-brand-color: #2E9F8B;
  --td-picker-confirm-color: #2E9F8B;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: #f9f9ff;
  color: #121c2c;
}
.navbar-wrap {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #f9f9ff;
}
.account-navbar {
  border-bottom: 2rpx solid #dceee9;
  background: #ffffff !important;
  color: #182220 !important;
}
.nav-back {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: flex-start;
  color: #2A9A87;
  font-size: 58rpx;
  line-height: 1;
}
.form-content {
  box-sizing: border-box;
  width: 100%;
  padding: 38rpx 30rpx 46rpx;
}
.intro {
  color: #5f6672;
  font-size: 26rpx;
  line-height: 42rpx;
}
.intro-title {
  margin-bottom: 10rpx;
  color: #182220;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 56rpx;
}
.form-card {
  margin-top: 34rpx;
  padding: 32rpx;
  border: 2rpx solid #cbe9e1;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(46, 159, 139, 0.08);
}
.default-pwd-tip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 30rpx 0 10rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #e8f6f4;
  border: 2rpx solid #c4e8de;
  box-sizing: border-box;
}
.default-pwd-content {
  flex: 1;
}
.default-pwd-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #187a68;
  margin-bottom: 6rpx;
}
.default-pwd-desc {
  font-size: 23rpx;
  line-height: 34rpx;
  color: #4a5568;
}
.pwd-highlight {
  font-family: monospace;
  font-weight: 700;
  color: #187a68;
  background: #dff3ed;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.field-label {
  margin: 30rpx 0 14rpx;
  color: #242c3a;
  font-size: 27rpx;
  font-weight: 600;
}
.field-label:first-child {
  margin-top: 0;
}
.field-label.required::after {
  margin-left: 6rpx;
  color: #ba1a1a;
  content: "*";
}
.input-shell {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  overflow: hidden;
  border: 2rpx solid #d4e4df;
  border-radius: 16rpx;
  background: #ffffff;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.input-shell:focus-within {
  border-color: #2e9f8b;
  box-shadow: 0 0 0 4rpx rgba(46, 159, 139, 0.12);
}
.form-input {
  min-height: 88rpx;
  padding: 0 24rpx;
  background: transparent !important;
  color: #121c2c;
  font-size: 28rpx;
  line-height: 88rpx;
}
.select-shell {
  display: flex;
  align-items: center;
}
.select-chevron {
  width: 16rpx;
  height: 16rpx;
  margin-right: 6rpx;
  border-right: 4rpx solid #5f6672;
  border-bottom: 4rpx solid #5f6672;
  transform: rotate(45deg) translateY(-3rpx);
}
.readonly-shell {
  border-color: #cbe9e1;
  background: #eff8f5;
}
.field-help {
  margin-top: 10rpx;
  color: #74777f;
  font-size: 22rpx;
  line-height: 32rpx;
}
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 40;
  display: flex;
  height: calc(140rpx + env(safe-area-inset-bottom));
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  align-items: flex-start;
  gap: 32rpx;
  border-top: 2rpx solid #dceee9;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(10rpx);
}
.cancel-action,
.submit-action {
  min-width: 0;
  flex: 1;
}
.cancel-button,
.submit-button {
  width: 100% !important;
  height: 92rpx !important;
  margin: 0 !important;
  border-radius: 18rpx !important;
  font-size: 28rpx !important;
  font-weight: 700;
}
.cancel-button {
  border: 2rpx solid #8d95a3 !important;
  background: #fff !important;
  color: #303846 !important;
  box-shadow: 0 3rpx 8rpx rgba(18, 28, 44, 0.06);
}
.submit-button {
  border: 2rpx solid #2A9A87 !important;
  background: linear-gradient(135deg, #36AD97, #2A9A87) !important;
  color: #fff !important;
  box-shadow: 0 8rpx 18rpx rgba(42, 154, 135, 0.22);
}
.picker-confirm {
  color: #2E9F8B !important;
  font-weight: 700;
}
