page {
  background: #f7f9fd;
}
.manage-page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部导航 */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #f7f9fd;
  border-bottom: 2rpx solid #e2e8f5;
  box-sizing: border-box;
}

.back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
}

.title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  pointer-events: none;
  font-size: 34rpx;
  font-weight: 700;
  color: #002045;
  letter-spacing: -0.5rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 28rpx 12rpx;
}

.search-shell {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 2rpx solid #d9e2ef;
  border-radius: 20rpx;
  gap: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 32, 69, 0.04);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #121c2c;
}

/* 状态 Tab 栏 */
.filter-header {
  padding: 10rpx 28rpx 16rpx;
}

.tabs {
  display: flex;
  gap: 16rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 2rpx solid #dbe3f1;
  color: #556274;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.tab.active {
  background: #002045;
  border-color: #002045;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(0, 32, 69, 0.18);
}

.tab-count {
  margin-left: 6rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

/* 权限提示栏 */
.permission-notice {
  margin: 0 28rpx 20rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 14rpx;
  background: #e9f0fa;
  border: 1rpx solid #cfddf1;
  color: #1a365d;
  font-size: 22rpx;
  line-height: 32rpx;
}

/* 加载与空状态 */
.loading-state,
.empty-state {
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #747d8c;
  font-size: 26rpx;
}

.empty-title {
  color: #1a273a;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  color: #8b95a5;
  font-size: 24rpx;
}

/* 账号列表 */
.account-list {
  padding: 0 28rpx 190rpx;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.bottom-create-bar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: center;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e7edf5;
}

.bottom-create-button {
  min-width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #002f63;
  font-size: 22rpx;
  font-weight: 600;
}

.bottom-create-button:active {
  opacity: .76;
}

.bottom-create-icon {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #002f63;
  border: 4rpx solid #ffffff;
  box-shadow: 0 5rpx 14rpx rgba(0, 47, 99, .22);
}

.create-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, .48);
  opacity: 0;
  transition: opacity .24s ease;
}

.create-mask.is-visible { opacity: 1; }

.create-sheet {
  width: 100%;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform .28s cubic-bezier(.2, .8, .2, 1);
}

.create-mask.is-visible .create-sheet { transform: translateY(0); }

.create-sheet-handle { width: 64rpx; height: 8rpx; margin: 16rpx auto 4rpx; border-radius: 99rpx; background: #d9e2ee; }
.create-sheet-header { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 28rpx 20rpx; border-bottom: 1rpx solid #edf1f6; }
.create-sheet-title { font-size: 32rpx; color: #002045; font-weight: 700; }
.create-sheet-desc { margin-top: 5rpx; font-size: 22rpx; color: #8090a4; }
.create-sheet-close { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f3f6fa; }
.create-sheet-content { max-height: 880rpx; padding: 8rpx 28rpx 20rpx; box-sizing: border-box; }
.create-field { margin-top: 20rpx; }
.create-field-label { display: block; margin-bottom: 10rpx; color: #334155; font-size: 25rpx; font-weight: 600; }
.create-required { color: #e11d48; }
.create-input, .create-select, .create-readonly { width: 100%; min-height: 76rpx; padding: 0 20rpx; border: 1rpx solid #dbe4ee; border-radius: 14rpx; box-sizing: border-box; background: #ffffff; color: #12233a; font-size: 26rpx; }
.create-input { line-height: 76rpx; }
.create-select { display: flex; align-items: center; justify-content: space-between; }
.create-readonly { display: flex; align-items: center; color: #64748b; background: #f7f9fc; }
.create-placeholder { color: #9aa9bb; }
.create-sheet-actions { display: flex; gap: 16rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #edf1f6; background: #ffffff; }
.create-cancel, .create-confirm { flex: 1; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; font-size: 27rpx; font-weight: 600; }
.create-cancel { color: #516277; background: #f2f5f8; }
.create-confirm { color: #ffffff; background: #002f63; }
.create-confirm:active, .create-cancel:active { opacity: .8; }


.account-card {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
  box-sizing: border-box;
}

/* 1. 主超级管理员账号专属：尊贵金琥珀 3D 立体质感 */
.account-card.card-root {
  background: linear-gradient(150deg, #ffffff 0%, #fffef8 40%, #fefcf0 100%);
  border: 2rpx solid #f6d895;
  box-shadow:
    0 18rpx 42rpx rgba(217, 119, 6, 0.13),
    0 4rpx 14rpx rgba(180, 83, 9, 0.08),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.95);
}

.account-card.card-root .card-header {
  border-bottom: 2rpx solid #fdf2d8;
  background: linear-gradient(180deg, rgba(254, 243, 199, 0.35) 0%, rgba(255, 255, 255, 0) 100%);
}

.account-card.card-root .card-actions {
  background: #fdfaf3;
  border-top: 2rpx solid #fdf2d8;
}

/* 2. 普通账号交替立体主题 A：科技深蓝立体阴影 */
.account-card.card-theme-blue {
  background: linear-gradient(150deg, #ffffff 0%, #fbfdff 45%, #f2f7fd 100%);
  border: 2rpx solid #dbe6f5;
  box-shadow:
    0 16rpx 36rpx rgba(0, 32, 69, 0.09),
    0 4rpx 12rpx rgba(0, 32, 69, 0.04),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

.account-card.card-theme-blue .card-header {
  border-bottom: 2rpx solid #edf3fc;
}

.account-card.card-theme-blue .card-actions {
  background: #f8fbfe;
  border-top: 2rpx solid #edf3fc;
}

/* 3. 普通账号交替立体主题 B：高雅紫罗兰立体阴影 */
.account-card.card-theme-purple {
  background: linear-gradient(150deg, #ffffff 0%, #fdfcff 45%, #f7f4fd 100%);
  border: 2rpx solid #e8e1f8;
  box-shadow:
    0 16rpx 36rpx rgba(109, 40, 217, 0.09),
    0 4rpx 12rpx rgba(109, 40, 217, 0.04),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

.account-card.card-theme-purple .card-header {
  border-bottom: 2rpx solid #f3edfa;
}

.account-card.card-theme-purple .card-actions {
  background: #faf8fe;
  border-top: 2rpx solid #f3edfa;
}

/* 4. 普通账号交替立体主题 C：清新松石翠绿立体阴影 */
.account-card.card-theme-teal {
  background: linear-gradient(150deg, #ffffff 0%, #fafffe 45%, #f0faf7 100%);
  border: 2rpx solid #d4ece5;
  box-shadow:
    0 16rpx 36rpx rgba(13, 148, 136, 0.09),
    0 4rpx 12rpx rgba(13, 148, 136, 0.04),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

.account-card.card-theme-teal .card-header {
  border-bottom: 2rpx solid #ebf7f3;
}

.account-card.card-theme-teal .card-actions {
  background: #f6fcf9;
  border-top: 2rpx solid #ebf7f3;
}

/* 5. 已停用账号：沉稳低对比立体样式 */
.account-card.card-disabled {
  background: #fbfbfd !important;
  border-color: #e5e9f0 !important;
  box-shadow: 0 6rpx 20rpx rgba(100, 116, 139, 0.06) !important;
  opacity: 0.85;
}

/* 卡片头部 */
.card-header {
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

/* 头像徽章容器与图片规范 */
.user-avatar-badge {
  position: relative;
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: #edf2fa;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 2rpx solid #dce5f2;
  box-shadow: 0 6rpx 16rpx rgba(0, 32, 69, 0.08);
}

.avatar-root {
  background: #fef3c7;
  border: 2rpx solid #f59e0b;
  box-shadow: 0 6rpx 18rpx rgba(245, 158, 11, 0.28);
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
}

.root-crown-indicator {
  position: absolute;
  top: -12rpx;
  right: -10rpx;
  font-size: 24rpx;
  filter: drop-shadow(0 2rpx 6rpx rgba(217, 119, 6, 0.35));
}

.user-main-info {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.nickname {
  font-size: 31rpx;
  font-weight: 700;
  color: #101c2d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.root-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  border: 1rpx solid #fde68a;
  color: #b45309;
  font-size: 21rpx;
  font-weight: 700;
  flex: none;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.15);
}

.status-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  flex: none;
}

.status-badge.status-active {
  background: #dcfce7;
  color: #15803d;
}

.status-badge.status-disabled {
  background: #fee2e2;
  color: #b91c1c;
}

.username-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #6e798c;
}

/* 卡片体 */
.card-body {
  padding: 20rpx 26rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
}

.info-label {
  color: #7b8699;
}

.info-value {
  color: #172435;
  font-weight: 500;
}

.mono-val {
  font-family: monospace;
  color: #002045;
  font-weight: 700;
}

.role-val {
  font-weight: 600;
  color: #1a365d;
}

.date-val {
  color: #64748b;
  font-size: 22rpx;
}

/* 底部快捷操作栏 */
.card-actions {
  padding: 16rpx 20rpx;
  border-top: 2rpx solid #f2f6fc;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  background: #fafcff;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.card-actions::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: opacity 0.15s ease;
}

.action-btn text {
  white-space: nowrap;
}

.action-btn:active {
  opacity: 0.75;
}

.action-reset {
  background: #eef4fe;
  border: 1rpx solid #d2e1fa;
  color: #1a365d;
}

.action-edit-job {
  background: #eef7fe;
  border: 1rpx solid #cbe4fa;
  color: #0b5796;
}

.action-disable {
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  color: #ba1a1a;
}

.action-enable {
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  color: #15803d;
}

.action-protected {
  background: #f1f3f7;
  border: 1rpx solid #e2e6ec;
  color: #8c95a3;
}

.action-delete {
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
  color: #cf1322;
}

.picker-confirm {
  color: #2E9F8B !important;
  font-weight: 700;
}
