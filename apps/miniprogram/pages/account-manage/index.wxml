<page-meta page-style="{{createPopupMounted ? 'overflow: hidden;' : ''}}" />
<view class="manage-page">
  <view class="nav" style="height:{{navHeight}}px;padding-top:{{statusBarHeight}}px">
    <view class="back" bindtap="back">
      <t-icon name="chevron-left" size="48rpx" color="#002045" />
    </view>
    <view class="title">账号管理</view>
  </view>
  <view style="height:{{navHeight}}px"></view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-shell">
      <t-icon name="search" size="34rpx" color="#7b8493" />
      <input
        class="search-input"
        placeholder="搜索账号名、昵称或工号"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="loadData"
      />
      <t-icon wx:if="{{keyword}}" name="close-circle" size="32rpx" color="#9aa1ac" bindtap="clearSearch" />
    </view>
  </view>

  <!-- 状态 Tab 栏与统计 -->
  <view class="filter-header">
    <view class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="value"
        data-index="{{index}}"
        bindtap="changeTab"
        class="tab {{tabIndex === index ? 'active' : ''}}"
      >
        {{item.label}}
        <text class="tab-count" wx:if="{{item.value === 'ALL'}}">({{totalCount}})</text>
        <text class="tab-count" wx:if="{{item.value === 'ACTIVE'}}">({{activeCount}})</text>
        <text class="tab-count" wx:if="{{item.value === 'DISABLED'}}">({{disabledCount}})</text>
      </view>
    </view>
  </view>

  <!-- 提示条 -->
  <view class="permission-notice">
    <t-icon name="shield-check" size="32rpx" color="#1a365d" />
    <text>仅主超级系统管理员（YH-ADMIN_SUPER-000）拥有账号管理权限{{isDevEnvironment ? ' · 开发环境支持删除并释放工号' : ' · 生产环境禁止删除账号'}}</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading && !list.length}}">
    <t-loading size="48rpx" theme="circular" />
    <text>正在读取账号数据...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && !list.length}}">
    <t-icon name="usergroup" size="88rpx" color="#a0a7b2" />
    <view class="empty-title">未找到相关账号</view>
    <view class="empty-desc">您可以点击右上角新建系统使用账号</view>
  </view>

  <!-- 账号列表 -->
  <view class="account-list" wx:else>
    <view
      class="account-card card-theme-{{item.cardTheme}} {{item.isRootAdmin ? 'card-root' : ''}} {{item.status === 'disabled' ? 'card-disabled' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
    >
      <!-- 头部：昵称与状态徽章 -->
      <view class="card-header">
        <view class="user-avatar-badge {{item.isRootAdmin ? 'avatar-root' : ''}}">
          <image
            wx:if="{{item.hasCustomAvatar}}"
            class="avatar-image"
            src="{{item.avatarDisplayUrl}}"
            mode="aspectFill"
            data-index="{{index}}"
            binderror="onAvatarError"
          />
          <image
            wx:else
            class="avatar-image default-avatar"
            src="/images/default-user-avatar.png"
            mode="aspectFill"
          />
          <view class="root-crown-indicator" wx:if="{{item.isRootAdmin}}">👑</view>
        </view>
        <view class="user-main-info">
          <view class="user-name-row">
            <text class="nickname">{{item.nickname}}</text>
            <view class="root-badge" wx:if="{{item.isRootAdmin}}">
              <text>👑 系统主账号</text>
            </view>
            <view class="status-badge status-{{item.status}}" wx:else>
              <text>{{item.statusLabel}}</text>
            </view>
          </view>
          <view class="username-sub">登录账号：{{item.username}}</view>
        </view>
      </view>

      <!-- 属性信息网格 -->
      <view class="card-body">
        <view class="info-row">
          <text class="info-label">工号编号</text>
          <text class="info-value mono-val">{{item.employeeNo || '未分配'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">系统角色</text>
          <text class="info-value role-val">{{item.roleName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">职位</text>
          <text class="info-value">{{item.jobTitle || '未设置'}}</text>
        </view>
        <view class="info-row" wx:if="{{item.email}}">
          <text class="info-label">绑定邮箱</text>
          <text class="info-value">{{item.email}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">最近登录</text>
          <text class="info-value date-val">{{item.lastLoginFormatted || '暂无登录记录'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">创建时间</text>
          <text class="info-value date-val">{{item.createdAtFormatted || '-'}}</text>
        </view>
      </view>

      <!-- 底部快捷操作栏 -->
      <view class="card-actions">
        <!-- 编辑职位 -->
        <view
          class="action-btn action-edit-job"
          data-id="{{item.id || item._id}}"
          data-username="{{item.username}}"
          data-job-title="{{item.jobTitle}}"
          bindtap="onEditJobTitle"
        >
          <t-icon name="edit" size="26rpx" color="#0b5796" />
          <text>编辑职位</text>
        </view>
        <!-- 重置密码 -->
        <view class="action-btn action-reset" data-id="{{item.id}}" data-username="{{item.username}}" bindtap="onResetPassword">
          <t-icon name="lock-on" size="26rpx" color="#1a365d" />
          <text>重置密码</text>
        </view>

        <!-- 状态切换：000 账号不可停用 -->
        <view wx:if="{{item.isRootAdmin}}" class="action-btn action-protected">
          <t-icon name="secured" size="26rpx" color="#9aa1ac" />
          <text>永久受保护</text>
        </view>
        <view
          wx:elif="{{item.status === 'active'}}"
          class="action-btn action-disable"
          data-id="{{item.id}}"
          data-username="{{item.username}}"
          bindtap="onDisableAccount"
        >
          <t-icon name="user-blocked" size="26rpx" color="#ba1a1a" />
          <text>停用账号</text>
        </view>
        <view
          wx:else
          class="action-btn action-enable"
          data-id="{{item.id}}"
          data-username="{{item.username}}"
          bindtap="onEnableAccount"
        >
          <t-icon name="check-circle" size="26rpx" color="#176c4b" />
          <text>恢复启用</text>
        </view>

        <!-- 开发环境删除账号 -->
        <view
          wx:if="{{isDevEnvironment && !item.isRootAdmin}}"
          class="action-btn action-delete"
          data-id="{{item.id}}"
          data-username="{{item.username}}"
          data-employeeno="{{item.employeeNo}}"
          bindtap="onDeleteAccount"
        >
          <t-icon name="delete" size="26rpx" color="#cf1322" />
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-create-bar">
    <view class="bottom-create-button" bindtap="navToCreate">
      <view class="bottom-create-icon"><t-icon name="add" size="42rpx" color="#ffffff" /></view>
      <text>新建账号</text>
    </view>
  </view>

  <view class="create-mask {{createPopupVisible ? 'is-visible' : ''}}" wx:if="{{createPopupMounted}}" bindtap="closeCreatePopup" catchtouchmove="stopPopupTouchMove">
    <view class="create-sheet" catchtap="stopPopupTap">
      <view class="create-sheet-handle"></view>
      <view class="create-sheet-header">
        <view>
          <view class="create-sheet-title">新建账号</view>
          <view class="create-sheet-desc">初始密码统一为 yh8888</view>
        </view>
        <view class="create-sheet-close" bindtap="closeCreatePopup"><t-icon name="close" size="32rpx" color="#64748b" /></view>
      </view>
      <scroll-view class="create-sheet-content" scroll-y>
        <view class="create-field">
          <text class="create-field-label">登录账号 <text class="create-required">*</text></text>
          <input class="create-input" value="{{createForm.username}}" placeholder="3-32 位字母、数字或 ._-" maxlength="32" data-field="username" bindinput="onCreateInput" />
        </view>
        <view class="create-field">
          <text class="create-field-label">账户昵称 <text class="create-required">*</text></text>
          <input class="create-input" value="{{createForm.nickname}}" placeholder="请输入账户昵称" maxlength="30" data-field="nickname" bindinput="onCreateInput" />
        </view>
        <view class="create-field">
          <text class="create-field-label">账号角色 <text class="create-required">*</text></text>
          <view class="create-select" bindtap="openCreateRolePicker">
            <text>{{createRoleOptions[createRoleIndex].label}}</text><t-icon name="chevron-right" size="30rpx" color="#94a3b8" />
          </view>
        </view>
        <view class="create-field">
          <text class="create-field-label">职位</text>
          <view class="create-select" bindtap="openCreateJobTitlePicker">
            <text class="{{createForm.jobTitle ? '' : 'create-placeholder'}}">{{createForm.jobTitle || '选填，点击选择职位'}}</text><t-icon name="chevron-right" size="30rpx" color="#94a3b8" />
          </view>
        </view>
        <view class="create-field">
          <text class="create-field-label">工号</text>
          <view class="create-readonly">{{createEmployeeNoLoading ? '正在生成...' : (createEmployeeNo || '自动生成')}}</view>
        </view>
        <view class="create-field">
          <text class="create-field-label">邮箱</text>
          <input class="create-input" value="{{createForm.email}}" placeholder="选填，用于找回密码" maxlength="80" data-field="email" bindinput="onCreateInput" />
        </view>
      </scroll-view>
      <view class="create-sheet-actions">
        <view class="create-cancel" bindtap="closeCreatePopup">取消</view>
        <view class="create-confirm" bindtap="submitCreateAccount">{{createSubmitting ? '正在创建...' : '创建账号'}}</view>
      </view>
    </view>
  </view>

  <t-picker
    t-class-confirm="picker-confirm"
    visible="{{jobTitlePickerVisible}}"
    value="{{jobTitlePickerValue}}"
    title="修改职位"
    z-index="{{12000}}"
    bindconfirm="onJobTitleConfirm"
    bindcancel="closeJobTitlePicker"
    bindclose="closeJobTitlePicker"
  >
    <t-picker-item options="{{jobTitleOptions}}" />
  </t-picker>

  <t-picker
    visible="{{createRolePickerVisible}}"
    value="{{createRolePickerValue}}"
    title="选择账号角色"
    z-index="{{12000}}"
    bindconfirm="onCreateRoleConfirm"
    bindcancel="closeCreateRolePicker"
    bindclose="closeCreateRolePicker"
  >
    <t-picker-item options="{{createRoleOptions}}" />
  </t-picker>

  <t-picker
    visible="{{createJobTitlePickerVisible}}"
    value="{{createJobTitlePickerValue}}"
    title="选择职位"
    z-index="{{12000}}"
    bindconfirm="onCreateJobTitleConfirm"
    bindcancel="closeCreateJobTitlePicker"
    bindclose="closeCreateJobTitlePicker"
  >
    <t-picker-item options="{{jobTitleOptions}}" />
  </t-picker>
</view>
