page {
  --td-brand-color: #2E9F8B;
  --td-brand-color-active: #248473;
  --td-brand-color-disabled: #A3D8CE;
  background: #F4F7F6;
}
.login-page {
  min-height: 100vh;
  padding: 0 30rpx 40rpx;
  box-sizing: border-box;
  background: #F4F7F6;
  color: #182220;
}
.login-content {
  width: 100%;
  max-width: 720rpx;
  margin: 0 auto;
  padding-top: calc(env(safe-area-inset-top) + 140rpx);
}
.brand {
  text-align: center;
}
.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 176rpx;
  margin: 0 auto 24rpx;
  overflow: hidden;
  border-radius: 46rpx;
  background: #fbfefd;
  border: 2rpx solid #d7ebe5;
  box-shadow: 0 14rpx 34rpx rgba(46, 159, 139, 0.16);
}
.brand-logo-image {
  width: 174rpx;
  height: 174rpx;
  transform: scale(1.18);
}
.brand-name {
  color: #182220;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 60rpx;
  letter-spacing: 2rpx;
}
.brand-sub {
  margin-top: 6rpx;
  color: #2E9F8B;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
.brand-tip {
  margin-top: 18rpx;
  color: #5C6B68;
  font-size: 26rpx;
  line-height: 40rpx;
}
.login-form {
  margin-top: 60rpx;
}
.logout-notice {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 32rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  color: #ba1a1a;
  box-sizing: border-box;
}
.logout-notice-text {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
}
.field-label {
  margin: 0 0 14rpx 14rpx;
  color: #5C6B68;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 32rpx;
}
.password-group {
  margin-top: 42rpx;
}
.field-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  overflow: hidden;
  border: 2rpx solid #D1E0DD;
  border-radius: 16rpx;
  background: #fff;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.field-box:focus-within {
  border-color: #2E9F8B;
  box-shadow: 0 0 0 2rpx rgba(46, 159, 139, 0.2);
}
.login-input {
  width: 100%;
  padding: 0 28rpx;
  background: transparent !important;
  color: #182220;
  font-size: 28rpx;
}
.login-placeholder {
  color: #94A3A0;
}
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 34rpx;
  color: #5C6B68;
  font-size: 22rpx;
  line-height: 34rpx;
}
.agreement-choice {
  display: flex;
  align-items: center;
  flex: none;
  min-height: 44rpx;
}
.agreement-label {
  margin-left: 8rpx;
}
.login-button {
  width: 100% !important;
  height: 88rpx !important;
  margin-top: 34rpx;
  border-radius: 16rpx !important;
  background: linear-gradient(135deg, #36AD97, #2A9A87) !important;
  box-shadow: 0 10rpx 28rpx rgba(42, 154, 135, 0.3) !important;
  font-size: 34rpx !important;
  font-weight: 600;
  line-height: 88rpx !important;
}
.help {
  margin-top: 80rpx;
  color: #5C6B68;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
  text-align: center;
}
.privacy-link {
  margin-left: 2rpx;
  color: #2E9F8B;
  font-weight: 600;
}
@media (max-height: 700px) {
  .login-content {
    padding-top: calc(env(safe-area-inset-top) + 100rpx);
  }
  .login-form {
    margin-top: 50rpx;
  }
  .help {
    margin-top: 60rpx;
  }
}
