<view class="page"><view class="nav" style="height:{{navHeight}}px;padding-top:{{statusBarHeight}}px"><view class="back" bindtap="back"><t-icon name="chevron-left" size="48rpx" color="#002045"/></view><view class="title">类目审核</view></view><view style="height:{{navHeight}}px"></view>
<view class="tabs"><view wx:for="{{tabs}}" wx:key="value" data-index="{{index}}" bindtap="changeTab" class="tab {{tabIndex===index?'active':''}}">{{item.label}}</view></view>
<view class="list"><view class="card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="open"><view class="card-head"><view class="name">{{item.proposedLabel}}</view><view class="status status-{{item.status}}">{{item.statusLabel}}</view></view><view class="unit">建议单位：{{item.proposedUnit||'未填写'}}</view><view class="meta">{{item.projectName}} · {{item.submittedByName}}</view><view class="foot"><text>累计出现 {{item.occurrenceCount||1}} 次</text><text>{{item.timeText}}</text></view></view><view class="empty" wx:if="{{!loading&&!list.length}}"><t-icon name="task-checked" size="80rpx" color="#9aa2ae"/><text>{{tabIndex===0?'暂无待审核类目':'暂无审核记录'}}</text></view><view class="loading" wx:if="{{loading}}"><t-loading size="38rpx"/><text>正在加载...</text></view></view></view>
