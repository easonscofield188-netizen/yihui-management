page,.page{min-height:100%;background:#f7f9fd;color:#172238}.nav{position:fixed;z-index:20;top:0;right:0;left:0;box-sizing:border-box;background:#f9f9ff;border-bottom:2rpx solid #e8edf5}.back{position:absolute;bottom:0;left:25rpx;display:flex;width:75rpx;height:88rpx;align-items:center}.title{height:88rpx;line-height:88rpx;text-align:center;font-size:36rpx;font-weight:700;color:#002045}.tabs{display:flex;margin:24rpx 30rpx 8rpx;padding:7rpx;border-radius:16rpx;background:#e9eef7}.tab{flex:1;padding:17rpx;text-align:center;color:#647084;font-size:24rpx}.tab.active{border-radius:12rpx;background:#fff;color:#123d68;font-weight:700;box-shadow:0 7rpx 18rpx rgba(34,67,111,.12)}.list{padding:18rpx 30rpx 50rpx}.card{margin-bottom:22rpx;padding:25rpx;border:2rpx solid #dce5f2;border-radius:21rpx;background:#fff;box-shadow:0 15rpx 34rpx rgba(40,83,139,.13)}.card:nth-child(2n){box-shadow:0 15rpx 34rpx rgba(112,78,153,.13)}.card-head,.foot{display:flex;align-items:center;justify-content:space-between;gap:15rpx}.name{font-size:29rpx;font-weight:700}.status{padding:6rpx 13rpx;border-radius:999rpx;background:#fff2d9;color:#8c5b00;font-size:19rpx}.status-APPROVED{background:#e5f6ed;color:#14704b}.status-REJECTED{background:#f8e8e7;color:#a52b2b}.status-MERGED{background:#e8effc;color:#285692}.unit{margin-top:12rpx;color:#315b8f;font-size:22rpx}.meta{margin-top:16rpx;color:#657083;font-size:21rpx}.foot{margin-top:18rpx;padding-top:16rpx;border-top:2rpx solid #edf1f6;color:#9299a5;font-size:19rpx}.empty,.loading{display:flex;min-height:430rpx;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;color:#89919e;font-size:24rpx}.loading{min-height:180rpx;flex-direction:row}
