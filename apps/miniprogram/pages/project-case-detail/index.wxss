page { background: #f9f9ff; }
.detail-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); background: #f9f9ff; color: #121c2c; }
.detail-page.shared-view { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.detail-nav { position: fixed; top: 0; right: 0; left: 0; z-index: 20; box-sizing: border-box; border-bottom: 2rpx solid #edf0f5; background: rgba(249,249,255,.97); }
.nav-placeholder { width: 100%; }
.nav-back { position: absolute; bottom: 0; left: 28rpx; display: flex; width: 74rpx; height: 88rpx; align-items: center; }
.nav-title { position: absolute; right: 150rpx; bottom: 0; left: 150rpx; height: 88rpx; color: #002045; font-size: 40rpx; font-weight: 700; line-height: 88rpx; text-align: center; }
.share-disabled { opacity: .56; }
.detail-content { padding: 34rpx 32rpx 20rpx; }
.case-id { color: #5b5f61; font-family: monospace; font-size: 25rpx; letter-spacing: 2rpx; }
.detail-title { margin-top: 18rpx; color: #002045; font-size: 42rpx; font-weight: 700; line-height: 60rpx; }
.detail-date { margin-top: 36rpx; color: #5b5f61; font-family: monospace; font-size: 27rpx; }
.detail-amount { margin-top: 20rpx; color: #002045; font-size: 32rpx; font-weight: 700; }
.image-grid { display: grid; margin-top: 48rpx; grid-template-columns: 1fr; gap: 22rpx; }
.gallery-item { position: relative; width: 100%; min-height: 300rpx; overflow: hidden; border-radius: 24rpx; background: #e7eeff; box-shadow: 0 8rpx 24rpx rgba(26,54,93,.06); }
.gallery-image { display: block; width: 100%; height: auto; }
.gallery-loading,.gallery-failed { display: flex; min-height: 300rpx; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; background: linear-gradient(135deg,#e9eff9,#f5f7fc); color: #748096; font-size: 23rpx; }
.gallery-loading { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; min-height: 0; }
.cover-status { position: absolute; top: 18rpx; right: 18rpx; z-index: 2; display: flex; height: 54rpx; padding: 0 18rpx; align-items: center; gap: 8rpx; border: 3rpx solid rgba(255,255,255,.94); border-radius: 999rpx; background: linear-gradient(135deg,#16a47d,#08745d); color: #ffffff; font-size: 23rpx; font-weight: 700; box-shadow: 0 7rpx 18rpx rgba(8,116,93,.3); }
.set-cover-position { position: absolute; top: 18rpx; right: 18rpx; z-index: 2; display: flex; width: 166rpx; height: 54rpx; align-items: center; justify-content: center; }
.set-cover-button { --td-button-extra-small-icon-size: 28rpx; width: 166rpx !important; min-width: 166rpx !important; max-width: 166rpx !important; height: 54rpx !important; padding: 0 16rpx !important; border: 3rpx solid #f1ad3d !important; border-radius: 999rpx !important; background: rgba(255,249,237,.96) !important; color: #a85b00 !important; font-size: 23rpx !important; font-weight: 700 !important; box-shadow: 0 7rpx 18rpx rgba(170,91,0,.2); }
.description-card { margin-top: 48rpx; padding: 42rpx 44rpx; border-radius: 26rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(26,54,93,.05); }
.description-title { padding-left: 24rpx; border-left: 6rpx solid #1a365d; color: #002045; font-size: 34rpx; font-weight: 700; }
.description-text { margin-top: 32rpx; color: #43474e; font-size: 28rpx; line-height: 50rpx; white-space: pre-wrap; }
.detail-loading { display: flex; padding-top: 220rpx; align-items: center; justify-content: center; gap: 14rpx; color: #74777f; font-size: 25rpx; }
.bottom-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; display: flex; padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom)); align-items: center; background: rgba(255,255,255,.96); box-shadow: 0 -8rpx 24rpx rgba(26,54,93,.05); }
.friend-share-host { display: block; min-width: 0; height: 88rpx; flex: 1; }
.friend-share { display: flex !important; width: 100% !important; height: 88rpx !important; margin: 0 !important; padding: 0 30rpx !important; align-items: center; justify-content: center; gap: 14rpx; border-radius: 999rpx !important; background: #002045 !important; color: #ffffff !important; font-size: 29rpx !important; font-weight: 700 !important; }
