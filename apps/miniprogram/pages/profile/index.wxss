page {
  background: #f9f9ff;
}

.profile-page {
  min-height: 100vh;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
  background: #f9f9ff;
  color: #121c2c;
}

.profile-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #f0f3ff;
  background: #f9f9ff;
}

.nav-wallet {
  position: absolute;
  bottom: 0;
  left: 32rpx;
  display: flex;
  width: 70rpx;
  height: 88rpx;
  align-items: center;
}

.nav-title {
  position: absolute;
  right: 150rpx;
  bottom: 0;
  left: 150rpx;
  height: 88rpx;
  color: #002045;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}

.profile-content {
  padding: 32rpx;
}

.user-card,
.function-card,
.logout-button {
  border: 2rpx solid rgba(214, 227, 255, .72);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow:
    0 14rpx 34rpx rgba(26, 54, 93, .07),
    inset 0 2rpx 0 rgba(255, 255, 255, .95);
}

.user-card {
  position: relative;
  display: flex;
  min-height: 238rpx;
  overflow: hidden;
  padding: 36rpx 40rpx;
  align-items: center;
  gap: 30rpx;
}

.user-card-glow {
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(214, 227, 255, .56), rgba(214, 227, 255, 0) 70%);
}

.avatar-wrap {
  position: relative;
  z-index: 1;
  width: 144rpx;
  height: 144rpx;
  flex: none;
  overflow: hidden;
  border: 4rpx solid #dee8ff;
  border-radius: 50%;
  background: #d6e3ff;
  box-shadow: 0 8rpx 20rpx rgba(26, 54, 93, .14);
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  color: #1a365d;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 140rpx;
  text-align: center;
}

.user-main {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.user-name {
  overflow: hidden;
  color: #121c2c;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 54rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-badges {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.role-badge {
  display: inline-flex;
  padding: 6rpx 16rpx;
  align-items: center;
  gap: 7rpx;
  border: 2rpx solid rgba(173, 199, 247, .42);
  border-radius: 999rpx;
  background: #dee8ff;
  color: #002045;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.job-badge {
  display: inline-flex;
  padding: 6rpx 16rpx;
  align-items: center;
  gap: 7rpx;
  border: 2rpx solid #cbe4fa;
  border-radius: 999rpx;
  background: #eef7fe;
  color: #0b5796;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.employee-no {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 23rpx;
  font-family: monospace;
}

.profile-edit-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f0f4fd;
  border: 1rpx solid #d2e1fa;
  color: #002045;
  font-size: 23rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 32, 69, 0.06);
  transition: all 0.15s ease;
}

.profile-edit-btn:active {
  opacity: 0.75;
  background: #e1ebfc;
}

.function-card {
  margin-top: 64rpx;
}

.function-row {
  display: flex;
  min-height: 124rpx;
  align-items: center;
  justify-content: space-between;
}

.function-main {
  display: flex;
  align-items: center;
  gap: 28rpx;
  color: #121c2c;
  font-size: 30rpx;
}

.function-side {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.notification-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 9rpx;
  border-radius: 999rpx;
  background: #ba1a1a;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.function-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e7eeff;
}

.quick-section { margin-top: 42rpx; }
.profile-section-title { margin: 0 4rpx 18rpx; color: #334057; font-size: 27rpx; font-weight: 700; }
.quick-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18rpx; }
.quick-tile { display: flex; min-height: 142rpx; padding: 22rpx; align-items: center; gap: 18rpx; border: 2rpx solid rgba(214,227,255,.75); border-radius: 21rpx; background: #fff; color: #253047; font-size: 27rpx; font-weight: 650; box-shadow: 0 10rpx 25rpx rgba(26,54,93,.07); }
.quick-icon { display: flex; width: 64rpx; height: 64rpx; flex: none; align-items: center; justify-content: center; border-radius: 17rpx; }
.quick-icon.blue { background: #e8f0ff; }
.quick-icon.violet { background: #f0ebff; }
.quick-icon.green { background: #e7f6ef; }
.quick-icon.gray { background: #edf0f4; }
.admin-center-entry { position: relative; display: flex; min-height: 132rpx; margin-top: 28rpx; overflow: hidden; padding: 26rpx 28rpx; align-items: center; gap: 20rpx; border-radius: 23rpx; background: linear-gradient(135deg,#0b315d,#1e5c94); color: #fff; box-shadow: 0 16rpx 32rpx rgba(13,54,99,.2); }
.admin-entry-icon { display: flex; width: 72rpx; height: 72rpx; flex: none; align-items: center; justify-content: center; border-radius: 19rpx; background: rgba(255,255,255,.14); }
.admin-entry-main { min-width: 0; flex: 1; }
.admin-entry-title { font-size: 29rpx; font-weight: 700; }
.admin-entry-description { margin-top: 7rpx; color: rgba(255,255,255,.72); font-size: 20rpx; line-height: 29rpx; }

.agreement-card {
  margin-top: 32rpx;
}

.function-copy {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.function-description {
  color: #8a909a;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.function-divider {
  height: 2rpx;
  margin-left: 100rpx;
  background: #d9e3f9;
}

.logout-button {
  display: flex;
  width: 100%;
  height: 104rpx;
  margin-top: 64rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #ba1a1a;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 104rpx;
}

.app-version {
  margin-top: 48rpx;
  margin-bottom: 24rpx;
  color: #98a0ad;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.profile-loading-mask {
  position: fixed;
  z-index: 50;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(249, 249, 255, .78);
}

.profile-loading-content {
  display: flex;
  padding: 24rpx 34rpx;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid #e7eeff;
  border-radius: 18rpx;
  background: #ffffff;
  color: #002045;
  font-size: 25rpx;
  box-shadow: 0 10rpx 28rpx rgba(26, 54, 93, .1);
}
