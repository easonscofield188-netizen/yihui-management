<view class="profile-page">
  <view class="profile-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="nav-brand">
      <image class="nav-logo" src="/images/company-logo.png" mode="aspectFit" />
      <text class="nav-title">亿辉文化</text>
    </view>
  </view>

  <view class="profile-content" wx:if="{{userInfo}}">
    <view class="user-card">
      <view class="user-card-glow"></view>
      <view class="avatar-wrap">
        <image wx:if="{{userInfo.hasCustomAvatar && userInfo.avatarDisplayUrl}}" class="avatar-image" src="{{userInfo.avatarDisplayUrl}}" mode="aspectFill" binderror="onAvatarError" />
        <image wx:else class="avatar-image" src="/images/default-user-avatar.png" mode="aspectFill" />
      </view>
      <view class="user-main">
        <view class="user-name">{{userInfo.displayName}}</view>
        <view class="user-badges">
          <view class="role-badge">
            <t-icon name="check-circle" size="24rpx" color="#2E9F8B" />
            <text>{{userInfo.roleDisplayName}}</text>
          </view>
          <view class="job-badge" wx:if="{{userInfo.jobTitleDisplay}}">
            <t-icon name="user" size="24rpx" color="#0b5796" />
            <text>{{userInfo.jobTitleDisplay}}</text>
          </view>
        </view>
        <view class="employee-no">工号: {{userInfo.employeeDisplayNo}}</view>
      </view>
      <view class="profile-edit-btn" bindtap="openProfileEdit">
        <t-icon name="edit" size="28rpx" color="#002045" />
        <text>编辑资料</text>
      </view>
    </view>

    <view class="quick-section">
      <view class="profile-section-title">常用功能</view>
      <view class="quick-grid">
        <view class="quick-tile" bindtap="openProjects"><view class="quick-icon blue"><t-icon name="catalog" size="40rpx" color="#285692" /></view><text>项目总览</text></view>
        <view class="quick-tile" bindtap="openProjectQuotations"><view class="quick-icon violet"><t-icon name="bill" size="40rpx" color="#6350a7" /></view><text>项目报价</text></view>
        <view class="quick-tile" bindtap="openProjectCases"><view class="quick-icon green"><t-icon name="image" size="40rpx" color="#26785f" /></view><text>项目案例</text></view>
        <view class="quick-tile" bindtap="openExpenseList"><view class="quick-icon orange"><t-icon name="wallet" size="40rpx" color="#b45309" /></view><text>公司支出</text></view>
        <view class="quick-tile" bindtap="openExpenseAnalysis"><view class="quick-icon cyan"><t-icon name="chart-pie" size="40rpx" color="#0891b2" /></view><text>支出分析</text></view>
        <view class="quick-tile" bindtap="openSecurity"><view class="quick-icon gray"><t-icon name="lock-on" size="40rpx" color="#536174" /></view><text>账号安全</text></view>
      </view>
    </view>

    <view wx:if="{{userInfo.role === 'ADMIN_SUPER'}}" class="admin-center-entry" bindtap="openAdminCenter">
      <view class="admin-entry-icon"><t-icon name="control-platform" size="44rpx" color="#ffffff" /></view>
      <view class="admin-entry-main"><view class="admin-entry-title">管理中心</view><view class="admin-entry-description">客户、账号、消息、数据配置与系统设置</view></view>
      <view class="function-side"><view wx:if="{{unreadNotificationCount}}" class="notification-badge">{{unreadNotificationCount > 99 ? '99+' : unreadNotificationCount}}</view><t-icon name="chevron-right" size="38rpx" color="#ffffff" /></view>
    </view>

    <view class="function-card agreement-card">
      <view class="function-row" bindtap="openPrivacyContract">
        <view class="function-main">
          <view class="function-icon"><t-icon name="secured" size="38rpx" color="#002045" /></view>
          <view class="function-copy">
            <text>隐私保护指引</text>
            <text class="function-description">查看隐私规则及补充说明</text>
          </view>
        </view>
        <t-icon name="chevron-right" size="38rpx" color="#74777f" />
      </view>
    </view>

    <button class="logout-button" bindtap="logout">
      <t-icon name="logout" size="34rpx" color="#ba1a1a" />
      <text>退出登录</text>
    </button>

    <view class="app-version">当前版本 {{versionText}}</view>
  </view>

  <view class="profile-loading-mask" wx:if="{{loading}}" catchtap="stopPropagation" catchtouchmove="stopPropagation">
    <view class="profile-loading-content">
      <t-loading size="44rpx" theme="circular" />
      <text>{{loadingMessage}}</text>
    </view>
  </view>
</view>
