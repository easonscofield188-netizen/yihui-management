page { background: #F4F7F6; }
.projects-page { min-height: 100vh; background: #F4F7F6; }
.top-nav-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.98);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  border-bottom: 2rpx solid #E2ECE9;
}
.nav-brand-row {
  display: flex;
  height: 88rpx;
  padding: 0 32rpx;
  align-items: center;
}
.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #182220;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.brand-logo-icon {
  width: 52rpx;
  height: 52rpx;
}

/* 顶部项目类型分段选择器（Segmented Control 风格） */
.top-type-tabs {
  display: flex;
  align-items: center;
  margin: 12rpx 32rpx 20rpx;
  border: 2rpx solid #2E9F8B;
  border-radius: 12rpx;
  overflow: hidden;
  background: #ffffff;
  box-sizing: border-box;
}
.top-type-tab {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #2E9F8B;
  background: #ffffff;
  border-right: 2rpx solid #2E9F8B;
  transition: all 0.2s ease;
  cursor: pointer;
  text-align: center;
  box-sizing: border-box;
}
.top-type-tab:last-child {
  border-right: none;
}
.top-type-tab.active {
  background: linear-gradient(135deg, #36AD97, #2A9A87);
  color: #ffffff;
  font-weight: 600;
}

.selection-toolbar {
  /* 位于 top-nav-bar 内，随顶部项目标签作为一个整体吸顶。 */
  display: flex;
  height: 100rpx;
  padding: 0 32rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #e7eeff;
  background: #f5f8ff;
}
.selection-cancel { color: #5f6368; font-size: 28rpx; }
.selection-count { color: #002045; font-size: 30rpx; font-weight: 700; }
.selection-action { color: #1a365d; font-size: 28rpx; font-weight: 600; }
.selection-delete { color: #c62828; font-size: 28rpx; font-weight: 700; }
.selection-delete.disabled { color: #b0b4b9; }

/* 搜索与二级筛选面板 */
.filter-panel {
  padding: 20rpx 32rpx 24rpx;
  border-bottom: 2rpx solid #eef2fa;
  background: #ffffff;
}
.search-filter-row {
  display: flex;
  align-items: center;
}
.search-box {
  width: 100%;
  display: flex;
  height: 72rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f0f4fa;
  border: 2rpx solid #e8eef8;
}
.search-input {
  flex: 1;
  height: 72rpx;
  color: #121c2c;
  font-size: 26rpx;
}
.search-placeholder { color: #989fa6; }

.filter-control-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.year-chip {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f4;
  border-radius: 999rpx;
  background: #f0f4fa;
  color: #002045;
  font-size: 25rpx;
  font-weight: 600;
}
.year-text { line-height: 1; }

.sort-chip {
  flex-shrink: 0;
  display: flex;
  min-width: 190rpx;
  max-width: 300rpx;
  height: 72rpx;
  padding: 0 24rpx;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid #e2e8f4;
  border-radius: 999rpx;
  background: #f0f4fa;
  color: #002045;
  font-size: 25rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.sort-chip.active {
  border-color: #2E9F8B;
  background: linear-gradient(135deg, #36AD97, #2A9A87);
  color: #ffffff;
}
.sort-text { overflow: hidden; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }

/* 二级状态胶囊 */
.status-tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  overflow-x: auto;
  scrollbar-width: none;
}
.status-tabs::-webkit-scrollbar {
  display: none;
}
.status-tab {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  background: #f3f6fb;
  color: #555b64;
  font-size: 25rpx;
  line-height: 32rpx;
  text-align: center;
  transition: all 0.2s ease;
}
.status-tab.active {
  border-color: #2E9F8B;
  background: linear-gradient(135deg, #36AD97, #2A9A87);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(42, 154, 135, 0.2);
}

.query-loading-mask { position: fixed; z-index: 50; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(249,249,255,.78); }
.query-loading-content { display: flex; padding: 24rpx 34rpx; align-items: center; gap: 16rpx; border: 2rpx solid #e7eeff; border-radius: 18rpx; background: #fff; color: #002045; font-size: 25rpx; box-shadow: 0 10rpx 28rpx rgba(26,54,93,.1); }

.project-list { padding: 32rpx; }
.project-card { position: relative; overflow: hidden; margin-bottom: 28rpx; border: 2rpx solid #d9e3f9; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(26,54,93,.04); }
.project-card.longterm-card {
  border-color: #c7d2fe;
  background: #ffffff;
}
.project-card.selecting { transition: border-color .15s ease, background .15s ease; }
.project-card.selected { border-color: #1a365d; background: #f5f8ff; box-shadow: 0 8rpx 24rpx rgba(26,54,93,.1); }
.project-card.selected.closed-card { opacity: 1; }
.card-accent { height: 7rpx; background: #d6e3ff; }
.card-accent.longterm-accent { background: linear-gradient(90deg, #6366f1, #3b82f6); }
.closed-card { opacity: .82; }
.closed-card .card-accent { background: #c1c7cf; }

.card-body { padding: 28rpx 32rpx 32rpx; }
.project-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.project-meta-left { display: flex; min-width: 0; align-items: center; gap: 14rpx; }
.project-meta-right { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.type-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-size: 21rpx;
  font-weight: 700;
}
.longterm-badge {
  background: #fff7ed;
  color: #c2410c;
  border: 1rpx solid #fed7aa;
}
.normal-badge {
  background: #f1f5f9;
  color: #334155;
  border: 1rpx solid #cbd5e1;
}
.selection-check { display: flex; width: 42rpx; height: 42rpx; flex-shrink: 0; align-items: center; justify-content: center; }
.project-code { color: #74777f; font-size: 26rpx; font-weight: 600; letter-spacing: 1rpx; }

.status-badge { display: flex; flex-shrink: 0; align-items: center; gap: 8rpx; padding: 8rpx 18rpx; border-radius: 32rpx; background: #e7eeff; color: #002045; font-size: 23rpx; }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #002045; }
.status-in_cooperation {
  border: 2rpx solid #a5b4fc;
  background: #eef2ff;
  color: #3730a3;
  font-weight: 700;
}
.status-in_cooperation .status-dot {
  background: #4f46e5;
}
.status-terminated {
  border: 2rpx solid #fca5a5;
  background: #fef2f2;
  color: #991b1b;
  font-weight: 700;
}
.status-terminated .status-dot {
  background: #dc2626;
}
.status-completed {
  border: 2rpx solid #9db7e5;
  background: #e7eeff;
  color: #002045;
  font-weight: 700;
}
.status-closed {
  border: 2rpx solid #7dcea0;
  background: #e8f8ef;
  color: #0f7a45;
  font-weight: 700;
}
.status-closed .status-dot {
  background: #0f7a45;
}
.status-archived {
  border: 2rpx solid #c7cbd1;
  background: #f1f3f5;
  color: #6b7280;
  font-weight: 700;
}
.status-archived .status-dot { background: #6b7280; }

.project-name { margin-top: 24rpx; overflow: hidden; color: #121c2c; font-size: 34rpx; font-weight: 700; line-height: 48rpx; text-overflow: ellipsis; white-space: nowrap; }
.client-row { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; color: #43474e; font-size: 27rpx; line-height: 38rpx; }
.delivery-row { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin-top: 12rpx; color: #74777f; font-size: 24rpx; line-height: 36rpx; }
.delivery-left { display: flex; align-items: center; gap: 8rpx; }
.delivery-date { margin-left: 8rpx; color: #43474e; font-weight: 600; }
.service-records-pill {
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: #edf2fc;
  border: 1rpx solid #d9e3f9;
  color: #002045;
  font-size: 22rpx;
  font-weight: 600;
}

.divider { height: 2rpx; margin: 28rpx 0; background: #d9e3f9; }
.amount-main { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 24rpx; border: 2rpx solid #d9e3f9; border-radius: 14rpx; background: #f0f3ff; color: #43474e; font-size: 28rpx; }
.amount-main-value { color: #121c2c; font-size: 34rpx; font-weight: 700; }
.amount-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 22rpx; margin-top: 22rpx; }
.amount-cell { min-height: 130rpx; padding: 20rpx 24rpx; border: 2rpx solid #d9e3f9; border-radius: 14rpx; background: #fff; }
.amount-cell.receivable { border-color: #ffdad6; background: #fff8f7; }
.amount-cell.cost { background: #e7eeff; }
.amount-cell.profit { display: flex; min-height: 92rpx; grid-column: 1 / -1; align-items: center; justify-content: space-between; border-color: #cdebd9; background: linear-gradient(135deg, #f3fbf6, #eaf7ef); }
.amount-label { display: flex; align-items: center; gap: 8rpx; color: #43474e; font-size: 23rpx; }
.amount-value { display: block; margin-top: 14rpx; color: #43474e; font-size: 31rpx; font-weight: 700; }
.receivable .amount-value { color: #ba1a1a; }
.profit .amount-value { margin-top: 0; }
.profit-summary-item, .profit-rate-summary { box-sizing: border-box; flex: 1; min-width: 0; }
.profit-summary-item { padding-right: 20rpx; }
.profit-rate-summary { display: flex; min-height: 58rpx; padding-left: 24rpx; flex-direction: column; justify-content: center; border-left: 2rpx solid #b9e4c9; color: #137047; font-size: 22rpx; line-height: 1.35; }
.profit-rate-summary text:last-child { margin-top: 2rpx; font-size: 29rpx; font-weight: 800; }
.profit-rate-summary.negative { border-color: #ffdad6; color: #ba1a1a; }
.profit-positive { color: #137047 !important; }
.profit-negative { color: #ba1a1a !important; }

.longterm-card-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #e1e9f8;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
}
.quick-record-pill-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: #edf2fc;
  border: 2rpx solid #c8d9f8;
  color: #002045;
  font-size: 26rpx;
  font-weight: 700;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 32, 69, 0.04);
}
.quick-record-pill-btn:active {
  background: #002045;
  border-color: #002045;
  color: #ffffff;
}
.quick-record-pill-btn:active t-icon {
  color: #ffffff !important;
}

.empty { padding: 140rpx 0; color: #74777f; font-size: 26rpx; text-align: center; }
.empty-title { margin-top: 20rpx; margin-bottom: 10rpx; color: #43474e; font-size: 30rpx; font-weight: 600; }
.loading { display: flex; align-items: center; justify-content: center; gap: 14rpx; padding: 26rpx; color: #989fa6; font-size: 24rpx; }

.list-end-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 40rpx 32rpx 16rpx;
  color: #b0b5bd;
  font-size: 23rpx;
}
.list-end-line {
  flex: 1;
  height: 1rpx;
  max-width: 120rpx;
  background: linear-gradient(90deg, transparent, #d0d5dd, transparent);
}
.list-bottom-safe {
  height: 280rpx;
}
.picker-confirm { color: #2E9F8B !important; font-weight: 700; }
.floating-notification { position: fixed; z-index: 46; display: flex; box-sizing: border-box; width: 104rpx; height: 104rpx; align-items: center; justify-content: center; border: 4rpx solid rgba(255,255,255,.94); border-radius: 50%; background: linear-gradient(145deg, #356bb8, #002f65); box-shadow: 0 12rpx 30rpx rgba(0,32,69,.28); transition: box-shadow .16s ease, transform .16s ease; touch-action: none; }
.floating-notification.has-unread { background: linear-gradient(145deg, #2d78c8, #073e78); box-shadow: 0 12rpx 34rpx rgba(0,54,112,.34), 0 0 0 8rpx rgba(80,139,213,.1); }
.floating-notification.dragging { box-shadow: 0 18rpx 42rpx rgba(0,32,69,.34); transform: scale(1.06); }
.floating-notification-glow { position: absolute; top: 12rpx; left: 19rpx; width: 34rpx; height: 17rpx; border-radius: 50%; background: rgba(255,255,255,.2); transform: rotate(-28deg); }
.floating-notification-badge { position: absolute; top: -10rpx; right: -10rpx; min-width: 34rpx; height: 34rpx; padding: 0 8rpx; border: 3rpx solid #ffffff; border-radius: 999rpx; background: #d93025; color: #ffffff; font-size: 19rpx; font-weight: 750; line-height: 34rpx; text-align: center; box-shadow: 0 4rpx 10rpx rgba(186,26,26,.25); }
