<page-meta page-style="{{yearPickerVisible || sortPickerVisible ? 'overflow: hidden;' : ''}}" />
<view class="projects-page">
  <!-- 顶部主导航与大分类 Tab -->
  <view class="top-nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-brand-row">
      <view class="brand"><t-icon name="wallet" size="44rpx" color="#002045" /><text>亿辉艺术</text></view>
    </view>

    <!-- 顶部项目类型分段选择器 -->
    <view class="top-type-tabs">
      <view
        class="top-type-tab {{projectType === '' ? 'active' : ''}}"
        data-type=""
        bindtap="onProjectTypeTap"
      >全部项目</view>
      <view
        class="top-type-tab {{projectType === 'normal' ? 'active' : ''}}"
        data-type="normal"
        bindtap="onProjectTypeTap"
      >常规项目</view>
      <view
        class="top-type-tab {{projectType === 'long_term' ? 'active' : ''}}"
        data-type="long_term"
        bindtap="onProjectTypeTap"
      >长期合作</view>
    </view>

    <view class="selection-toolbar" wx:if="{{selectionMode}}">
      <view class="selection-cancel" bindtap="cancelProjectSelection">取消</view>
      <view class="selection-count">已选择 {{selectedIds.length}} 个</view>
      <view class="selection-action" bindtap="toggleSelectAllProjects">{{allSelected ? '取消全选' : '全选'}}</view>
      <view class="selection-delete {{selectedIds.length && !deleting ? '' : 'disabled'}}" bindtap="deleteSelectedProjects">删除</view>
    </view>
  </view>
  <view class="filter-panel" wx:if="{{!selectionMode}}">
    <!-- 搜索框独占一行，避免与筛选项在窄屏上互相挤压。 -->
    <view class="search-filter-row">
      <view class="search-box">
        <t-icon name="search" size="36rpx" color="#74777f" bindclick="onSearch" />
        <input
          class="search-input"
          placeholder="搜索项目名称..."
          placeholder-class="search-placeholder"
          value="{{keyword}}"
          confirm-type="search"
          bindinput="onKeywordInput"
          bindconfirm="onSearch"
        />
        <t-icon wx:if="{{keyword}}" name="close-circle" size="32rpx" color="#989fa6" bindclick="clearKeyword" />
      </view>
    </view>

    <view class="filter-control-row">
      <view class="year-chip" bindtap="openYearPicker">
        <t-icon name="calendar" size="28rpx" color="#002045" />
        <text class="year-text">{{filterYearText}}</text>
        <t-icon name="chevron-down" size="24rpx" color="#002045" />
      </view>

      <view class="sort-chip {{sortValue ? 'active' : ''}}" bindtap="openSortOptions">
        <t-icon name="filter" size="28rpx" color="{{sortValue ? '#ffffff' : '#002045'}}" />
        <text class="sort-text">{{sortText}}</text>
        <t-icon name="chevron-down" size="24rpx" color="{{sortValue ? '#ffffff' : '#002045'}}" />
      </view>
    </view>

    <!-- 二级状态过滤胶囊（仅在选择了常规项目或长期合作时展示） -->
    <view class="status-tabs" wx:if="{{projectType !== ''}}">
      <view
        wx:for="{{statusOptions}}"
        wx:key="value"
        class="status-tab {{statusIndex === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onStatusTap"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="query-loading-mask" wx:if="{{queryLoading}}" catchtap="stopPropagation" catchtouchmove="stopPropagation">
    <view class="query-loading-content">
      <t-loading size="44rpx" theme="circular" />
      <text>{{loadingMessage}}</text>
    </view>
  </view>

  <view class="project-list">
    <view wx:for="{{projects}}" wx:key="_id" class="project-card {{item.type === 'long_term' ? 'longterm-card' : ''}} {{item.isClosed ? 'closed-card' : ''}} {{selectionMode ? 'selecting' : ''}} {{item.selected ? 'selected' : ''}}" data-id="{{item._id}}" bindtap="openProject" bindlongpress="enterProjectSelection">
      <view class="card-accent {{item.type === 'long_term' ? 'longterm-accent' : ''}}"></view>
      <view class="card-body">
        <view class="project-meta">
          <view class="project-meta-left">
            <view wx:if="{{selectionMode}}" class="selection-check" data-id="{{item._id}}" catchtap="onProjectSelectionTap">
              <t-icon name="{{item.selected ? 'check-circle-filled' : 'circle'}}" size="42rpx" color="{{item.selected ? '#1a365d' : '#a9b0bb'}}" />
            </view>
            <view wx:if="{{item.type === 'long_term'}}" class="type-badge longterm-badge">
              <t-icon name="repeat" size="22rpx" color="#c2410c" />
              <text>长期</text>
            </view>
            <view wx:elif="{{item.type === 'flower_plant'}}" class="type-badge longterm-badge">
              <t-icon name="tree-square-dot" size="22rpx" color="#c2410c" />
              <text>鲜花绿植</text>
            </view>
            <view wx:else class="type-badge normal-badge">
              <text>常规</text>
            </view>
            <text class="project-code">{{item.createDateText}}</text>
          </view>
          <view class="status-badge status-{{item.status}}">
            <t-icon wx:if="{{item.usesCheckIcon}}" name="check-circle" size="25rpx" color="{{item.statusIconColor}}" />
            <view wx:else class="status-dot"></view><text>{{item.statusLabel}}</text>
          </view>
        </view>

        <!-- 长期项目主标题显示客户名称，常规项目显示项目名称 -->
        <block wx:if="{{item.type === 'long_term'}}">
          <view class="project-name">{{item.client || item.name}}</view>
          <view class="client-row" wx:if="{{item.name && item.name !== item.client}}">
            <t-icon name="assignment" size="28rpx" color="#74777f" />
            <text>{{item.name}}</text>
          </view>
        </block>
        <block wx:else>
          <view class="project-name">{{item.name}}</view>
          <view class="client-row" wx:if="{{item.type !== 'flower_plant'}}"><t-icon name="building-1" size="30rpx" color="#43474e" /><text>{{item.client || '未填写客户'}}</text></view>
        </block>

        <!-- 交付日期展示：长期项目展示最新单子交付日期，常规项目展示交付日期 -->
        <view class="delivery-row" wx:if="{{item.type === 'long_term'}}">
          <view class="delivery-left">
            <t-icon name="calendar" size="29rpx" color="#74777f" />
            <text>交付日期</text>
            <text class="delivery-date">{{item.deliveryDateText}}</text>
          </view>
          <view class="service-records-pill">
            已履约 {{item.serviceRecordsCount || 0}} 次
          </view>
        </view>
        <view class="delivery-row" wx:else>
          <view class="delivery-left">
            <t-icon name="calendar" size="29rpx" color="#74777f" />
            <text>交付日期</text>
          </view>
          <text class="delivery-date">{{item.deliveryDateText}}</text>
        </view>

        <view class="divider"></view>
        <view class="amount-main"><text>{{item.amountLabel}}</text><text class="amount-main-value">￥{{item.amountText}}</text></view>
        <view class="amount-grid">
          <view class="amount-cell receivable">
            <view class="amount-label"><t-icon wx:if="{{!item.isClosed}}" name="arrow-down" size="28rpx" color="#ba1a1a" /><text>待收金额</text></view>
            <text class="amount-value">￥{{item.unreceivedText}}</text>
          </view>
          <view class="amount-cell cost">
            <view class="amount-label"><t-icon wx:if="{{!item.isClosed}}" name="arrow-up" size="28rpx" color="#43474e" /><text>{{item.isLongTerm ? '累计支出' : '项目成本'}}</text></view>
            <text class="amount-value">￥{{item.costText}}</text>
          </view>
          <view class="amount-cell profit">
            <view class="profit-summary-item">
              <view class="amount-label"><t-icon name="chart-line" size="28rpx" color="{{item.profitPositive ? '#137047' : '#ba1a1a'}}" /><text>{{item.isLongTerm ? '累计利润' : '项目利润'}}</text></view>
              <text class="amount-value {{item.profitPositive ? 'profit-positive' : 'profit-negative'}}">￥{{item.profitText}}</text>
            </view>
            <view class="profit-rate-summary {{item.profitPositive ? '' : 'negative'}}">
              <text>利润率</text>
              <text>{{item.profitRateText}}</text>
            </view>
          </view>
        </view>

        <!-- 长期项目与鲜花绿植账本的快捷记账入口 -->
        <view class="longterm-card-footer" wx:if="{{item.isLongTerm && !selectionMode}}">
          <view class="quick-record-pill-btn" data-id="{{item._id}}" data-name="{{item.name}}" data-type="{{item.type}}" catchtap="openServiceRecordModal">
            <t-icon name="add-circle" size="30rpx" color="#002045" />
            <text>{{item.type === 'flower_plant' ? '新增业务记录 / 记账' : '点击添加一条新的服务内容 / 收支'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && projects.length === 0}}">
      <t-icon name="folder-open" size="80rpx" color="#989fa6" />
      <view class="empty-title">暂无匹配项目</view><view>可更换年份、类型或状态后重试</view>
    </view>
    <view class="loading" wx:if="{{loading && !queryLoading}}"><t-loading size="36rpx" theme="circular" /><text>正在加载项目...</text></view>
    <view class="list-end-hint" wx:if="{{!loading && projects.length > 0}}">
      <view class="list-end-line"></view>
      <text>没有更多项目了</text>
      <view class="list-end-line"></view>
    </view>
    <view class="list-bottom-safe"></view>
  </view>

  <view
    wx:if="{{floatingNotificationVisible && !selectionMode}}"
    class="floating-notification {{floatingNotificationCount ? 'has-unread' : ''}} {{floatingNotificationDragging ? 'dragging' : ''}}"
    style="left: {{floatingNotificationLeft}}px; top: {{floatingNotificationTop}}px;"
    bindtouchstart="onFloatingNotificationTouchStart"
    catchtouchmove="onFloatingNotificationTouchMove"
    bindtouchend="onFloatingNotificationTouchEnd"
    bindtouchcancel="onFloatingNotificationTouchEnd"
    catchtap="openFloatingNotifications"
  >
    <view class="floating-notification-glow"></view>
    <t-icon name="notification-filled" size="50rpx" color="#ffffff" />
    <view wx:if="{{floatingNotificationCount}}" class="floating-notification-badge">{{floatingNotificationCount > 99 ? '99+' : floatingNotificationCount}}</view>
  </view>

  <t-picker
    t-class-confirm="picker-confirm"
    visible="{{yearPickerVisible}}"
    value="{{yearPickerValue}}"
    title="选择年份"
    confirm-btn="确定"
    cancel-btn="取消"
    bindconfirm="onYearConfirm"
    bindcancel="closeYearPicker"
    bindclose="closeYearPicker"
  >
    <t-picker-item options="{{yearOptions}}" />
  </t-picker>

  <t-picker
    t-class-confirm="picker-confirm"
    visible="{{sortPickerVisible}}"
    value="{{sortPickerValue}}"
    title="排序方式"
    confirm-btn="确定"
    cancel-btn="取消"
    bindconfirm="onSortConfirm"
    bindcancel="closeSortPicker"
    bindclose="closeSortPicker"
  >
    <t-picker-item options="{{sortOptions}}" />
  </t-picker>

  <!-- 长期项目 / 鲜花绿植账本服务记账快捷弹窗 -->
  <service-record-modal
    visible="{{serviceModalVisible}}"
    projectId="{{activeProjectId}}"
    projectName="{{activeProjectName}}"
    projectType="{{activeProjectType}}"
    bindsuccess="onServiceRecordSuccess"
    bindclose="onServiceRecordClose"
  />
</view>
