page { background: #f9f9ff; }
.step4-page { --td-brand-color: #2E9F8B; display: flex; height: 100vh; overflow: hidden; flex-direction: column; background: #f9f9ff; color: #121c2c; }
.step4-nav { position: relative; display: flex; box-sizing: border-box; flex: none; align-items: center; justify-content: center; border-bottom: 2rpx solid #f0f3ff; background: #f9f9ff; }
.nav-close { position: absolute; bottom: 0; left: 30rpx; display: flex; width: 80rpx; height: 88rpx; align-items: center; justify-content: flex-start; }
.nav-title { color: #182220; font-size: 42rpx; font-weight: 700; }
.step4-scroll { box-sizing: border-box; width: 100%; height: 0; min-height: 0; padding: 38rpx 30rpx 44rpx; flex: 1; }
.progress-section { margin-bottom: 56rpx; }
.progress-text { display: flex; align-items: center; justify-content: space-between; color: #343943; font-size: 28rpx; }
.progress-percent { color: #182220; font-size: 26rpx; font-weight: 700; }
.progress { height: 14rpx; margin-top: 24rpx; overflow: hidden; border-radius: 14rpx; background: #E8F6F4; }
.progress-current { width: 100%; height: 100%; background: linear-gradient(135deg, #36AD97, #2A9A87); }
.page-title { margin-bottom: 40rpx; color: #182220; font-size: 48rpx; font-weight: 700; }
.invoice-card { padding: 30rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(26,54,93,.045); }
.completion-card { margin-top: 24rpx; padding: 30rpx; border: 2rpx solid #e0e8f7; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(26,54,93,.045); }
.completion-card .file-grid { margin-top: 28rpx; }
.invoice-head { display: flex; align-items: center; justify-content: space-between; }
.invoice-title { color: #182220; font-size: 32rpx; font-weight: 700; }
.invoice-hint { margin-top: 4rpx; color: #5f6365; font-size: 23rpx; }
.upload-area { margin-top: 28rpx; }
.upload-disabled { opacity: .35; }
.file-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.file-item, .file-add { position: relative; box-sizing: border-box; width: calc((100% - 36rpx) / 3); height: 156rpx; overflow: hidden; border-radius: 14rpx; background: #f0f3ff; }
.file-image { width: 100%; height: 100%; }
.pdf-file, .file-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }
.pdf-file { height: 100%; color: #ba1a1a; font-size: 22rpx; }
.file-add { border: 2rpx dashed #aeb5c2; background: #fff; color: #43474e; font-size: 21rpx; }
.remove-file { position: absolute; z-index: 4; top: 8rpx; right: 8rpx; display: flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(24,34,32,.88); box-shadow: 0 2rpx 8rpx rgba(0,0,0,.2); }
.upload-note { display: flex; margin-top: 24rpx; align-items: center; gap: 8rpx; color: #5f6365; font-size: 21rpx; }
.info-grid { display: flex; gap: 20rpx; margin-top: 40rpx; }
.info-card { box-sizing: border-box; width: 50%; padding: 26rpx; border: 2rpx solid #bdf2e9; border-radius: 16rpx; background: #E8F6F4; }
.info-label { margin-top: 24rpx; color: #182220; font-size: 23rpx; font-weight: 700; }
.info-value { margin-top: 8rpx; color: #343943; font-size: 22rpx; }
.wizard-footer { position: relative; z-index: 8; display: flex; box-sizing: border-box; width: 100%; height: calc(142rpx + env(safe-area-inset-bottom)); padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); flex: none; align-items: center; justify-content: center; gap: 18rpx; border-top: 2rpx solid #f0f3ff; background: rgba(249,249,255,.98); }
.footer-text-button { width: 170rpx !important; height: 92rpx !important; margin: 0 !important; border: 2rpx solid #c8cdd6 !important; border-radius: 18rpx !important; background: #ffffff !important; color: #303846 !important; font-size: 24rpx !important; }
.disabled-button { border-color: #e1e4e9 !important; background: #f1f2f4 !important; color: #a1a6ad !important; }
.submit-button { width: 180rpx !important; height: 92rpx !important; margin: 0 !important; border-radius: 20rpx !important; background: linear-gradient(135deg, #36AD97, #2A9A87) !important; color: #fff !important; font-size: 28rpx !important; font-weight: 600 !important; box-shadow: 0 10rpx 22rpx rgba(42, 154, 135, 0.28) !important; }
.pdf-file-name { width: 100%; overflow: hidden; color: #343943; text-align: center; font-size: 19rpx; line-height: 26rpx; white-space: nowrap; }
.existing-badge { position: absolute; right: 8rpx; bottom: 8rpx; padding: 4rpx 10rpx; border-radius: 999rpx; background: rgba(25, 135, 84, .92); color: #fff; font-size: 19rpx; }
.status-badge { position: absolute; left: 8rpx; bottom: 8rpx; padding: 4rpx 10rpx; border-radius: 999rpx; color: #fff; font-size: 19rpx; }
.status-badge.uploading { background: rgba(46, 159, 139, .82); }
.status-badge.failed { background: rgba(186, 26, 26, .9); }
.file-failed { outline: 2rpx solid rgba(186, 26, 26, .55); }
.upload-progress { margin-top: 18rpx; color: #182220; font-size: 24rpx; font-weight: 600; }
