<view class="step4-page">
  <view class="step4-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;"><view class="nav-close" bindtap="close"><t-icon name="close" size="44rpx" color="#002045" /></view><view class="nav-title">{{pageTitle}}</view></view>
  <scroll-view class="step4-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="progress-section" wx:if="{{!isLongTerm}}"><view class="progress-text"><text>步骤 4 / 4</text><text class="progress-percent">已完成 100%</text></view><view class="progress"><view class="progress-current"></view></view></view>
    <view class="page-title">项目交付资料</view>
    <view class="invoice-card"><view class="invoice-head"><view><view class="invoice-title">是否有发票？</view><view class="invoice-hint">通过文档核实项目支出</view></view><t-switch value="{{invoiceEnabled}}" bindchange="onInvoiceChange" /></view><view class="upload-area {{invoiceEnabled ? '' : 'upload-disabled'}}" wx:if="{{invoiceEnabled}}"><view class="file-grid"><view class="file-item {{item.uploadStatus === 'failed' ? 'file-failed' : ''}}" wx:for="{{files}}" wx:key="id"><image wx:if="{{item.isImage}}" class="file-image" src="{{item.tempFilePath}}" mode="aspectFill" data-id="{{item.id}}" bindtap="previewFile" /><view wx:else class="pdf-file" data-id="{{item.id}}" bindtap="previewFile"><t-icon name="file-pdf" size="50rpx" color="#ba1a1a" /><text class="pdf-file-name">{{item.pdfDisplayName}}</text></view><view wx:if="{{item.uploadStatus === 'uploading'}}" class="status-badge uploading">上传中</view><view wx:elif="{{item.uploadStatus === 'failed'}}" class="status-badge failed">失败</view><view wx:elif="{{item.isExisting || item.uploadStatus === 'success'}}" class="existing-badge">成功</view><view wx:if="{{!isEditMode}}" class="remove-file" data-id="{{item.id}}" catchtap="removeFile"><t-icon name="close" size="26rpx" color="#ffffff" /></view></view><view wx:if="{{files.length < 80}}" class="file-add" bindtap="chooseFile"><t-icon name="camera" size="46rpx" color="#002045" /><text>添加文件</text></view></view><view wx:if="{{uploadProgressText}}" class="upload-progress">{{uploadProgressText}}</view><view class="upload-note"><t-icon name="info-circle" size="26rpx" color="#5f6365" /><text>可连续添加最多 80 个文件；图片将高质量压缩后上传（单个最大 10MB）</text></view></view></view>
    <view class="completion-card" wx:if="{{!isLongTerm}}">
      <view class="invoice-head"><view><view class="invoice-title">是否有项目完工图？</view><view class="invoice-hint">开启后至少上传一张，作为项目完工存档</view></view><t-switch value="{{completionImagesEnabled}}" bindchange="onCompletionImagesChange" /></view>
      <view class="file-grid" wx:if="{{completionImagesEnabled}}"><view class="file-item" wx:for="{{completionFiles}}" wx:key="id"><image class="file-image" src="{{item.tempFilePath}}" mode="aspectFill" /><view class="remove-file" data-id="{{item.id}}" catchtap="removeCompletionImage"><t-icon name="close" size="26rpx" color="#ffffff" /></view></view><view wx:if="{{completionFiles.length < 80}}" class="file-add" bindtap="chooseCompletionImages"><t-icon name="camera" size="46rpx" color="#002045" /><text>上传完工图</text></view></view>
      <view wx:if="{{completionUploadProgressText}}" class="upload-progress">{{completionUploadProgressText}}</view>
      <view class="upload-note" wx:if="{{completionImagesEnabled}}"><t-icon name="info-circle" size="26rpx" color="#5f6365" /><text>可连续添加最多 80 张；图片将高质量压缩后上传（单个最大 10MB）</text></view>
    </view>
  </scroll-view>
  <view class="wizard-footer"><t-button t-class="footer-text-button" theme="default" variant="text" icon="arrow-left" content="上一步" bindtap="previous" /><t-button t-class="footer-text-button disabled-button" theme="default" variant="text" icon="arrow-right" content="下一步" disabled /><t-button t-class="submit-button" theme="primary" icon="check-circle-filled" content="{{submitText}}" loading="{{submitting}}" bindtap="submit" /></view>
</view>
