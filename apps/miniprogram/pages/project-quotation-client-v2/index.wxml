<page-meta page-style="{{fullTableVisible ? 'overflow: hidden;' : ''}}" />
<view class="detail-page">
  <!-- 自定义顶部导航栏：左上角显示 X 图标 -->
  <view class="detail-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="closePage">
      <t-icon name="close" size="48rpx" color="#002045" />
    </view>
    <view class="nav-title">报价详情</view>
  </view>
  <view class="nav-placeholder" style="height: {{navHeight}}px;"></view>

  <view wx:if="{{quotation}}" class="detail-content">
    <!-- 项目标题（项目名称-报价清单）、更新时间与胶囊标签 -->
    <view class="project-head">
      <view class="project-copy">
        <view class="project-name">{{quotation.projectName}}-报价清单</view>
        <view class="project-time-row">
          <t-icon name="time" size="26rpx" color="#74777f" />
          <text class="project-time-text">更新时间：{{quotation.updatedDate}}</text>
        </view>
        <view class="project-badges">
          <view class="badge-chip badge-confirmed">
            <t-icon name="check-circle-filled" size="26rpx" color="#10b981" />
            <text>报价单已确认</text>
          </view>
          <view class="badge-chip badge-version {{quotation.versionColorClass}}">
            <text>{{quotation.versionBadgeText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 总计报价卡片（深蓝渐变科技质感） -->
    <view class="amount-card">
      <view class="amount-watermark">
        <t-icon name="money" size="180rpx" color="rgba(255,255,255,.08)" />
      </view>
      <view class="amount-label">总计报价 (CNY)</view>
      <view class="amount-value">
        <text class="currency">¥</text>
        <text class="amount-int">{{quotation.amountText}}</text>
      </view>
      <view class="amount-divider"></view>
      <view class="amount-meta">
        <t-icon name="time" size="26rpx" color="rgba(255,255,255,.68)" />
        <text>最后更新：{{quotation.updatedDate}}</text>
      </view>
      <view class="amount-note">注：报价单自分享之日起，有效期为 30 天</view>
    </view>

    <!-- 设计图纸专区 -->
    <view class="section-head" wx:if="{{drawings.length}}">
      <view class="section-title">设计图纸</view>
      <view class="drawing-head-right">
        <view class="section-count">{{drawings.length}} 张已上传</view>
        <view wx:if="{{drawings.length > 2}}" class="drawing-toggle" bindtap="toggleDrawings">
          <text>{{drawingsExpanded ? '收起' : '查看全部'}}</text>
          <view class="drawing-toggle-arrow {{drawingsExpanded ? 'expanded' : ''}}">
            <t-icon name="chevron-down" size="24rpx" color="#455f88" />
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{drawings.length}}" class="drawing-grid">
      <view
        wx:for="{{visibleDrawings}}"
        wx:key="displayUrl"
        class="drawing-card"
        data-index="{{index}}"
        bindtap="previewDrawing"
      >
        <image class="drawing-image" src="{{item.displayUrl}}" mode="aspectFill" />
      </view>
    </view>

    <!-- 报价清单专区 -->
    <view class="section-head quotation-heading">
      <view class="section-title">报价清单</view>
    </view>

    <!-- 横屏操作条（全屏按钮紧凑胶囊） -->
    <view class="actions-tip-bar">
      <view class="tip-copy">
        <view class="rotate-icon">
          <t-icon name="mobile-vibrate" size="32rpx" color="#455f88" />
        </view>
        <text>点击全屏横屏观看体验更佳</text>
      </view>
      <view class="fullscreen-pill-btn" bindtap="openFullTable">
        <t-icon name="fullscreen" size="26rpx" color="#002045" />
        <text>全屏</text>
      </view>
    </view>

    <!-- 报价明细数据表格 -->
    <view id="quotation-table-anchor" class="quotation-table-frame">
      <scroll-view class="quotation-table-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="quotation-table">
          <view class="table-row table-header">
            <view class="cell name-cell">项目名称</view>
            <view class="cell price-cell">单价 (¥)</view>
            <view class="cell quantity-cell">数量</view>
            <view class="cell subtotal-cell">小计 (¥)</view>
            <view class="cell remark-cell">备注</view>
          </view>
          <view wx:for="{{quotation.items}}" wx:key="itemCode" class="table-row">
            <view class="cell name-cell"><view class="item-name">{{item.name}}</view></view>
            <view class="cell price-cell">{{item.unitPriceText}}</view>
            <view class="cell quantity-cell">{{item.quantityUnitText}}</view>
            <view class="cell subtotal-cell">{{item.totalText}}</view>
            <view class="cell remark-cell"><view class="item-remark">{{item.remark || '无备注'}}</view></view>
          </view>
          <view class="table-total">
            <text class="total-label">各项费用总和 (CNY)</text>
            <text class="total-number">¥ {{quotation.amountText}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 报价须知卡片 -->
    <view class="notice-card">
      <view class="card-head-title">
        <t-icon name="info-circle" size="32rpx" color="#002045" />
        <text>报价须知</text>
      </view>
      <view class="notice-list">
        <view wx:for="{{notices}}" wx:key="*this" class="notice-item">
          <text class="notice-bullet">•</text>
          <text class="notice-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 公司信息卡片（显示公司Logo图片） -->
    <view class="company-card">
      <view class="card-head-title">
        <t-icon name="city" size="32rpx" color="#002045" />
        <text>服务单位信息</text>
      </view>
      <view class="company-body">
        <image class="company-logo-img" src="/images/company-logo.png" mode="aspectFit" />
        <view class="company-details">
          <view class="company-row">
            <text class="company-label">公司名称：</text>
            <text class="company-value">杭州亿辉文化创意有限公司</text>
          </view>
          <view class="company-row margin-top-xs">
            <text class="company-label">办公地址：</text>
            <text class="company-value">浙江省杭州市萧山区长三角国际珠宝产业园</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部固定吸底操作条（单按钮全屏横屏查看） -->
  <view wx:if="{{quotation}}" class="bottom-bar">
    <view class="footer-btn btn-fullscreen single-btn" bindtap="openFullTable">
      <t-icon name="fullscreen" size="36rpx" color="#ffffff" />
      <text>全屏横屏查看</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading && !quotation}}" class="detail-loading">
    <t-loading size="48rpx" theme="circular" />
    <text>正在加载报价详情...</text>
  </view>

  <!-- 横屏全屏大表查看弹层 -->
  <view wx:if="{{fullTableVisible}}" class="landscape-overlay">
    <view class="landscape-panel" style="padding-right: {{landscapeBottomInset}}px; padding-left: {{landscapeTopInset}}px;">
      <view class="landscape-head">
        <view class="landscape-head-copy">
          <view class="landscape-head-icon">
            <t-icon name="view-list" size="34rpx" color="#455f88" />
          </view>
          <view>
            <view class="landscape-title">{{quotation.projectName}}-报价清单</view>
            <view class="landscape-subtitle">上下、左右滑动查看完整报价明细</view>
          </view>
        </view>
        <view class="landscape-actions">
          <view class="landscape-close-action" bindtap="closeFullTable">
            <text>关闭</text>
            <t-icon name="close" size="32rpx" color="#002045" />
          </view>
        </view>
      </view>
      <scroll-view class="landscape-table-scroll" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
        <view class="landscape-table">
          <view class="landscape-row landscape-header">
            <view class="landscape-cell landscape-name">项目名称</view>
            <view class="landscape-cell landscape-price">单价 (¥)</view>
            <view class="landscape-cell landscape-quantity">数量</view>
            <view class="landscape-cell landscape-subtotal">小计 (¥)</view>
            <view class="landscape-cell landscape-remark">备注</view>
          </view>
          <view wx:for="{{quotation.items}}" wx:key="itemCode" class="landscape-row">
            <view class="landscape-cell landscape-name"><view class="item-name">{{item.name}}</view></view>
            <view class="landscape-cell landscape-price">{{item.unitPriceText}}</view>
            <view class="landscape-cell landscape-quantity">{{item.quantityUnitText}}</view>
            <view class="landscape-cell landscape-subtotal">{{item.totalText}}</view>
            <view class="landscape-cell landscape-remark"><view class="item-remark">{{item.remark || '无备注'}}</view></view>
          </view>
          <view class="landscape-total">
            <text>各项费用总和 (CNY)</text>
            <text>¥ {{quotation.amountText}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
