page {
  background: #f9f9ff;
}

.detail-page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: #f9f9ff;
  color: #121c2c;
  box-sizing: border-box;
}

/* 顶部自定义导航栏 */
.detail-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 30;
  box-sizing: border-box;
  border-bottom: 2rpx solid rgba(231, 238, 255, .85);
  background: rgba(249, 249, 255, .98);
  backdrop-filter: blur(8rpx);
}

.nav-placeholder {
  width: 100%;
}

.nav-back {
  position: absolute;
  bottom: 0;
  left: 20rpx;
  display: flex;
  width: 76rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
}

.nav-title {
  position: absolute;
  right: 180rpx;
  bottom: 0;
  left: 180rpx;
  height: 88rpx;
  color: #00091b;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}

.detail-content {
  padding: 30rpx 24rpx 40rpx;
}

/* 项目标题区与下方胶囊 */
.project-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.project-copy {
  min-width: 0;
  flex: 1;
}

.project-name {
  color: #00091b;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 0.5rpx;
}

.project-time-row {
  display: flex;
  margin-top: 14rpx;
  align-items: center;
  gap: 8rpx;
  color: #74777f;
  font-size: 24rpx;
}

.project-time-text {
  color: #74777f;
  font-size: 24rpx;
}

.project-badges {
  display: flex;
  margin-top: 16rpx;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
}

.badge-chip {
  display: inline-flex;
  height: 52rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-confirmed {
  border: 2rpx solid #a7f3d0;
  background: #ecfdf5;
  color: #059669;
}

.badge-version {
  border: 2rpx solid #ffe3d1;
  background: #fff5ed;
  color: #ea580c;
}

.badge-version.version-v1 { border-color: #cbe0ff; background: #edf4ff; color: #2563eb; }
.badge-version.version-v2 { border-color: #e1d5ff; background: #f5f0ff; color: #7c3aed; }
.badge-version.version-v3 { border-color: #bdf2e9; background: #e6f9f6; color: #0d9488; }
.badge-version.version-v4 { border-color: #ffe3d1; background: #fff5ed; color: #ea580c; }
.badge-version.version-v5 { border-color: #fef08a; background: #fefce8; color: #ca8a04; }

/* 总计报价卡片（深蓝科技感渐变） */
.amount-card {
  position: relative;
  overflow: hidden;
  margin-top: 30rpx;
  padding: 38rpx;
  border: 2rpx solid rgba(255, 255, 255, .12);
  border-radius: 22rpx;
  background: linear-gradient(135deg, #455f88 0%, #002045 58%, #00152f 100%);
  color: #fff;
  box-shadow: 0 12rpx 30rpx rgba(0, 32, 69, .18);
}

.amount-watermark {
  position: absolute;
  top: -24rpx;
  right: -22rpx;
}

.amount-label {
  position: relative;
  color: rgba(255, 255, 255, .68);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.amount-value {
  position: relative;
  display: flex;
  margin-top: 26rpx;
  align-items: baseline;
  gap: 16rpx;
  font-family: monospace, -apple-system, sans-serif;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.currency {
  color: rgba(255, 255, 255, .78);
  font-size: 34rpx;
  font-weight: 600;
}

.amount-divider {
  position: relative;
  height: 2rpx;
  margin: 34rpx 0 22rpx;
  background: rgba(255, 255, 255, .22);
}

.amount-meta {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: rgba(255, 255, 255, .72);
  font-size: 21rpx;
}

.amount-note {
  position: relative;
  margin-top: 13rpx;
  color: rgba(255, 255, 255, .58);
  font-size: 20rpx;
  font-style: italic;
}

/* 专区标题与折叠 */
.section-head {
  display: flex;
  margin-top: 38rpx;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: #00091b;
  font-size: 31rpx;
  font-weight: 700;
}

.section-count {
  color: #74777f;
  font-size: 22rpx;
}

.drawing-head-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.drawing-toggle {
  display: flex;
  min-height: 52rpx;
  padding: 0 16rpx;
  align-items: center;
  gap: 4rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #455f88;
  font-size: 22rpx;
  font-weight: 600;
  transition: all .2s ease;
}

.drawing-toggle:active {
  opacity: .72;
  transform: scale(.97);
}

.drawing-toggle-arrow {
  display: flex;
  width: 24rpx;
  height: 24rpx;
  align-items: center;
  justify-content: center;
  transform: rotate(-90deg);
  transition: transform .28s cubic-bezier(.4, 0, .2, 1);
}

.drawing-toggle-arrow.expanded {
  transform: rotate(0deg);
}

/* 设计图纸网格 */
.drawing-grid {
  display: grid;
  margin-top: 20rpx;
  padding: 16rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  border: 2rpx solid rgba(217, 227, 249, .72);
  border-radius: 24rpx;
  background: #f3f6fd;
}

.drawing-card {
  height: 310rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 2rpx solid #cbd9ee;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(48, 89, 145, .14);
}

.drawing-image {
  width: 100%;
  height: 100%;
}

/* 报价清单与操作条 */
.quotation-heading {
  margin-bottom: 18rpx;
}

.actions-tip-bar {
  display: flex;
  min-height: 76rpx;
  padding: 10rpx 16rpx 10rpx 20rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border: 2rpx solid rgba(217, 227, 249, .52);
  border-radius: 14rpx;
  background: #f0f3ff;
}

.tip-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 10rpx;
  color: #5b5f61;
  font-size: 22rpx;
  white-space: nowrap;
}

.rotate-icon {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  transform: rotate(-18deg);
}

.fullscreen-pill-btn {
  display: inline-flex;
  height: 52rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 12rpx;
  background: #dee8ff;
  color: #002045;
  font-size: 21rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.fullscreen-pill-btn:active {
  opacity: 0.75;
  transform: scale(0.96);
}

/* 报价清单数据表格 */
.quotation-table-frame {
  margin-top: 18rpx;
  overflow: hidden;
  border: 2rpx solid #c4c6cf;
  border-radius: 18rpx;
  background: #fff;
  clip-path: inset(0 round 18rpx);
}

.quotation-table-scroll {
  width: 100%;
  background: #fff;
}

.quotation-table {
  width: 920rpx;
}

.table-row {
  display: grid;
  min-height: 82rpx;
  grid-template-columns: 220rpx 150rpx 130rpx 180rpx 240rpx;
  border-bottom: 2rpx solid rgba(196, 198, 207, .55);
}

.table-header {
  min-height: 74rpx;
  background: #e7eeff;
  color: #44474e;
  font-size: 20rpx;
  font-weight: 700;
}

.cell {
  display: flex;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
  align-items: center;
  border-right: 2rpx solid rgba(196, 198, 207, .5);
  font-family: monospace, -apple-system, sans-serif;
  font-size: 21rpx;
}

.name-cell {
  display: flex;
  align-items: center;
  font-family: inherit;
}

.remark-cell {
  border-right: 0;
  color: #74777f;
  font-family: inherit;
}

.subtotal-cell {
  justify-content: flex-end;
  color: #455f88;
  font-weight: 700;
}

.table-header .cell {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.item-name {
  color: #121c2c;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.item-remark {
  overflow: hidden;
  color: #74777f;
  font-size: 19rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
}

.table-total {
  display: flex;
  height: 82rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: flex-start;
  gap: 24rpx;
  color: #74777f;
  font-size: 21rpx;
  text-align: left;
  background: #fafbff;
}

.total-number {
  color: #00091b;
  font-family: monospace, -apple-system, sans-serif;
  font-size: 30rpx;
  font-weight: 700;
}

/* 报价须知卡片 */
.notice-card, .company-card {
  margin-top: 32rpx;
  padding: 30rpx 28rpx;
  border: 2rpx solid rgba(217, 227, 249, .65);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(26, 54, 93, .06);
}

.card-head-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #002045;
  font-size: 28rpx;
  font-weight: 700;
}

.notice-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #5b5f61;
  font-size: 23rpx;
  line-height: 1.5;
}

.notice-bullet {
  color: #002045;
  font-weight: 700;
}

/* 公司信息卡片 */
.company-body {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.company-logo-img {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx solid #d9e3f9;
  box-shadow: 0 4rpx 14rpx rgba(26, 54, 93, 0.08);
}

.company-details {
  min-width: 0;
  flex: 1;
}

.company-row {
  display: flex;
  align-items: flex-start;
  font-size: 23rpx;
  line-height: 1.45;
}

.company-label {
  color: #74777f;
  flex: none;
}

.company-value {
  color: #121c2c;
  font-weight: 600;
}

.margin-top-xs {
  margin-top: 8rpx;
}

/* 底部固定吸底操作条（单一大按钮） */
.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(217, 227, 249, .8);
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 -8rpx 26rpx rgba(26, 54, 93, .08);
  backdrop-filter: blur(8rpx);
}

.footer-btn {
  display: flex;
  height: 90rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  transition: all .2s;
}

.footer-btn:active {
  opacity: .85;
  transform: scale(.98);
}

.footer-btn.single-btn {
  width: 100%;
}

.btn-fullscreen {
  border: none;
  background: linear-gradient(135deg, #36AD97, #2A9A87);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(42, 154, 135, .28);
}

/* 横屏全屏大表查看弹层 */
.landscape-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  overflow: hidden;
  background: #f9f9ff;
}

.landscape-panel {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  width: 100vh;
  height: 100vw;
  padding-top: 12rpx;
  padding-bottom: 16rpx;
  box-sizing: border-box;
  flex-direction: column;
  transform: rotate(90deg) translateY(-100%);
  transform-origin: top left;
  background: #f9f9ff;
}

.landscape-head {
  display: flex;
  min-height: 76rpx;
  padding: 8rpx 14rpx 8rpx 18rpx;
  box-sizing: border-box;
  flex: none;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid rgba(174, 199, 245, .45);
  border-radius: 14rpx;
  background: #e7eeff;
}

.landscape-head-copy {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.landscape-head-icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, .64);
}

.landscape-title {
  color: #002045;
  font-size: 30rpx;
  font-weight: 700;
}

.landscape-subtitle {
  margin-top: 4rpx;
  color: #8993a4;
  font-size: 18rpx;
}

.landscape-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.landscape-close-action {
  display: flex;
  min-width: 108rpx;
  height: 52rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border: 2rpx solid rgba(69, 95, 136, .28);
  border-radius: 999rpx;
  background: #fff;
  color: #002045;
  font-size: 21rpx;
  font-weight: 600;
}

.landscape-table-scroll {
  height: 0;
  min-height: 0;
  margin-top: 8rpx;
  overflow: hidden;
  flex: 1;
  border: 2rpx solid #c4c6cf;
  border-radius: 16rpx;
  background: #fff;
}

.landscape-table {
  display: flex;
  width: 100%;
  min-width: 960rpx;
  box-sizing: border-box;
  flex-direction: column;
}

.landscape-row {
  display: grid;
  min-height: 76rpx;
  flex: 1 0 76rpx;
  grid-template-columns: minmax(210rpx, 1.15fr) minmax(140rpx, .75fr) minmax(130rpx, .7fr) minmax(170rpx, .95fr) minmax(230rpx, 1.35fr);
  border-bottom: 2rpx solid rgba(196, 198, 207, .55);
}

.landscape-header {
  position: sticky;
  top: 0;
  z-index: 10;
  min-height: 66rpx;
  flex: none;
  background: #e7eeff;
  color: #44474e;
  font-size: 19rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 10rpx rgba(26, 54, 93, .12);
}

.landscape-cell {
  display: flex;
  min-width: 0;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
  align-items: center;
  border-right: 2rpx solid rgba(196, 198, 207, .5);
  font-family: monospace, -apple-system, sans-serif;
  font-size: 20rpx;
}

.landscape-name {
  display: flex;
  align-items: center;
  font-family: inherit;
}

.landscape-remark {
  border-right: 0;
  color: #74777f;
  font-family: inherit;
}

.landscape-subtotal {
  justify-content: flex-start;
  text-align: left;
  color: #455f88;
  font-weight: 700;
}

.landscape-header .landscape-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.landscape-total {
  display: flex;
  min-height: 72rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: flex-start;
  gap: 24rpx;
  color: #74777f;
  font-size: 20rpx;
  text-align: left;
  background: #fafbff;
}

.landscape-total text:last-child {
  color: #00091b;
  font-family: monospace, -apple-system, sans-serif;
  font-size: 27rpx;
  font-weight: 700;
}

.detail-loading {
  display: flex;
  height: 55vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #74777f;
  font-size: 24rpx;
}
