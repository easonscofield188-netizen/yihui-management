page {
  background: #f5f7fb;
}

.detail-page {
  min-height: 100vh;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f8f9fd 0%, #f3f6fb 100%);
  color: #172033;
}

.page-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  border-bottom: 2rpx solid rgba(222, 227, 237, .82);
  background: rgba(255, 255, 255, .94);
  backdrop-filter: blur(18rpx);
}

.nav-placeholder { width: 100%; }
.nav-back { position: absolute; bottom: 0; left: 24rpx; display: flex; width: 70rpx; height: 88rpx; align-items: center; }
.nav-title { position: absolute; right: 150rpx; bottom: 0; left: 150rpx; height: 88rpx; color: #002045; font-size: 36rpx; font-weight: 700; line-height: 88rpx; text-align: center; }
.detail-content { padding: 28rpx 30rpx; }

.event-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 32rpx;
  border: 2rpx solid rgba(255, 255, 255, .7);
  border-radius: 28rpx;
  background: linear-gradient(135deg, #e9f1ff 0%, #f8faff 58%, #e8edff 100%);
  box-shadow: 0 16rpx 38rpx rgba(45, 72, 128, .12);
}

.theme-created .event-card { background: linear-gradient(135deg, #e7f7ee 0%, #fbfffd 58%, #ddf3e8 100%); }
.event-glow { position: absolute; border-radius: 50%; pointer-events: none; }
.glow-one { top: -90rpx; right: -70rpx; width: 250rpx; height: 250rpx; background: rgba(75, 112, 193, .12); }
.glow-two { bottom: -105rpx; left: -75rpx; width: 210rpx; height: 210rpx; background: rgba(128, 91, 184, .08); }
.theme-created .glow-one { background: rgba(15, 122, 69, .12); }
.theme-created .glow-two { background: rgba(220, 162, 58, .09); }
.event-head { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; }
.event-icon { display: flex; width: 82rpx; height: 82rpx; align-items: center; justify-content: center; border-radius: 22rpx; background: linear-gradient(145deg, #3d71c5, #234d96); box-shadow: 0 10rpx 22rpx rgba(36, 87, 167, .25); }
.theme-created .event-icon { background: linear-gradient(145deg, #28a468, #0f7444); box-shadow: 0 10rpx 22rpx rgba(15, 122, 69, .22); }
.event-badge { position: relative; z-index: 1; padding: 8rpx 18rpx; border: 2rpx solid rgba(36, 87, 167, .18); border-radius: 999rpx; background: rgba(255, 255, 255, .76); color: #2457a7; font-size: 21rpx; font-weight: 650; }
.theme-created .event-badge { border-color: rgba(15, 122, 69, .2); color: #0f7a45; }
.event-title { position: relative; z-index: 1; margin-top: 28rpx; overflow: hidden; color: #10264a; font-size: 36rpx; font-weight: 750; line-height: 48rpx; text-overflow: ellipsis; white-space: nowrap; }
.theme-created .event-title { color: #123d2a; }
.event-summary { position: relative; z-index: 1; margin-top: 12rpx; color: #46546a; font-size: 25rpx; line-height: 39rpx; }
.event-time { position: relative; z-index: 1; display: inline-flex; margin-top: 22rpx; padding: 9rpx 15rpx; align-items: center; gap: 8rpx; border-radius: 12rpx; background: rgba(255, 255, 255, .7); color: #697383; font-size: 21rpx; }

.info-card,
.change-card {
  border: 2rpx solid #e2e7f0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 9rpx 28rpx rgba(49, 66, 98, .06);
}

.info-card { margin-top: 26rpx; padding: 28rpx 26rpx; }
.section-heading { display: flex; align-items: center; gap: 12rpx; }
.heading-mark { width: 8rpx; height: 30rpx; border-radius: 999rpx; background: linear-gradient(180deg, #4678ce, #2457a7); }
.theme-created .heading-mark { background: linear-gradient(180deg, #2ca96d, #0f7a45); }
.section-title { color: #172033; font-size: 30rpx; font-weight: 720; }
.info-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 22rpx; gap: 16rpx; }
.info-item { display: flex; min-width: 0; padding: 20rpx 18rpx; align-items: center; gap: 14rpx; border: 2rpx solid #edf0f5; border-radius: 18rpx; background: #fafbfe; }
.info-icon { display: flex; width: 56rpx; height: 56rpx; flex: none; align-items: center; justify-content: center; border-radius: 15rpx; }
.user-icon { background: #eee9fb; }
.role-icon { background: #fff2dc; }
.source-icon { background: #e3f5f7; }
.project-icon { background: #e8effc; }
.info-main { min-width: 0; flex: 1; }
.info-label { color: #8992a1; font-size: 19rpx; }
.info-value { margin-top: 5rpx; overflow: hidden; color: #263143; font-size: 23rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.delivery-row { display: flex; margin-top: 20rpx; padding: 18rpx 4rpx 0; align-items: center; justify-content: space-between; border-top: 2rpx solid #edf0f5; }
.delivery-label { display: flex; align-items: center; gap: 10rpx; color: #46505f; font-size: 23rpx; }
.delivery-status { padding: 6rpx 14rpx; border-radius: 999rpx; background: #f0f2f5; color: #697383; font-size: 20rpx; font-weight: 600; }
.delivery-sent { background: #e6f7ed; color: #0f7a45; }
.delivery-failed { background: #ffe9e7; color: #b3261e; }
.delivery-pending { background: #fff2dc; color: #8a530d; }
.delivery-reason { margin-top: 10rpx; color: #8a530d; font-size: 20rpx; line-height: 30rpx; text-align: right; }

.change-section { margin-top: 34rpx; }
.section-head { display: flex; margin-bottom: 18rpx; padding: 0 4rpx; align-items: center; justify-content: space-between; }
.change-count { padding: 7rpx 16rpx; border-radius: 999rpx; background: #e7eeff; color: #2457a7; font-size: 21rpx; font-weight: 650; }
.theme-created .change-count { background: #e7f7ee; color: #0f7a45; }
.change-card { position: relative; margin-bottom: 18rpx; overflow: hidden; padding: 25rpx 24rpx 24rpx 28rpx; }
.change-card::before { position: absolute; top: 0; bottom: 0; left: 0; width: 7rpx; background: linear-gradient(180deg, #5483d3, #7a63be); content: ""; }
.theme-created .change-card::before { background: linear-gradient(180deg, #2ca96d, #5bbf90); }
.change-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.change-label { min-width: 0; flex: 1; color: #202b3d; font-size: 27rpx; font-weight: 680; line-height: 38rpx; }
.change-type { flex: none; padding: 6rpx 13rpx; border-radius: 999rpx; background: #e8effc; color: #2457a7; font-size: 20rpx; font-weight: 600; }
.type-added,
.type-created { background: #e6f7ed; color: #0f7a45; }
.type-removed { background: #ffe9e7; color: #b3261e; }
.change-values { display: grid; grid-template-columns: minmax(0, 1fr) 40rpx minmax(0, 1fr); margin-top: 22rpx; align-items: stretch; gap: 10rpx; }
.value-block { min-width: 0; padding: 18rpx; border: 2rpx solid transparent; border-radius: 16rpx; }
.old-value { border-color: #e4e7ec; background: #f5f6f8; }
.new-value { border-color: #bfe5cf; background: #eef9f2; }
.value-caption { display: flex; align-items: center; gap: 8rpx; color: #7e8795; font-size: 20rpx; }
.caption-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #a2a8b1; }
.new-value .value-caption { color: #39795a; }
.new-value .caption-dot { background: #22a565; }
.value-text { margin-top: 10rpx; color: #46505f; font-size: 24rpx; line-height: 35rpx; word-break: break-all; }
.new-value .value-text { color: #164d32; font-weight: 650; }
.change-arrow { display: flex; width: 38rpx; height: 38rpx; margin: auto; align-items: center; justify-content: center; border-radius: 50%; background: #edf0f5; }
.empty-change { padding: 56rpx 0; color: #8b919a; font-size: 24rpx; text-align: center; }
.project-button { display: flex; height: 94rpx; margin-top: 32rpx; align-items: center; justify-content: center; gap: 12rpx; border-radius: 20rpx; background: linear-gradient(135deg, #173d72, #002045); color: #ffffff; font-size: 28rpx; font-weight: 700; box-shadow: 0 13rpx 28rpx rgba(0, 32, 69, .22); }
.theme-created .project-button { background: linear-gradient(135deg, #167b4a, #075b36); box-shadow: 0 13rpx 28rpx rgba(15, 122, 69, .2); }
.loading-mask { position: fixed; z-index: 50; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(245, 247, 251, .82); }
.loading-content { display: flex; padding: 24rpx 32rpx; align-items: center; gap: 14rpx; border: 2rpx solid #e2e7f0; border-radius: 18rpx; background: #ffffff; color: #002045; font-size: 24rpx; box-shadow: 0 10rpx 28rpx rgba(49, 66, 98, .1); }
