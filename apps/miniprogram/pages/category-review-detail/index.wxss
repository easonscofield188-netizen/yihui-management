page,.page{min-height:100%;background:#f7f9fd;color:#172238}.page{padding-bottom:150rpx}.nav{position:fixed;z-index:20;top:0;right:0;left:0;box-sizing:border-box;background:#f9f9ff;border-bottom:2rpx solid #e8edf5}.back{position:absolute;bottom:0;left:25rpx;display:flex;width:75rpx;height:88rpx;align-items:center}.title{height:88rpx;line-height:88rpx;text-align:center;font-size:35rpx;font-weight:700;color:#002045}.content{padding:26rpx}.hero{position:relative;padding:29rpx;border-radius:23rpx;background:linear-gradient(135deg,#123d68,#246497);color:#fff;box-shadow:0 17rpx 36rpx rgba(18,61,104,.22)}.hero-label{color:rgba(255,255,255,.72);font-size:20rpx}.hero-name{margin-top:8rpx;font-size:34rpx;font-weight:750}.badge{position:absolute;top:28rpx;right:25rpx;padding:7rpx 14rpx;border-radius:999rpx;background:rgba(255,255,255,.16);font-size:20rpx}.hero-meta{margin-top:18rpx;color:rgba(255,255,255,.75);font-size:20rpx}.card{margin-top:24rpx;padding:27rpx;border:2rpx solid #dfe7f2;border-radius:22rpx;background:#fff;box-shadow:0 13rpx 30rpx rgba(37,74,122,.1)}.heading{margin-bottom:22rpx;color:#123d68;font-size:28rpx;font-weight:700}.field{margin-top:19rpx}.field>text{display:block;margin-bottom:9rpx;color:#596577;font-size:22rpx}.field input,.field textarea{width:100%;box-sizing:border-box;border:2rpx solid #d9e3f2;border-radius:13rpx;background:#f7f9fd;font-size:25rpx}.field input{height:78rpx;padding:0 19rpx}.field textarea{height:126rpx;padding:16rpx 19rpx}.tip{margin-top:20rpx;padding:15rpx;border-radius:12rpx;background:#eef3fa;color:#667387;font-size:20rpx;line-height:30rpx}.source{padding:16rpx 0;border-bottom:2rpx solid #edf1f6;font-size:24rpx}.source text{display:block;margin-top:7rpx;color:#8992a0;font-size:20rpx}.actions{position:fixed;z-index:15;right:0;bottom:0;left:0;display:flex;padding:20rpx 25rpx calc(22rpx + env(safe-area-inset-bottom));gap:14rpx;background:#fff;box-shadow:0 -10rpx 28rpx rgba(31,63,105,.1)}.btn{display:flex;height:78rpx;flex:1;align-items:center;justify-content:center;border-radius:999rpx;font-size:23rpx;font-weight:700}.reject{background:#fff0ef;color:#ac2929}.merge{background:#e7eefb;color:#285692}.approve{background:#002045;color:#fff}.merge-panel{padding:30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));background:#f8faff}.merge-head{display:flex;align-items:flex-start;justify-content:space-between;font-size:29rpx;font-weight:700}.merge-head text{display:block;margin-top:7rpx;color:#87909e;font-size:20rpx;font-weight:400}.merge-list{max-height:610rpx;margin-top:20rpx}.merge-item{display:flex;margin-bottom:14rpx;padding:20rpx;align-items:center;justify-content:space-between;gap:18rpx;border:2rpx solid #dde6f3;border-radius:17rpx;background:#fff;font-size:25rpx}.merge-item.disabled{border-color:#eadede;background:#fbf8f8}.merge-main{min-width:0;flex:1}.merge-item text{display:block;margin-top:6rpx;color:#8b94a2;font-size:19rpx}.merge-warning{margin-top:9rpx;color:#a24444;font-size:19rpx;line-height:28rpx}.merge-state{flex:none;padding:7rpx 12rpx;border-radius:999rpx;font-size:19rpx}.merge-state.allowed{background:#e5f6ed;color:#14704b}.merge-state.blocked{background:#f7e8e7;color:#a13b3b}.mask{position:fixed;z-index:20000;inset:0;display:flex;align-items:center;justify-content:center;gap:14rpx;background:rgba(247,249,253,.86);color:#123d68;font-size:24rpx}
