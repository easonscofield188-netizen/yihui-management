<view class="page"><view class="nav" style="height:{{navHeight}}px;padding-top:{{statusBarHeight}}px"><view class="back" bindtap="back"><t-icon name="{{isServiceEntry?'close':'chevron-left'}}" size="48rpx" color="#002045"/></view><view class="title">类目审核详情</view></view><view style="height:{{navHeight}}px"></view>
<view class="content" wx:if="{{review}}"><view class="hero"><view><view class="hero-label">待沉淀成本类目</view><view class="hero-name">{{review.proposedLabel}}</view></view><view class="badge">{{review.statusLabel}}</view><view class="hero-meta">{{review.projectName}} · {{review.submittedByName}} · 累计 {{review.occurrenceCount||1}} 次</view></view>
<view class="card"><view class="heading">审核后配置</view><view class="field"><text>配置名称</text><input value="{{form.label}}" disabled="{{review.status!=='PENDING'}}" maxlength="80" data-field="label" bindinput="input"/></view><view class="field"><text>常用单位</text><input value="{{form.commonUnit}}" disabled="{{review.status!=='PENDING'}}" maxlength="30" data-field="commonUnit" bindinput="input"/></view><view class="field"><text>配置说明</text><textarea value="{{form.description}}" disabled="{{review.status!=='PENDING'}}" maxlength="240" data-field="description" bindinput="input"/></view><view class="field"><text>审核备注（选填）</text><input value="{{form.reason}}" disabled="{{review.status!=='PENDING'}}" maxlength="200" data-field="reason" bindinput="input"/></view><view class="tip" wx:if="{{review.status==='PENDING'&&hasConfigChanges}}">名称或单位已经修改；审核通过后只会影响新增配置，不会修改原报价单内容。</view></view>
<view class="card"><view class="heading">来源记录</view><view class="source" wx:for="{{review.sources}}" wx:key="quotationId"><view>{{item.originalName}} · {{item.originalUnit}}</view><text>{{item.quotationVersion}} · {{item.submittedByName}}</text></view></view>
<view class="actions" wx:if="{{review.status==='PENDING'}}"><view class="btn reject" bindtap="reject">驳回</view><view class="btn merge" bindtap="openMerge">合并已有</view><view class="btn approve" bindtap="approve">通过新增</view></view></view>
<t-popup visible="{{mergeVisible}}" placement="bottom" bindvisible-change="closeMerge"><view class="merge-panel"><view class="merge-head"><view><view>选择已有成本配置</view><text>仅名称近似且单位一致的配置允许合并</text></view><t-icon name="close" size="38rpx" bindtap="closeMerge"/></view><scroll-view class="merge-list" scroll-y><view class="merge-item {{item.mergeAllowed?'':'disabled'}}" wx:for="{{configs}}" wx:key="_id" data-id="{{item._id||item.id}}" bindtap="merge"><view class="merge-main"><view>{{item.label}}</view><text>{{item.commonUnit||'未设置单位'}} · {{item.isActive===false?'已停用':'启用中'}}</text><view class="merge-warning" wx:if="{{!item.mergeAllowed}}">{{item.mergeHint}}</view></view><view class="merge-state {{item.mergeAllowed?'allowed':'blocked'}}">{{item.mergeAllowed?'可合并':'不可合并'}}</view></view></scroll-view></view></t-popup>
<view class="mask" wx:if="{{loading||operating}}" catchtap="stop" catchtouchmove="stop"><t-loading size="48rpx"/><text>{{operating?'正在处理审核...':'正在加载...'}}</text></view></view>
